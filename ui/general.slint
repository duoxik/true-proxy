import { ActionButton, Badge, DialogHeader, FormCard, IconTile, NumericText, RuleSwitch, SurfaceCard, Theme, UiIcon } from "common.slint";
import { ScrollView, Slider } from "std-widgets.slint";

// Each swatch previews its own theme even when the surrounding window changes theme.
component ThemeChoice inherits Rectangle {
    in property <bool> dark;
    in property <bool> selected;
    callback choose;
    private property <color> preview-bg: dark ? #09090b : #f4f5f7;
    private property <color> preview-sidebar: dark ? #0e0e11 : #ffffff;
    private property <color> preview-card: dark ? #141418 : #ffffff;
    private property <color> preview-border: dark ? #ffffff19 : #00000015;
    private property <color> preview-dim: dark ? #3f3f46 : #d4d4d8;
    private property <color> preview-ink: dark ? #e4e4e7 : #27272a;

    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    height: 132px;
    border-radius: 11px;
    border-width: root.selected || focus.has-focus ? 2px : 1px;
    border-color: focus.has-focus ? Theme.text : root.selected ? Theme.accent : touch.has-hover ? Theme.strong-border : Theme.border;
    background: touch.has-hover ? Theme.surface-hover : Theme.subtle;
    accessible-role: button;
    accessible-label: root.dark ? "Dark theme" : "Light theme";
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-action-default => { root.choose(); }
    forward-focus: focus;

    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        sample := Rectangle {
            height: 84px;
            clip: true;
            border-radius: 7px;
            border-width: 1px;
            border-color: root.preview-border;
            background: root.preview-bg;
            side := Rectangle {
                x: 1px; y: 1px; width: sample.width * 0.28; height: sample.height - 2px;
                background: root.preview-sidebar;
                Rectangle { x: parent.width - 1px; width: 1px; background: root.preview-border; }
                Rectangle { x: 6px; y: 6px; width: parent.width - 12px; height: 5px; border-radius: 3px; background: root.preview-dim; }
                Rectangle { x: 6px; y: 17px; width: (parent.width - 12px) * 0.8; height: 5px; border-radius: 3px; background: root.preview-dim; }
                Rectangle {
                    x: 6px; y: parent.height - 16px; width: parent.width - 12px; height: 10px; border-radius: 3px;
                    background: Theme.accent.with-alpha(0.22); border-width: 1px; border-color: Theme.accent.with-alpha(0.4);
                }
            }
            detail := Rectangle {
                x: side.x + side.width + 7px; y: 8px; width: sample.width - self.x - 8px; height: sample.height - 16px;
                Rectangle { x: 0px; y: 0px; width: min(40px, parent.width * 0.5); height: 5px; border-radius: 3px; background: root.preview-ink; }
                Rectangle { x: parent.width - 10px; y: 0px; width: 10px; height: 5px; border-radius: 3px; background: Theme.accent; }
                Rectangle {
                    x: 0px; y: 11px; width: detail.width; height: detail.height - 11px;
                    background: root.preview-card; border-radius: 4px; border-width: 1px; border-color: root.preview-border;
                    Rectangle { x: 5px; y: 5px; width: (parent.width - 10px) * 0.66; height: 4px; border-radius: 2px; background: root.preview-dim; }
                    Rectangle { x: parent.width - 35px; y: parent.height - 12px; width: 15px; height: 7px; border-radius: 2px; background: root.preview-ink; }
                    Rectangle { x: parent.width - 17px; y: parent.height - 12px; width: 12px; height: 7px; border-radius: 2px; background: root.preview-dim; }
                }
            }
        }
        HorizontalLayout {
            height: 20px; spacing: 6px; cross-axis-alignment: center;
            UiIcon { name: root.dark ? "moon" : "sun"; width: 14px; height: 14px; }
            Text { text: root.dark ? "Dark" : "Light"; color: Theme.text; font-size: 13px; font-weight: 500; horizontal-stretch: 1; vertical-alignment: center; accessible-role: none; }
            Rectangle {
                width: 16px; height: 16px; border-radius: 8px;
                border-width: 1px; border-color: root.selected ? Theme.accent : Theme.strong-border;
                background: root.selected ? Theme.accent : transparent;
                if root.selected: UiIcon { x: 2px; y: 2px; name: "check"; width: 12px; height: 12px; ink: Theme.on-accent; }
            }
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.choose(); } }
    focus := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space { root.choose(); return accept; }
            return reject;
        }
    }
}

component EffectSelector inherits Rectangle {
    in property <[string]> labels;
    in property <bool> surface-tabs;
    in property <int> selected;
    callback select(int);
    height: root.surface-tabs ? 34px : 30px;
    border-radius: 9px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.subtle;
    accessible-role: groupbox;
    accessible-label: root.surface-tabs ? "Surface target" : "Sidebar backdrop mode";

    for option[i] in root.labels: ActionButton {
        width: (root.width - 6px - (root.labels.length - 1) * 2px) / max(1, root.labels.length);
        height: root.height - 6px;
        x: 3px + i * (self.width + 2px); y: 3px;
        label: option; label-size: root.surface-tabs ? 12px : 11.5px;
        quiet: root.selected != i; fill: Theme.surface;
        ink: root.selected == i ? Theme.text : Theme.muted;
        outline: Theme.border; border-radius: 6px;
        accessible-label: root.surface-tabs ? (i == 0 ? "Sidebar surface effects" : "Notification surface effects") : option;
        accessible-checkable: true; accessible-checked: root.selected == i;
        clicked => { root.select(i); }
    }
}

component AppearanceSlider inherits VerticalLayout {
    in property <string> label;
    in property <string> control-label;
    in property <bool> enabled: true;
    in property <string> unit;
    in property <int> maximum;
    in-out property <int> amount;
    callback committed;
    spacing: 2px;
    alignment: start;
    changed amount => { control.value = root.amount; }

    function commit(next: float) {
        if root.enabled {
            root.amount = round(clamp(next, 0, root.maximum));
            control.value = root.amount;
            root.committed();
        }
    }
    HorizontalLayout {
        height: 18px; spacing: 12px; cross-axis-alignment: center;
        Text {
            text: root.label; color: Theme.secondary; font-size: 12.5px; font-weight: 500;
            min-width: 0px; horizontal-stretch: 1; overflow: elide; accessible-role: none;
        }
        NumericText {
            text: root.amount + root.unit; color: Theme.secondary; font-size: 12px;
            horizontal-alignment: right; accessible-role: none;
        }
    }
    Rectangle {
        min-width: 0px; height: 24px;
        control := Slider {
            width: parent.width;
            height: parent.height;
            minimum: 0;
            maximum: root.maximum;
            step: 1;
            value: root.amount;
            enabled: root.enabled;
            accessible-label: root.control-label;
            accessible-enabled: root.enabled; accessible-value-step: 1;
            changed(next) => { root.amount = round(next); }
            released(next) => { root.commit(next); }
            accessible-action-set-value(next) => { if next.is-float() { root.commit(next.to-float()); } }
            accessible-action-increment => { root.commit(root.amount + 1); }
            accessible-action-decrement => { root.commit(root.amount - 1); }
        }
        // Keep the native slider's hit target, keyboard handling and accessibility.
        Rectangle {
            background: Theme.surface;
            rail := Rectangle {
                x: 10px;
                width: parent.width - 20px;
                height: 4px;
                border-radius: 2px;
                background: Theme.switch-off;
                Rectangle {
                    x: 0px;
                    width: parent.width * root.amount / root.maximum;
                    border-radius: parent.border-radius;
                    background: Theme.accent;
                }
            }
            Rectangle {
                width: 18px; height: self.width;
                x: rail.x + rail.width * root.amount / root.maximum - self.width / 2;
                border-radius: self.width / 2;
                border-width: 1px;
                border-color: control.has-focus ? Theme.accent : Theme.border;
                background: Theme.surface;
                Rectangle { width: 10px; height: self.width; border-radius: self.width / 2; background: Theme.accent; }
            }
        }
    }
}

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.divider;
}

export component ReleaseNotesDialog inherits Rectangle {
    in property <string> version;
    in property <string> notes;
    callback close;
    background: Theme.overlay;
    accessible-role: groupbox;
    accessible-label: "Release notes";
    init => { header.focus(); }
    TouchArea {}
    FocusScope {
        width: parent.width; height: parent.height;
        forward-focus: header;
        key-pressed(event) => {
            if event.text == Key.Escape { root.close(); return accept; }
            if event.text == Key.Tab || event.text == Key.Backtab { header.focus(); return accept; }
            if event.text == Key.PageDown || event.text == Key.DownArrow {
                scroll.content-y = max(scroll.visible-height - scroll.content-height, scroll.content-y - (event.text == Key.PageDown ? scroll.visible-height : 28px));
                return accept;
            }
            if event.text == Key.PageUp || event.text == Key.UpArrow {
                scroll.content-y = min(0px, scroll.content-y + (event.text == Key.PageUp ? scroll.visible-height : 28px));
                return accept;
            }
            return reject;
        }
        SurfaceCard {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: min(600px, parent.width - 48px);
            height: min(parent.height - 48px, min(520px, max(156px, 72px + notes-content.preferred-height)));
            clip: true;
            VerticalLayout {
                padding: 1px;
                header := DialogHeader {
                    title: "What's new"; subtitle: "True Proxy " + root.version; numeric-subtitle: true;
                    icon: "file"; close-label: "Close release notes"; close => { root.close(); }
                }
                scroll := ScrollView {
                    min-height: 0px; vertical-stretch: 1;
                    horizontal-scrollbar-policy: always-off;
                    content-width: self.visible-width;
                    content-height: max(self.visible-height, notes-content.preferred-height);
                    notes-content := VerticalLayout {
                        padding: Theme.panel-padding; alignment: start;
                        Text {
                            text: root.notes == "" ? "No release notes were provided for this version." : root.notes;
                            accessible-label: self.text;
                            color: root.notes == "" ? Theme.muted : Theme.text;
                            font-size: 14px; wrap: word-wrap; min-width: 0px;
                        }
                    }
                }
            }
        }
    }
}

export component GeneralSettings inherits VerticalLayout {
    in property <bool> dark-theme;
    in property <bool> busy;
    in property <bool> local-test;
    in property <bool> autostart-enabled;
    in property <bool> autostart-busy;
    in property <bool> updates-automatic;
    in property <bool> update-busy;
    in property <bool> update-available;
    in property <string> update-version;
    in property <string> update-status;
    in property <string> app-version;
    in-out property <int> sidebar-backdrop: 2;
    in property <bool> sidebar-backdrop-active;
    in-out property <int> sidebar-transparency: 30;
    in-out property <int> sidebar-blur: 32;
    in-out property <int> notice-transparency;
    in-out property <int> notice-blur;
    callback choose-theme(bool);
    callback set-autostart(bool);
    callback set-updates-automatic(bool);
    callback check-updates;
    callback show-release-notes;
    callback install-update;
    callback save-notice-appearance;
    callback save-sidebar-appearance;
    private property <bool> notification-effects;
    callback open-import;
    callback export-config;
    alignment: start;
    spacing: 16px;

    FormCard {
        title: "Configuration"; icon: "files";
        caption: "Move your proxies and routing rules between devices.";
        inset-body: false;
        VerticalLayout {
            Divider {}
            config-actions := Rectangle {
                private property <bool> stacked: self.width < warning.width + buttons.width + 64px;
                height: stacked ? 110px : 70px;
                background: Theme.subtle;
                border-bottom-left-radius: Theme.radius-large - 1px;
                border-bottom-right-radius: Theme.radius-large - 1px;
                warning := Badge {
                    label: "Exports include proxy passwords."; icon: "lock";
                    fill: Theme.warning-surface; outline: Theme.warning-border; ink: Theme.warning-detail; icon-ink: Theme.warning-icon;
                    height: 32px; border-radius: 8px; font-size: 12.5px;
                    x: Theme.panel-padding; y: config-actions.stacked ? 14px : (parent.height - self.height) / 2;
                }
                buttons := HorizontalLayout {
                    width: self.preferred-width; height: 36px;
                    spacing: 10px;
                    x: config-actions.stacked ? Theme.panel-padding : parent.width - self.width - Theme.panel-padding;
                    y: config-actions.stacked ? 58px : (parent.height - self.height) / 2;
                    ActionButton { label: "Import configuration"; accessible-label: "Import"; icon: "download"; primary: true; height: 36px; enabled: !root.busy; clicked => { root.open-import(); } }
                    ActionButton { label: "Export JSON"; accessible-label: "Export"; icon: "upload"; height: 36px; clicked => { root.export-config(); } }
                }
            }
        }
    }

    preferences := Rectangle {
        private property <bool> columns: self.width > 760px;
        private property <length> column-width: self.columns ? (self.width - 16px) / 2 : self.width;
        private property <length> row-height: max(theme-card.content-height, effects-card.content-height);
        height: self.columns ? self.row-height : theme-card.height + 16px + effects-card.height;
        vertical-stretch: 0;
        theme-card := FormCard {
            x: 0px; y: 0px; width: preferences.column-width;
            height: preferences.columns ? preferences.row-height : self.content-height;
            title: "Theme"; icon: "sun"; header-icon-size: 36px; caption: "Choose the application theme.";
            inset-body: false; stretch-body: true;
            VerticalLayout {
                vertical-stretch: 1;
                Divider {}
                VerticalLayout {
                    vertical-stretch: 1; alignment: center; padding: Theme.card-padding;
                    HorizontalLayout {
                        height: 132px; spacing: 14px;
                        ThemeChoice { dark: false; selected: !root.dark-theme; choose => { root.choose-theme(false); } }
                        ThemeChoice { dark: true; selected: root.dark-theme; choose => { root.choose-theme(true); } }
                    }
                }
            }
        }
        effects-card := FormCard {
            x: preferences.columns ? preferences.column-width + 16px : 0px;
            y: preferences.columns ? 0px : theme-card.height + 16px;
            width: preferences.column-width;
            height: preferences.columns ? preferences.row-height : self.content-height;
            title: "Surface Effects"; icon: "layers"; header-icon-size: 36px;
            caption: root.notification-effects ? "Customize notification transparency and blur."
                : root.sidebar-backdrop == 0 ? "The sidebar uses a solid background."
                : !root.sidebar-backdrop-active ? "Windows is using a solid sidebar."
                : root.sidebar-backdrop == 1 ? "Mica uses colors from your desktop wallpaper."
                : "Set frost to zero for a clear view through the sidebar.";
            inset-body: false;
            VerticalLayout {
                Divider {}
                VerticalLayout {
                    padding: Theme.card-padding; spacing: 16px;
                    EffectSelector {
                        labels: ["Sidebar", "Notifications"]; surface-tabs: true;
                        selected: root.notification-effects ? 1 : 0;
                        select(index) => { root.notification-effects = index == 1; }
                    }
                    Rectangle {
                        // The controls keep their height as the user switches tabs.
                        height: 146px;
                        if !root.notification-effects: VerticalLayout {
                            spacing: 14px;
                            HorizontalLayout {
                                height: 30px; spacing: 8px; cross-axis-alignment: center;
                                Text { text: "Backdrop"; color: Theme.secondary; font-size: 12.5px; font-weight: 500; horizontal-stretch: 1; }
                                EffectSelector {
                                    width: 164px; labels: ["Off", "Mica", "Acrylic"]; selected: root.sidebar-backdrop;
                                    select(index) => {
                                        if index != root.sidebar-backdrop {
                                            root.sidebar-backdrop = index;
                                            root.save-sidebar-appearance();
                                        }
                                    }
                                }
                            }
                            AppearanceSlider {
                                label: "Transparency"; control-label: "Sidebar transparency"; unit: "%"; maximum: 100;
                                enabled: root.sidebar-backdrop != 0; opacity: self.enabled ? 1 : 0.42;
                                amount <=> root.sidebar-transparency; committed => { root.save-sidebar-appearance(); }
                            }
                            AppearanceSlider {
                                label: "Frost level"; control-label: "Sidebar frost level"; unit: " / 32"; maximum: 32;
                                enabled: root.sidebar-backdrop != 0; opacity: self.enabled ? 1 : 0.42;
                                amount <=> root.sidebar-blur; committed => { root.save-sidebar-appearance(); }
                            }
                        }
                        if root.notification-effects: VerticalLayout {
                            alignment: center; spacing: 16px;
                            AppearanceSlider {
                                label: "Transparency"; control-label: "Notification transparency"; unit: "%"; maximum: 100;
                                amount <=> root.notice-transparency; committed => { root.save-notice-appearance(); }
                            }
                            AppearanceSlider {
                                label: "Background blur"; control-label: "Notification background blur"; unit: " px"; maximum: 24;
                                amount <=> root.notice-blur; committed => { root.save-notice-appearance(); }
                            }
                        }
                    }
                }
            }
        }
    }
    FormCard {
        title: "Application updates"; icon: "refresh"; header-icon-size: 36px;
        caption: "Check at launch and every six hours."; inset-body: false;
        action-label: root.update-busy ? "Checking…" : "Check for updates";
        action-accessibility: "Check for Updates"; action-icon: "refresh";
        action-enabled: !root.update-busy; outlined-action: true;
        action => { root.check-updates(); }
        VerticalLayout {
            Divider {}
            VerticalLayout {
                padding-left: Theme.card-padding; padding-right: Theme.card-padding; padding-top: 14px; padding-bottom: 14px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 16px; cross-axis-alignment: center;
                    Text { text: "Automatic update checks"; color: Theme.text; font-size: 13.5px; font-weight: 500; min-width: 0px; horizontal-stretch: 1; wrap: word-wrap; }
                    RuleSwitch { label: "Check for updates automatically"; checked: root.updates-automatic; toggled => { root.set-updates-automatic(!root.updates-automatic); } }
                }
                if root.update-available: HorizontalLayout {
                    spacing: 8px; cross-axis-alignment: center;
                    NumericText { text: "True Proxy " + root.update-version; color: Theme.text; font-size: 13px; min-width: 0px; horizontal-stretch: 1; overflow: elide; }
                    ActionButton { label: "What's new"; height: 32px; clicked => { root.show-release-notes(); } }
                    ActionButton { label: "Install and Restart"; primary: true; height: 32px; enabled: !root.busy && !root.update-busy; clicked => { root.install-update(); } }
                }
            }
            if root.update-status != "": VerticalLayout {
                Divider {}
                Rectangle {
                    height: status-row.preferred-height; background: Theme.card-footer;
                    border-bottom-left-radius: Theme.radius-large - 1px; border-bottom-right-radius: Theme.radius-large - 1px;
                    status-row := HorizontalLayout {
                        padding-left: Theme.card-padding; padding-right: Theme.card-padding; padding-top: 12px; padding-bottom: 12px;
                        spacing: 8px; cross-axis-alignment: center;
                        UiIcon { name: "clock"; width: 14px; height: 14px; ink: Theme.muted; }
                        NumericText { text: root.update-status; font-size: 12px; color: Theme.muted; min-width: 0px; horizontal-stretch: 1; wrap: word-wrap; }
                    }
                }
            }
        }
    }
    SurfaceCard {
        height: startup-content.preferred-height;
        startup-content := HorizontalLayout {
            padding-left: Theme.card-padding; padding-right: Theme.card-padding; padding-top: 16px; padding-bottom: 16px;
            spacing: 14px; cross-axis-alignment: center;
            IconTile { name: "power"; width: 36px; height: 36px; border-radius: 9px; }
            VerticalLayout {
                min-width: 0px; horizontal-stretch: 1; spacing: 2px; alignment: center;
                Text { text: "Launch at Windows sign-in"; color: Theme.text; font-size: Theme.card-title-size; font-weight: 600; wrap: word-wrap; }
                Text {
                    text: root.local-test ? "Windows startup is managed by the installed app." : root.autostart-busy ? "Updating startup settings…" : "Start in the tray and restore routing automatically.";
                    color: Theme.muted; font-size: Theme.body-size; wrap: word-wrap;
                }
            }
            RuleSwitch {
                label: "Start when I sign in to Windows"; checked: root.autostart-enabled;
                enabled: !root.autostart-busy && !root.local-test;
                toggled => { root.set-autostart(!root.autostart-enabled); }
            }
        }
    }
    NumericText {
        text: "True Proxy v" + root.app-version; color: Theme.muted; font-size: 12px;
        horizontal-alignment: right;
    }
}
