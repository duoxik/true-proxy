import { ScrollView, Palette } from "std-widgets.slint";
import { Theme, ProxyRow, ProcessSummary, LogRow, ConnectionFilterRow, Field, ActionButton, ConnectionFilterCheck } from "common.slint";

component JournalFilters inherits VerticalLayout {
    in property <string> title;
    in property <string> scope;
    in property <[ConnectionFilterRow]> rows;
    in property <length> viewport-height;
    callback toggled(string, bool);
    min-width: 0px;
    vertical-stretch: 0;
    spacing: 3px;

    Text { text: root.title; color: Theme.secondary; font-size: 11px; font-weight: 600; }
    ScrollView {
        min-height: root.viewport-height;
        preferred-height: root.viewport-height;
        max-height: root.viewport-height;
        vertical-stretch: 0;
        horizontal-scrollbar-policy: always-off;
        content-width: self.visible-width;
        content-height: filter-content.preferred-height;
        filter-content := VerticalLayout {
            spacing: 0px;
            padding-right: Theme.scroll-gutter;
            alignment: start;
            for row in root.rows: HorizontalLayout {
                height: 28px;
                spacing: 8px;
                for option in row.options: ConnectionFilterCheck {
                    min-width: 0px;
                    horizontal-stretch: 1;
                    option: option;
                    scope: root.scope;
                    toggled(checked) => { root.toggled(option.key, checked); }
                }
            }
        }
    }
}

component JournalEntry inherits Rectangle {
    in property <LogRow> entry;
    in property <bool> show-process;
    height: 66px;
    min-width: 0px;
    border-radius: Theme.radius-small;
    background: Theme.field;

    HorizontalLayout {
        padding: 10px;
        spacing: 12px;
        Text {
            text: root.entry.route;
            width: 108px;
            color: Theme.accent;
            font-size: 11px;
            overflow: elide;
            vertical-alignment: center;
        }
        VerticalLayout {
            min-width: 0px;
            spacing: 3px;
            alignment: center;
            Text { text: root.entry.destination; min-width: 0px; color: Theme.text; font-size: 12px; overflow: elide; }
            Text { text: root.show-process ? root.entry.process + " · " + root.entry.source : root.entry.source; min-width: 0px; color: Theme.secondary; font-size: 10px; overflow: elide; }
            Text { text: root.entry.message; min-width: 0px; color: Theme.muted; font-size: 10px; overflow: elide; }
        }
        Rectangle {
            width: 110px;
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: parent.width;
                height: 25px;
                border-radius: Theme.radius-small;
                background: Theme.surface;
                Text {
                    text: root.entry.status;
                    color: root.entry.state == 1 ? Theme.success : root.entry.state == 0 ? Theme.accent : root.entry.state == 2 ? Theme.warning : (root.entry.state == 4 || root.entry.state == 5) ? Theme.danger : Theme.secondary;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}

component JournalGroup inherits Rectangle {
    in property <ProcessSummary> process;
    callback toggled;
    min-width: 0px;
    height: group-content.preferred-height;
    vertical-stretch: 0;
    border-radius: Theme.radius-medium;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;

    group-content := VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 48px;
            border-radius: Theme.radius-medium;
            border-width: header-focus.has-focus ? 1px : 0px;
            border-color: Theme.accent;
            background: header-touch.has-hover ? Theme.surface-hover : root.process.expanded ? Theme.accent-soft : transparent;
            accessible-role: button;
            accessible-label: "Подключения " + root.process.name;
            accessible-expanded: root.process.expanded;
            accessible-action-default => { root.toggled(); }
            forward-focus: header-focus;
            HorizontalLayout {
                padding-left: 11px;
                padding-right: 12px;
                spacing: 10px;
                Rectangle {
                    width: 28px;
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 28px;
                        height: 28px;
                        border-radius: Theme.radius-small;
                        background: root.process.expanded ? Theme.primary : Theme.field;
                        Path {
                            x: 8px; y: 8px; width: 12px; height: 12px;
                            viewbox-width: 12; viewbox-height: 12;
                            stroke: root.process.expanded ? Theme.text : Theme.secondary;
                            stroke-width: 1.5px;
                            commands: root.process.expanded ? "M2 4 L6 8 L10 4" : "M4 2 L8 6 L4 10";
                        }
                    }
                }
                Text { text: root.process.name; min-width: 0px; color: Theme.text; font-size: 13px; font-weight: 600; overflow: elide; vertical-alignment: center; }
                Text { text: root.process.active + " активных"; width: 84px; color: root.process.active > 0 ? Theme.success : Theme.secondary; font-size: 11px; overflow: elide; vertical-alignment: center; }
                Text { text: "↑ " + root.process.uploaded + "   ↓ " + root.process.downloaded; width: 170px; color: Theme.secondary; font-size: 11px; overflow: elide; vertical-alignment: center; }
                Text { text: root.process.events + " соед."; width: 80px; color: Theme.muted; font-size: 10px; overflow: elide; vertical-alignment: center; }
            }
            header-touch := TouchArea { mouse-cursor: pointer; clicked => { header-focus.focus(); root.toggled(); } }
            header-focus := FocusScope {
                width: 0px;
                key-pressed(event) => {
                    if event.text == Key.Space || event.text == Key.Return { root.toggled(); return accept; }
                    return reject;
                }
            }
        }
        if root.process.expanded: VerticalLayout {
            padding: 9px;
            spacing: 6px;
            for entry in root.process.connections: JournalEntry {
                entry: entry;
                show-process: root.process.name == "Другие процессы";
            }
        }
    }
}

export component ConnectionsWindow inherits Window {
    icon: @image-url("../assets/icon.svg");
    title: "True Proxy · Соединения";
    preferred-width: 1040px; preferred-height: 760px; min-width: 800px; min-height: 600px;
    background: Theme.background; default-font-family: "Segoe UI"; default-font-size: 13px;
    init => { Palette.color-scheme = ColorScheme.dark; }
    in-out property <bool> surface-fresh: false;
    in property <[ProxyRow]> proxies;
    in property <[ProcessSummary]> process-summaries;
    in property <[string]> expanded-processes;
    in-out property <string> connection-query;
    in property <[ConnectionFilterRow]> connection-route-filters;
    in property <[ConnectionFilterRow]> connection-status-filters;
    in-out property <bool> connection-routes-all: true;
    in-out property <[string]> connection-route-selection;
    in-out property <[string]> connection-status-selection: ["0", "1", "2"];
    in property <bool> connection-filters-default: true;
    in property <int> connection-event-count;
    in property <int> filtered-event-count;
    in-out property <bool> only-active: true;
    in property <int> connection-omitted;
    property <length> route-filter-height: max(28px, min(root.connection-route-filters.length, 3) * 28px);
    property <length> status-filter-height: max(28px, min(root.connection-status-filters.length, 3) * 28px);
    callback set-only-active(bool);
    callback filter-connections;
    callback sync-connections;
    callback suspend-connections;
    callback resume-observation;
    callback toggle-connection-route(string, bool);
    callback toggle-connection-status(string, bool);
    callback reset-connection-filters;
    callback expand-process(string);
    callback hide-window;

    // Repaint the full opaque surface on native restore/resize.
    surface := Rectangle {
        width: parent.width;
        height: parent.height;
        background: root.surface-fresh ? Theme.background-refresh : Theme.background;

        VerticalLayout {
            padding: 20px;
            spacing: 10px;
            HorizontalLayout {
                height: 36px;
                spacing: 10px;
                Rectangle { width: 30px;
                    Image { y: (parent.height - self.height) / 2; width: 30px; height: 30px; source: @image-url("../assets/icon.svg"); }
                }
                Text { text: "Соединения"; color: Theme.text; font-size: 23px; font-weight: 600; vertical-alignment: center; }
            }
            Rectangle {
                height: filter-card.preferred-height;
                vertical-stretch: 0;
                border-radius: Theme.radius-large;
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.surface;
                filter-card := VerticalLayout {
                    padding: 11px;
                    spacing: 6px;
                    alignment: start;
                    Field { placeholder: "Поиск по имени процесса"; value <=> root.connection-query; edited => { root.filter-connections(); } }
                    JournalFilters {
                        title: "Маршруты";
                        scope: "Маршрут";
                        rows: root.connection-route-filters;
                        viewport-height: root.route-filter-height;
                        toggled(key, checked) => { root.toggle-connection-route(key, checked); }
                    }
                    JournalFilters {
                        title: "Статусы";
                        scope: "Статус";
                        rows: root.connection-status-filters;
                        viewport-height: root.status-filter-height;
                        toggled(key, checked) => { root.toggle-connection-status(key, checked); }
                    }
                }
            }
            HorizontalLayout {
                height: 30px;
                spacing: 10px;
                padding-left: 4px;
                padding-right: Theme.scroll-gutter;
                Text {
                    text: "По процессам · " + root.filtered-event-count + " из " + root.connection-event-count + " соединений";
                    min-width: 0px;
                    color: Theme.secondary;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if !root.connection-filters-default: ActionButton { label: "Сбросить фильтры"; height: 28px; clicked => { root.reset-connection-filters(); } }
            }
            connection-list := ScrollView {
                vertical-stretch: 1;
                horizontal-scrollbar-policy: always-off;
                content-width: self.visible-width;
                content-height: max(self.visible-height, connection-content.preferred-height);
                connection-content := VerticalLayout {
                    spacing: 8px;
                    padding-right: Theme.scroll-gutter;
                    padding-bottom: 8px;
                    if root.process-summaries.length == 0: Rectangle {
                        height: 58px;
                        background: Theme.surface;
                        border-radius: Theme.radius-medium;
                        Text {
                            text: "Нет подключений для выбранного фильтра.";
                            color: Theme.muted;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    for process in root.process-summaries: JournalGroup {
                        process: process;
                        toggled => { root.expand-process(process.name); }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }
            if !root.only-active: Text { text: "История: последние 256 завершённых соединений с момента выбора завершённых статусов. Трафик — через SOCKS."; color: Theme.muted; font-size: 10px; wrap: word-wrap; }
            if root.connection-omitted > 0: Text { text: "Лимит отслеживания: 4096 активных соединений. Пропущено: " + root.connection-omitted; color: Theme.warning; font-size: 10px; wrap: word-wrap; }
        }
    }
}
