import { ScrollView } from "std-widgets.slint";
import { PageHeader, Theme, UiIcon, ProcessSummary, ConnectionFilterOption, Field, ActionButton, ConnectionFilterCheck } from "common.slint";

component TrafficMetric inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> ink;
    height: 68px;
    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    border-radius: Theme.radius-medium;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;

    Rectangle {
        x: 0px; y: 13px;
        width: 4px; height: parent.height - 26px;
        border-radius: 2px;
        background: root.ink;
    }
    VerticalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 3px;
        alignment: center;
        Text { text: root.label; color: Theme.secondary; font-size: 10px; font-weight: 700; min-width: 0px; overflow: elide; }
        Text { text: root.value; color: Theme.text; font-size: 23px; font-weight: 700; min-width: 0px; overflow: elide; }
    }
}

component ConnectionFilterMenu inherits Rectangle {
    in property <string> title;
    in property <string> scope;
    in property <string> summary;
    in property <[ConnectionFilterOption]> options;
    callback toggled(string, bool);
    width: 120px;
    height: 34px;
    border-radius: Theme.radius-small;
    border-width: 1px;
    border-color: menu.is-open || focus.has-focus ? Theme.accent : Theme.border;
    background: menu.is-open || touch.has-hover ? Theme.accent-soft : Theme.surface;
    accessible-role: button;
    accessible-expanded: menu.is-open;
    accessible-action-default => { root.toggle-menu(); }
    forward-focus: focus;

    function toggle-menu() {
        if menu.is-open { menu.close(); }
        else { menu.show(); }
    }
    HorizontalLayout {
        padding-left: 9px;
        padding-right: 8px;
        spacing: 5px;
        Text { text: root.title; color: Theme.text; font-size: 12px; font-weight: 600; vertical-alignment: center; accessible-role: none; }
        Rectangle {
            width: max(22px, summary-text.preferred-width + 9px);
            Rectangle {
                y: (parent.height - self.height) / 2;
                height: 18px;
                border-radius: 9px;
                background: Theme.accent-soft;
                summary-text := Text { text: root.summary; color: Theme.accent; font-size: 10px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; accessible-role: none; }
            }
        }
        Rectangle {
            width: 15px;
            UiIcon { y: (parent.height - self.height) / 2; width: 15px; height: 15px; name: menu.is-open ? "chevron-up" : "chevron-down"; }
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.toggle-menu(); } }
    focus := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return || event.text == Key.DownArrow {
                root.toggle-menu();
                return accept;
            }
            return reject;
        }
    }
    menu := PopupWindow {
        x: root.width - self.width;
        y: root.height + 6px;
        width: 270px;
        height: min(root.options.length, 8) * 30px + 12px;
        close-policy: close-on-click-outside;
        forward-focus: menu-focus;
        menu-focus := FocusScope {
            key-pressed(event) => {
                if event.text == Key.Escape { menu.close(); return accept; }
                return reject;
            }
            Rectangle {
                border-radius: Theme.radius-small;
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.surface;
                filter-options := ScrollView {
                    x: 6px; y: 6px;
                    width: parent.width - 12px;
                    height: parent.height - 12px;
                    horizontal-scrollbar-policy: always-off;
                    content-width: self.visible-width;
                    content-height: choices.preferred-height;
                    choices := VerticalLayout {
                        alignment: start;
                        padding-right: root.options.length > 8 ? Theme.scroll-gutter : 0px;
                        for option in root.options: ConnectionFilterCheck {
                            height: 30px;
                            option: option;
                            scope: root.scope;
                            toggled(checked) => { root.toggled(option.key, checked); }
                        }
                    }
                }
            }
        }
    }
}

component JournalCell inherits VerticalLayout {
    in property <string> label;
    in property <string> detail;
    in property <bool> heading;
    in property <bool> emphasized;
    in property <bool> numeric;
    in property <bool> monospace;
    in property <color> ink: Theme.text;
    in property <color> detail-ink: Theme.muted;
    min-width: 0px;
    alignment: center;
    spacing: 2px;

    if root.label != "": Text {
        text: root.label;
        min-width: 0px;
        color: root.heading ? Theme.secondary : root.ink;
        font-size: root.heading ? 10px : 12px;
        font-weight: root.heading || root.emphasized ? 600 : 400;
        font-family: !root.heading && root.monospace ? "Consolas" : "Segoe UI";
        horizontal-alignment: root.numeric ? right : left;
        overflow: elide;
    }
    if root.detail != "": Text {
        text: root.detail;
        min-width: 0px;
        color: root.detail-ink;
        font-size: 10px;
        overflow: elide;
    }
}

// Use the same columns for headings, application summaries, and connection details.
component JournalLine inherits HorizontalLayout {
    in property <bool> heading;
    in property <bool> group;
    in property <bool> expanded;
    in property <string> application;
    in property <image> application-icon;
    private property <bool> has-application-icon: root.application-icon.width > 0;
    in property <string> source;
    in property <string> destination;
    in property <string> target-detail;
    in property <string> explanation;
    in property <string> route;
    in property <string> started;
    in property <string> elapsed;
    in property <string> status;
    in property <color> status-ink: Theme.secondary;
    in property <string> sent;
    in property <string> received;
    padding-left: 14px;
    padding-right: 14px;
    spacing: 8px;
    min-width: 0px;

    HorizontalLayout {
        min-width: 0px;
        preferred-width: 0px;
        horizontal-stretch: 1;
        spacing: 6px;
        if root.group: Rectangle {
            width: 16px;
            UiIcon {
                y: (parent.height - self.height) / 2;
                width: 14px;
                height: 14px;
                name: root.expanded ? "chevron-down" : "chevron-right";
                ink: Theme.secondary;
            }
        }
        if root.group: Rectangle {
            width: 24px;
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 24px;
                height: 24px;
                border-radius: Theme.radius-small;
                background: root.has-application-icon ? transparent : Theme.accent-soft;
                if root.has-application-icon: Image {
                    x: 2px;
                    y: 2px;
                    width: 20px;
                    height: 20px;
                    source: root.application-icon;
                    image-fit: contain;
                    accessible-role: none;
                }
                if !root.has-application-icon: UiIcon {
                    x: 5px;
                    y: 5px;
                    width: 14px;
                    height: 14px;
                    name: "app";
                    ink: Theme.accent;
                }
            }
        }
        if !root.group && !root.heading: Rectangle { width: 16px; }
        JournalCell { label: root.application; detail: root.source; heading: root.heading; emphasized: true; horizontal-stretch: 1; }
    }
    JournalCell { preferred-width: 0px; label: root.destination; detail: root.target-detail; heading: root.heading; monospace: !root.group; ink: root.group ? Theme.secondary : Theme.text; horizontal-stretch: 1.35; }
    JournalCell { width: 76px; label: root.started; heading: root.heading; monospace: true; ink: Theme.secondary; }
    JournalCell {
        width: 68px;
        label: root.elapsed != "" ? root.elapsed : root.status;
        detail: root.elapsed != "" ? root.status : "";
        heading: root.heading;
        monospace: root.elapsed != "";
        ink: root.group ? root.status-ink : Theme.secondary;
        detail-ink: root.status-ink;
    }
    JournalCell { preferred-width: 0px; label: root.route; detail: root.explanation; heading: root.heading; emphasized: true; horizontal-stretch: 1.35; }
    JournalCell { width: 66px; label: root.sent; heading: root.heading; numeric: true; monospace: true; ink: root.group ? Theme.success : Theme.muted; }
    JournalCell { width: 66px; label: root.received; heading: root.heading; numeric: true; monospace: true; ink: root.group ? Theme.blue : Theme.muted; }
}

component JournalGroup inherits Rectangle {
    in property <ProcessSummary> process;
    in property <bool> stripe;
    callback toggled;
    min-width: 0px;
    height: group-content.preferred-height;
    vertical-stretch: 0;

    group-content := VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 40px;
            border-width: header-focus.has-focus ? 1px : 0px;
            border-color: Theme.accent;
            background: header-touch.has-hover ? Theme.surface-hover : root.process.expanded ? Theme.accent-soft : root.stripe ? Theme.field : Theme.surface;
            accessible-role: button;
            accessible-label: "Connections for " + root.process.name;
            accessible-expanded: root.process.expanded;
            accessible-action-default => { root.toggled(); }
            forward-focus: header-focus;
            JournalLine {
                group: true;
                expanded: root.process.expanded;
                application: root.process.name;
                application-icon: root.process.icon;
                destination: root.process.events + (root.process.events == 1 ? " connection" : " connections");
                status: root.process.active + " active";
                status-ink: root.process.active > 0 ? Theme.success : Theme.secondary;
                sent: root.process.uploaded;
                received: root.process.downloaded;
            }
            header-touch := TouchArea { mouse-cursor: pointer; clicked => { header-focus.focus(); root.toggled(); } }
            header-focus := FocusScope {
                width: 0px;
                key-pressed(event) => {
                    if event.text == Key.Space || event.text == Key.Return { root.toggled(); return accept; }
                    return reject;
                }
            }
        }
        if root.process.expanded: VerticalLayout {
            for entry[index] in root.process.connections: Rectangle {
                height: 44px;
                background: mod(index, 2) == 0 ? Theme.field : Theme.surface;
                JournalLine {
                    application: entry.process;
                    source: entry.pid;
                    destination: entry.destination;
                    target-detail: "From " + entry.source;
                    explanation: entry.message;
                    route: entry.route;
                    started: entry.started;
                    elapsed: entry.elapsed;
                    status: entry.status;
                    status-ink: entry.state == 1 ? Theme.success : entry.state == 0 ? Theme.accent : entry.state == 2 ? Theme.warning : (entry.state == 4 || entry.state == 5) ? Theme.danger : Theme.secondary;
                    sent: "—";
                    received: "—";
                }
            }
        }
    }
}

export global ConnectionMonitor {
    in property <[ProcessSummary]> process-summaries;
    in property <[string]> expanded-processes;
    in-out property <string> connection-query;
    in property <[ConnectionFilterOption]> connection-route-filters;
    in property <[ConnectionFilterOption]> connection-status-filters;
    in property <string> connection-route-summary: "Proxy";
    in-out property <bool> connection-routes-all: false;
    in-out property <[string]> connection-route-selection: ["proxy"];
    in-out property <[string]> connection-status-selection: ["0", "1", "2"];
    in property <bool> connection-filters-default: true;
    in property <int> connection-event-count;
    in property <int> filtered-event-count;
    in-out property <bool> only-active: true;
    in property <int> connection-omitted;
    in property <int> active-connection-count;
    in property <string> total-sent: "0 B";
    in property <string> total-received: "0 B";
    in property <string> total-traffic: "0 B";
    callback set-only-active(bool);
    callback filter-connections;
    callback toggle-connection-route(string, bool);
    callback toggle-connection-status(string, bool);
    callback reset-connection-filters;
    callback expand-process(string);
    callback process-icon(string, int) -> image;
}

export component ConnectionsView inherits VerticalLayout {
    in property <bool> preview-ui;
    min-width: 0px;
    spacing: 10px;
    PageHeader { title: "Traffic Monitor"; badge: root.preview-ui ? "Sample data" : ""; }
    HorizontalLayout {
        height: 68px;
        spacing: 10px;
        vertical-stretch: 0;
        TrafficMetric { label: "ACTIVE CONNECTIONS"; value: ConnectionMonitor.active-connection-count; ink: Theme.accent; }
        TrafficMetric { label: "TOTAL SENT"; value: ConnectionMonitor.total-sent; ink: Theme.success; }
        TrafficMetric { label: "TOTAL RECEIVED"; value: ConnectionMonitor.total-received; ink: Theme.blue; }
        TrafficMetric { label: "TOTAL TRAFFIC"; value: ConnectionMonitor.total-traffic; ink: Theme.primary; }
    }
    Rectangle {
        vertical-stretch: 1;
        border-radius: Theme.radius-medium;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.surface;
        clip: true;

        VerticalLayout {
            padding: 1px;
            HorizontalLayout {
                height: 54px;
                padding-left: 14px;
                padding-right: 14px;
                spacing: 8px;

                Text { text: "Connections"; color: Theme.text; font-size: 15px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 0; }
                Rectangle {
                    width: max(25px, count-label.preferred-width + 12px);
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: 22px;
                        border-radius: 11px;
                        background: Theme.accent-soft;
                        count-label := Text { text: "" + ConnectionMonitor.filtered-event-count; color: Theme.accent; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    width: reset.min-width;
                    reset := ActionButton { y: (parent.height - self.height) / 2; label: "Reset filters"; icon: "refresh"; icon-only: true; height: 34px; enabled: !ConnectionMonitor.connection-filters-default; clicked => { connection-list.content-y = 0px; ConnectionMonitor.reset-connection-filters(); } }
                }
                Rectangle {
                    width: 120px;
                    ConnectionFilterMenu {
                        y: (parent.height - self.height) / 2;
                        title: "Routes";
                        scope: "Route";
                        accessible-label: "Filter routes";
                        summary: ConnectionMonitor.connection-route-summary;
                        options: ConnectionMonitor.connection-route-filters;
                        toggled(key, checked) => { connection-list.content-y = 0px; ConnectionMonitor.toggle-connection-route(key, checked); }
                    }
                }
                Rectangle {
                    width: 120px;
                    ConnectionFilterMenu {
                        y: (parent.height - self.height) / 2;
                        title: "Statuses";
                        scope: "Status";
                        accessible-label: "Filter statuses";
                        summary: ConnectionMonitor.connection-status-selection.length == ConnectionMonitor.connection-status-filters.length - 1
                            ? "All" : "" + ConnectionMonitor.connection-status-selection.length;
                        options: ConnectionMonitor.connection-status-filters;
                        toggled(key, checked) => { connection-list.content-y = 0px; ConnectionMonitor.toggle-connection-status(key, checked); }
                    }
                }
                Rectangle {
                    width: 190px;
                    Field {
                        y: (parent.height - self.height) / 2;
                        height: 34px;
                        field-height: 34px;
                        placeholder: "Search process name";
                        icon: "search";
                        value <=> ConnectionMonitor.connection-query;
                        edited => { connection-list.content-y = 0px; ConnectionMonitor.filter-connections(); }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }
            Rectangle {
                height: 32px;
                background: Theme.field;
                JournalLine {
                    x: 0px;
                    width: parent.width - Theme.scroll-gutter;
                    heading: true;
                    application: "PROCESS";
                    destination: "TARGET";
                    started: "START";
                    status: "TIME";
                    route: "ROUTE";
                    sent: "↑ SENT";
                    received: "↓ RECV";
                }
            }
            Rectangle { height: 1px; background: Theme.border; }
            connection-list := ScrollView {
                vertical-stretch: 1;
                horizontal-scrollbar-policy: always-off;
                content-width: self.visible-width;
                content-height: max(self.visible-height, connection-content.preferred-height);
                connection-content := VerticalLayout {
                    padding-right: Theme.scroll-gutter;
                    padding-bottom: 8px;
                    alignment: start;
                    if ConnectionMonitor.process-summaries.length == 0: Rectangle {
                        height: 66px;
                        Text {
                            text: ConnectionMonitor.connection-event-count == 0 ? "No connections observed yet." : "No connections match these filters.";
                            color: Theme.muted;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    for process[index] in ConnectionMonitor.process-summaries: JournalGroup {
                        process: process;
                        stripe: mod(index, 2) == 1;
                        toggled => { ConnectionMonitor.expand-process(process.name); }
                    }
                }
            }
        }
    }
    if !ConnectionMonitor.only-active: Text {
        text: "History keeps up to 256 connections completed while history is enabled.";
        color: Theme.muted;
        font-size: 11px;
        wrap: word-wrap;
    }
    if ConnectionMonitor.connection-omitted > 0: Text {
        text: "Tracking limit: 4,096 concurrent connections. Omitted: " + ConnectionMonitor.connection-omitted;
        color: Theme.warning;
        font-size: 11px;
        wrap: word-wrap;
    }
}
