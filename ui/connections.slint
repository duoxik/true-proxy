import { ScrollView, Palette } from "std-widgets.slint";
import { Theme, UiIcon, ProxyRow, ProcessSummary, LogRow, ConnectionFilterRow, Field, ActionButton, ConnectionFilterCheck } from "common.slint";

component JournalFilters inherits VerticalLayout {
    in property <string> title;
    in property <string> scope;
    in property <[ConnectionFilterRow]> rows;
    in property <length> viewport-height;
    callback toggled(string, bool);
    min-width: 0px;
    vertical-stretch: 0;
    spacing: 3px;

    Text { text: root.title; color: Theme.secondary; font-size: 11px; font-weight: 600; }
    ScrollView {
        min-height: root.viewport-height;
        preferred-height: root.viewport-height;
        max-height: root.viewport-height;
        vertical-stretch: 0;
        horizontal-scrollbar-policy: always-off;
        content-width: self.visible-width;
        content-height: filter-content.preferred-height;
        filter-content := VerticalLayout {
            spacing: 0px;
            padding-right: Theme.scroll-gutter;
            alignment: start;
            for row in root.rows: HorizontalLayout {
                height: 28px;
                spacing: 8px;
                for option in row.options: ConnectionFilterCheck {
                    min-width: 0px;
                    horizontal-stretch: 1;
                    option: option;
                    scope: root.scope;
                    toggled(checked) => { root.toggled(option.key, checked); }
                }
            }
        }
    }
}

component JournalCell inherits VerticalLayout {
    in property <string> label;
    in property <string> detail;
    in property <bool> heading;
    in property <bool> emphasized;
    in property <bool> numeric;
    in property <color> ink: Theme.text;
    min-width: 0px;
    alignment: center;
    spacing: 2px;

    if root.label != "": Text {
        text: root.label;
        min-width: 0px;
        color: root.heading ? Theme.secondary : root.ink;
        font-size: root.heading ? 10px : 12px;
        font-weight: root.heading || root.emphasized ? 600 : 400;
        horizontal-alignment: root.numeric ? right : left;
        overflow: elide;
    }
    if root.detail != "": Text {
        text: root.detail;
        min-width: 0px;
        color: Theme.muted;
        font-size: 10px;
        overflow: elide;
    }
}

// Use the same columns for headings, application summaries, and connection details.
component JournalLine inherits HorizontalLayout {
    in property <bool> heading;
    in property <bool> group;
    in property <bool> expanded;
    in property <string> application;
    in property <string> source;
    in property <string> destination;
    in property <string> explanation;
    in property <string> route;
    in property <string> status;
    in property <color> status-ink: Theme.secondary;
    in property <string> sent;
    in property <string> received;
    padding-left: 16px;
    padding-right: 16px;
    spacing: 10px;
    min-width: 0px;

    HorizontalLayout {
        width: 174px;
        spacing: 6px;
        if root.group: Rectangle {
            width: 16px;
            UiIcon {
                y: (parent.height - self.height) / 2;
                width: 14px;
                height: 14px;
                name: root.expanded ? "chevron-down" : "chevron-right";
                ink: Theme.secondary;
            }
        }
        if root.group: Rectangle {
            width: 24px;
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 24px;
                height: 24px;
                border-radius: Theme.radius-small;
                background: Theme.accent-soft;
                UiIcon {
                    x: 5px;
                    y: 5px;
                    width: 14px;
                    height: 14px;
                    name: "app";
                    ink: Theme.accent;
                }
            }
        }
        if !root.group && !root.heading: Rectangle { width: 22px; }
        JournalCell { label: root.application; detail: root.source; heading: root.heading; emphasized: root.group; }
    }
    JournalCell { label: root.destination; detail: root.explanation; heading: root.heading; ink: root.group ? Theme.secondary : Theme.text; horizontal-stretch: 1; }
    JournalCell { width: 124px; label: root.route; heading: root.heading; ink: Theme.accent; }
    JournalCell { width: 94px; label: root.status; heading: root.heading; ink: root.status-ink; }
    JournalCell { width: 74px; label: root.sent; heading: root.heading; numeric: true; ink: Theme.success; }
    JournalCell { width: 74px; label: root.received; heading: root.heading; numeric: true; ink: Theme.accent; }
}

component JournalGroup inherits Rectangle {
    in property <ProcessSummary> process;
    in property <bool> stripe;
    callback toggled;
    min-width: 0px;
    height: group-content.preferred-height;
    vertical-stretch: 0;

    group-content := VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 44px;
            border-width: header-focus.has-focus ? 1px : 0px;
            border-color: Theme.accent;
            background: header-touch.has-hover ? Theme.surface-hover : root.process.expanded ? Theme.accent-soft : root.stripe ? Theme.field : Theme.surface;
            accessible-role: button;
            accessible-label: "Connections for " + root.process.name;
            accessible-expanded: root.process.expanded;
            accessible-action-default => { root.toggled(); }
            forward-focus: header-focus;
            JournalLine {
                group: true;
                expanded: root.process.expanded;
                application: root.process.name;
                destination: root.process.events + (root.process.events == 1 ? " connection" : " connections");
                status: root.process.active + " active";
                status-ink: root.process.active > 0 ? Theme.success : Theme.secondary;
                sent: root.process.uploaded;
                received: root.process.downloaded;
            }
            header-touch := TouchArea { mouse-cursor: pointer; clicked => { header-focus.focus(); root.toggled(); } }
            header-focus := FocusScope {
                width: 0px;
                key-pressed(event) => {
                    if event.text == Key.Space || event.text == Key.Return { root.toggled(); return accept; }
                    return reject;
                }
            }
        }
        if root.process.expanded: VerticalLayout {
            for entry[index] in root.process.connections: Rectangle {
                height: 48px;
                background: mod(index, 2) == 0 ? Theme.field : Theme.surface;
                JournalLine {
                    application: root.process.name == "Other processes" ? entry.process : "";
                    source: entry.source;
                    destination: entry.destination;
                    explanation: entry.message;
                    route: entry.route;
                    status: entry.status;
                    status-ink: entry.state == 1 ? Theme.success : entry.state == 0 ? Theme.accent : entry.state == 2 ? Theme.warning : (entry.state == 4 || entry.state == 5) ? Theme.danger : Theme.secondary;
                }
            }
        }
    }
}

export component ConnectionsWindow inherits Window {
    icon: @image-url("../assets/icon.svg");
    title: "True Proxy · Live Connections";
    preferred-width: 1040px; preferred-height: 760px; min-width: 800px; min-height: 600px;
    background: Theme.background; default-font-family: "Segoe UI"; default-font-size: 13px;
    init => { Palette.color-scheme = ColorScheme.light; }
    in-out property <bool> surface-fresh: false;
    in property <[ProxyRow]> proxies;
    in property <[ProcessSummary]> process-summaries;
    in property <[string]> expanded-processes;
    in-out property <string> connection-query;
    in property <[ConnectionFilterRow]> connection-route-filters;
    in property <[ConnectionFilterRow]> connection-status-filters;
    in-out property <bool> connection-routes-all: true;
    in-out property <[string]> connection-route-selection;
    in-out property <[string]> connection-status-selection: ["0", "1", "2"];
    in property <bool> connection-filters-default: true;
    in property <int> connection-event-count;
    in property <int> filtered-event-count;
    in-out property <bool> only-active: true;
    in property <int> connection-omitted;
    property <length> route-filter-height: max(28px, min(root.connection-route-filters.length, 3) * 28px);
    property <length> status-filter-height: max(28px, min(root.connection-status-filters.length, 3) * 28px);
    callback set-only-active(bool);
    callback filter-connections;
    callback sync-connections;
    callback suspend-connections;
    callback resume-observation;
    callback toggle-connection-route(string, bool);
    callback toggle-connection-status(string, bool);
    callback reset-connection-filters;
    callback expand-process(string);
    callback hide-window;

    // Repaint the full opaque surface on native restore/resize.
    surface := Rectangle {
        width: parent.width;
        height: parent.height;
        background: root.surface-fresh ? Theme.background-refresh : Theme.background;

        VerticalLayout {
            padding: 20px;
            spacing: 12px;
            Rectangle {
                height: filter-card.preferred-height;
                vertical-stretch: 0;
                border-radius: Theme.radius-medium;
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.surface;
                filter-card := VerticalLayout {
                    padding: 12px;
                    spacing: 6px;
                    alignment: start;
                    Field { placeholder: "Search process name"; icon: "search"; value <=> root.connection-query; edited => { root.filter-connections(); } }
                    JournalFilters {
                        title: "Routes";
                        scope: "Route";
                        rows: root.connection-route-filters;
                        viewport-height: root.route-filter-height;
                        toggled(key, checked) => { root.toggle-connection-route(key, checked); }
                    }
                    JournalFilters {
                        title: "Statuses";
                        scope: "Status";
                        rows: root.connection-status-filters;
                        viewport-height: root.status-filter-height;
                        toggled(key, checked) => { root.toggle-connection-status(key, checked); }
                    }
                }
            }
            Rectangle {
                vertical-stretch: 1;
                border-radius: Theme.radius-medium;
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.surface;
                clip: true;

                VerticalLayout {
                    padding: 1px;
                    HorizontalLayout {
                        height: 50px;
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 8px;

                        Rectangle {
                            width: 18px;
                            UiIcon { y: (parent.height - self.height) / 2; name: "activity"; ink: Theme.accent; }
                        }
                        Text { text: "Live Connections"; color: Theme.text; font-size: 16px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 0; }
                        Rectangle {
                            width: max(25px, count-label.preferred-width + 12px);
                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                height: 22px;
                                border-radius: Theme.radius-small;
                                background: Theme.accent-soft;
                                count-label := Text { text: "" + root.filtered-event-count; color: Theme.accent; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        if root.filtered-event-count != root.connection-event-count: Text {
                            text: root.filtered-event-count + " of " + root.connection-event-count + " shown";
                            color: Theme.secondary;
                            font-size: 11px;
                            vertical-alignment: center;
                            horizontal-stretch: 0;
                        }
                        if !root.connection-filters-default: Rectangle {
                            width: reset.min-width;
                            reset := ActionButton { y: (parent.height - self.height) / 2; label: "Reset filters"; height: 30px; clicked => { root.reset-connection-filters(); } }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    Rectangle {
                        height: 32px;
                        background: Theme.field;
                        JournalLine {
                            x: 0px;
                            width: parent.width - Theme.scroll-gutter;
                            heading: true;
                            application: "APPLICATION";
                            destination: "TARGET";
                            route: "ROUTE";
                            status: "STATUS";
                            sent: "↑ SOCKS SENT";
                            received: "↓ SOCKS RECV";
                        }
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    connection-list := ScrollView {
                        vertical-stretch: 1;
                        horizontal-scrollbar-policy: always-off;
                        content-width: self.visible-width;
                        content-height: max(self.visible-height, connection-content.preferred-height);
                        connection-content := VerticalLayout {
                            padding-right: Theme.scroll-gutter;
                            padding-bottom: 8px;
                            alignment: start;
                            if root.process-summaries.length == 0: Rectangle {
                                height: 66px;
                                Text {
                                    text: root.connection-event-count == 0 ? "No connections observed yet." : "No connections match these filters.";
                                    color: Theme.muted;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            for process[index] in root.process-summaries: JournalGroup {
                                process: process;
                                stripe: mod(index, 2) == 1;
                                toggled => { root.expand-process(process.name); }
                            }
                        }
                    }
                }
            }
            if !root.only-active: Text {
                text: "History keeps up to 256 connections completed since a finished status was selected.";
                color: Theme.muted;
                font-size: 11px;
                wrap: word-wrap;
            }
            if root.connection-omitted > 0: Text {
                text: "Tracking limit: 4,096 concurrent connections. Omitted: " + root.connection-omitted;
                color: Theme.warning;
                font-size: 11px;
                wrap: word-wrap;
            }
        }
    }
}
