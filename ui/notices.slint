import { ScrollView, Spinner } from "std-widgets.slint";
import { ActionButton, Theme, UiIcon } from "common.slint";

export struct NoticeEntry {
    hidden: bool,
    icon: string,
    title: string,
    message: string,
    ink: color,
    action-label: string,
    action-enabled: bool,
    secondary-label: string,
    dismissible: bool,
}

export global NoticeBackdrop {
    in-out property <int> transparency: 48;
    in-out property <int> blur: 9;
    in-out property <bool> capturing;
    out property <int> revision;
    public function invalidate() { self.revision += 1; }
    callback sample(length, length, length, length, length) -> image;
}

struct BackdropRegion { x: length, y: length, width: length, height: length, dark: bool, revision: int, blur: int }

component NoticeSurface inherits Rectangle {
    in property <bool> active: true;
    in property <bool> warning;
    // Sample at the resting position throughout the card's entrance animation.
    in property <length> offset-y;
    private property <bool> needs-blur: NoticeBackdrop.blur > 0 && NoticeBackdrop.transparency > 0;
    private property <bool> prepared;
    // A skipped capture in the tray is only a fallback for that revision. On
    // restore, prepare the missing image before drawing the notification.
    private property <bool> has-backdrop: blurred.source.width > 0;
    out property <bool> ready: !root.needs-blur || (root.prepared
        && (root.has-backdrop || root.sampled.revision == NoticeBackdrop.revision));
    private property <BackdropRegion> region: {
        x: root.absolute-position.x, y: root.absolute-position.y - root.offset-y,
        width: root.width, height: root.height, dark: Theme.dark,
        revision: NoticeBackdrop.revision, blur: NoticeBackdrop.blur
    };
    private property <BackdropRegion> sampled;
    changed active => { if !root.active { root.prepared = false; } }
    private property <bool> keep-image: root.visible && root.needs-blur;
    changed keep-image => {
        if !root.keep-image {
            root.prepared = false;
            blurred.source = @image-url("");
        }
    }
    // Capture outside painting, as soon as layout has supplied the entry region.
    // Later background changes can share a debounced capture of the visible card.
    Timer {
        running: root.active && root.keep-image && root.width > 0px && root.height > 0px
            && (!root.prepared || root.sampled != root.region);
        interval: root.prepared && root.has-backdrop ? 70ms : 0ms;
        triggered => {
            root.sampled = root.region;
            blurred.source = NoticeBackdrop.sample(root.sampled.x, root.sampled.y,
                root.sampled.width, root.sampled.height, Theme.radius-medium);
            // A backend without snapshot support still displays the translucent tint.
            root.prepared = true;
        }
    }
    accessible-role: none;
    // The software backend has no blurred box shadows. Two faint outer
    // edges lift the panel without tinting the sampled area underneath.
    Rectangle {
        x: -3px; y: -1px; width: root.width + 6px; height: root.height + 5px;
        border-radius: Theme.radius-medium + 3px; border-width: 2px;
        border-color: Theme.dark ? #00000020 : #0f172a08;
    }
    Rectangle {
        x: -1px; y: 0px; width: root.width + 2px; height: root.height + 2px;
        border-radius: Theme.radius-medium + 1px; border-width: 1px;
        border-color: Theme.dark ? #00000055 : #0f172a10;
    }
    blurred := Image {
        width: parent.width;
        height: parent.height;
        visible: root.needs-blur;
        image-fit: fill;
    }
    Rectangle {
        border-radius: Theme.radius-medium;
        border-width: 1px;
        border-color: root.warning ? Theme.warning-border : Theme.strong-border;
        background: Theme.notice-surface.with-alpha(1.0 - clamp(NoticeBackdrop.transparency, 0, 100) / 100.0);
    }
    if root.warning: Rectangle { border-radius: Theme.radius-medium; background: Theme.warning-surface; }
}

component NoticeIcon inherits Rectangle {
    in property <string> icon;
    in property <color> ink;
    in property <bool> working;
    width: 34px; height: 34px; border-radius: 8px;
    border-width: 1px; border-color: Theme.notice-divider;
    background: Theme.dark ? #ffffff0f : Theme.subtle;
    if root.working && !Theme.reduce-motion: Spinner {
        indeterminate: true; width: 18px; height: 18px; accessible-role: none;
    }
    if !root.working || Theme.reduce-motion: UiIcon {
        name: root.icon; ink: root.ink == Theme.accent ? Theme.accent-text : root.ink;
        width: 16px; height: 16px;
    }
}

component NoticeClose inherits ActionButton {
    icon: "close"; icon-only: true; quiet: true;
    min-width: 26px; max-width: 26px; height: 26px;
    border-radius: 6px; icon-ink: Theme.muted;
}

export component InlineNotice inherits Rectangle {
    in property <string> message;
    in property <bool> error;
    in property <length> height-limit;
    private property <length> natural-height: max(40px, message-text.preferred-height + 16px);
    min-width: 0px;
    height: root.height-limit > 0px ? min(root.height-limit, root.natural-height) : root.natural-height;
    vertical-stretch: 0;
    background: root.error ? Theme.danger-soft : Theme.warning-surface;
    border-radius: Theme.radius-small; border-width: 1px;
    border-color: root.error ? Theme.danger.with-alpha(0.24) : Theme.warning-border;
    UiIcon {
        name: "info"; x: 12px; y: (parent.height - self.height) / 2;
        width: 16px; height: 16px; ink: root.error ? Theme.danger : Theme.warning-icon;
    }
    message-text := Text {
        x: 36px; y: 8px; width: max(0px, parent.width - self.x - 12px); height: parent.height - 16px;
        text: root.message; color: root.error ? Theme.danger : Theme.warning-detail;
        font-size: 12px; wrap: word-wrap; overflow: elide; vertical-alignment: center;
        accessible-live-region: polite;
    }
}

component NoticeDot inherits Rectangle {
    in property <color> ink: Theme.accent;
    in property <bool> pulse;
    width: 14px;
    height: 14px;
    border-radius: self.width / 2;
    background: root.ink.with-alpha(root.pulse ? 0.6 : 0.21);
    animate background { duration: Theme.reduce-motion ? 0ms : 180ms; easing: ease-out; }
    Rectangle {
        width: 7px;
        height: 7px;
        border-radius: self.width / 2;
        background: root.ink;
    }
}

export component NoticeShelf inherits Rectangle {
    in property <length> host-width;
    in property <length> host-height;
    in property <length> bottom-offset: 24px;
    out property <length> clearance: self.height > 0px ? max(72px, self.height) : 0px;
    width: 500px;
    height: stack.preferred-height;
    x: root.host-width - self.width - 24px;
    y: root.host-height - self.height - root.bottom-offset;
    opacity: NoticeBackdrop.capturing ? 0 : 1;

    stack := VerticalLayout {
        spacing: 0px;
        @children
    }
}

export component FloatingNotice inherits Rectangle {
    in property <bool> in-scope;
    in property <bool> active;
    in property <string> title;
    in property <string> message;
    in property <string> icon;
    in property <color> ink: Theme.accent;
    in property <bool> working;
    in property <bool> warning;
    in property <string> action-label;
    in property <bool> action-enabled: true;
    in property <string> secondary-label;
    in property <bool> can-hide: true;
    in property <string> list-title: root.title;
    in property <string> list-action-label: root.action-label;
    in property <bool> list-dismissible;
    in property <int> change-revision;
    in-out property <bool> collapsed;
    out property <bool> pulsing;
    out property <NoticeEntry> entry: {
        hidden: root.active && root.collapsed,
        icon: root.icon,
        title: root.list-title,
        message: root.message,
        ink: root.ink,
        action-label: root.list-action-label,
        action-enabled: root.action-enabled && !root.working,
        secondary-label: root.secondary-label,
        dismissible: root.list-dismissible,
    };
    callback action;
    callback secondary-action;
    callback hidden;

    private property <bool> show-card: root.in-scope && root.active && !root.collapsed;
    private property <length> card-offset: (root.show-card && card.ready) || Theme.reduce-motion ? 0px : 12px;
    animate card-offset { duration: Theme.reduce-motion ? 0ms : 200ms; easing: ease-out; }
    height: root.show-card ? card.height + 8px : 0px;

    changed active => {
        if !root.active {
            root.collapsed = false;
            root.pulsing = false;
        }
    }
    changed change-revision => {
        if root.entry.hidden && !root.pulsing {
            root.pulsing = true;
        }
    }
    Timer {
        running: root.pulsing;
        interval: 220ms;
        triggered => { root.pulsing = false; }
    }

    function hide-card() {
        root.collapsed = true;
        root.hidden();
    }

    card := NoticeSurface {
        active: root.show-card;
        warning: root.warning;
        offset-y: root.card-offset;
        width: parent.width;
        height: max(60px, card-layout.preferred-height);
        x: 0px;
        y: parent.height - self.height + root.card-offset;
        private property <float> reveal: root.show-card && self.ready ? 1 : 0;
        animate reveal { duration: Theme.reduce-motion ? 0ms : 200ms; easing: ease-out; }
        opacity: root.show-card && !self.ready ? 0 : self.reveal;
        visible: root.in-scope && (root.show-card || self.opacity > 0);
        accessible-role: groupbox;
        accessible-label: root.title == "" ? root.message : root.title + (root.message == "" ? "" : ". " + root.message);
        accessible-live-region: polite;

        TouchArea { enabled: root.show-card; }
        card-keys := FocusScope {
            width: parent.width;
            height: parent.height;
            enabled: root.show-card;
            // Only children take focus. Unhandled keys from those children bubble here.
            forward-focus: hide;
            key-pressed(event) => {
                if event.text == Key.Escape && root.can-hide {
                    root.hide-card();
                    return accept;
                }
                return reject;
            }
            card-layout := HorizontalLayout {
                padding-left: 14px; padding-right: 14px; padding-top: 12px; padding-bottom: 12px;
                spacing: 12px;
                cross-axis-alignment: center;
                if root.icon != "": NoticeIcon {
                    icon: root.icon; ink: root.ink; working: root.working && root.show-card;
                }
                VerticalLayout {
                    min-width: 0px;
                    horizontal-stretch: 1;
                    spacing: 2px;
                    if root.title != "": Text {
                        text: root.title;
                        color: Theme.text;
                        font-size: 13px;
                        font-weight: 600;
                        wrap: word-wrap;
                        accessible-role: none;
                    }
                    if root.message != "": Text {
                        text: root.message;
                        color: root.warning ? Theme.warning-detail : root.title == "" ? Theme.text : Theme.secondary;
                        font-size: root.title == "" ? 13px : 12px;
                        wrap: word-wrap;
                        max-height: 64px;
                        overflow: elide;
                        accessible-role: none;
                    }
                }
                if root.secondary-label != "": ActionButton {
                    label: root.secondary-label;
                    height: 30px; label-size: 12px; border-radius: 7px;
                    enabled: root.show-card;
                    clicked => { root.secondary-action(); }
                }
                if root.action-label != "": ActionButton {
                    label: root.action-label;
                    primary: !root.warning;
                    primary-fill: Theme.accent;
                    label-size: 12px; label-weight: 600;
                    height: 30px; border-radius: 7px;
                    enabled: root.show-card && root.action-enabled && !root.working;
                    outline: root.warning ? Theme.warning-border : Theme.strong-border;
                    clicked => { root.action(); }
                }
                hide := NoticeClose {
                    visible: root.can-hide;
                    enabled: root.show-card && root.can-hide;
                    accessible-label: "Hide in notifications";
                    clicked => { root.hide-card(); }
                }
            }
        }
    }

}

component NoticeListRow inherits Rectangle {
    in property <NoticeEntry> entry;
    callback action(bool);
    height: root.entry.hidden ? row.preferred-height : 0px;
    visible: root.entry.hidden;
    border-radius: 8px;
    background: row-touch.has-hover ? Theme.hover : transparent;
    row-touch := TouchArea { }
    row := HorizontalLayout {
        width: root.width;
        padding: 10px;
        spacing: 12px;
        cross-axis-alignment: start;
        NoticeIcon { icon: root.entry.icon; ink: root.entry.ink; }
        VerticalLayout {
            min-width: 0px;
            horizontal-stretch: 1;
            spacing: 2px;
            notice-title := Text {
                text: root.entry.title;
                color: Theme.text;
                font-weight: 500;
                font-size: 13px;
                min-width: 0px;
                wrap: word-wrap;
            }
            if root.entry.message != "": Text {
                text: root.entry.message;
                color: Theme.secondary;
                font-size: 12px;
                min-width: 0px;
                wrap: word-wrap;
                overflow: elide;
            }
            if (!root.entry.dismissible && root.entry.action-label != "") || root.entry.secondary-label != "": HorizontalLayout {
                alignment: start; spacing: 8px; padding-top: 8px;
                if !root.entry.dismissible && root.entry.action-label != "": ActionButton {
                    enabled: root.entry.action-enabled;
                    label: root.entry.action-label;
                    accessible-label: self.label + " · " + root.entry.title;
                    label-size: 12px; height: 28px; border-radius: 7px;
                    fill: Theme.hover; outline: Theme.strong-border;
                    clicked => { root.action(false); }
                }
                if root.entry.secondary-label != "": ActionButton {
                    label: root.entry.secondary-label;
                    accessible-label: self.label + " · " + root.entry.title;
                    label-size: 12px; height: 28px; quiet: true; ink: Theme.secondary;
                    clicked => { root.action(true); }
                }
            }
        }
        if root.entry.dismissible: NoticeClose {
            accessible-label: root.entry.action-label + " · " + root.entry.title;
            enabled: root.entry.action-enabled;
            clicked => { root.action(false); }
        }
    }
}

export component NoticeCenter inherits ActionButton {
    in property <bool> has-hidden;
    in property <bool> pulse;
    in property <color> indicator-ink: Theme.accent;
    out property <bool> opened;

    label: "Notifications";
    icon: "bell";
    icon-only: true;
    width: 36px;
    height: 36px;
    quiet: true;
    icon-ink: root.has-hidden ? (root.indicator-ink == Theme.accent ? Theme.accent-text : root.indicator-ink) : Theme.secondary;
    accessible-description: root.has-hidden ? "Hidden notifications available" : "No hidden notifications";
    accessible-expanded: root.opened;
    clicked => { if root.opened { root.close(); } else { root.opened = true; } }
    public function close() {
        if root.opened {
            root.opened = false;
            root.focus();
        }
    }

    if root.has-hidden: NoticeDot {
        width: 12px;
        height: 12px;
        x: parent.width - self.width - 1px;
        y: 1px;
        ink: root.indicator-ink;
        pulse: root.pulse;
    }
}

export component NoticePanel inherits NoticeSurface {
    in property <[NoticeEntry]> app-entries;
    in property <[NoticeEntry]> module-entries;
    in property <bool> has-hidden;
    in property <bool> can-clear-all;
    callback entry-action(bool, int, bool);
    callback clear-all;
    callback close;
    width: 420px;
    height: min(414px, 53px + entries.preferred-height);
    opacity: NoticeBackdrop.capturing || !root.ready ? 0 : 1;
    accessible-role: groupbox;
    accessible-label: "Hidden notifications";
    init => { panel-keys.focus(); }

    TouchArea {}
    panel-keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape { root.close(); return accept; }
            return reject;
        }
        VerticalLayout {
            padding: 1px;
            HorizontalLayout {
                height: 50px;
                padding-left: 14px; padding-right: 14px; spacing: 4px;
                cross-axis-alignment: center;
                Text {
                    text: "Notifications";
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 600;
                    horizontal-stretch: 1;
                }
                if root.can-clear-all: ActionButton {
                    label: "Clear all"; quiet: true; label-size: 12px; ink: Theme.secondary;
                    height: 26px; border-radius: 6px;
                    clicked => { panel-keys.focus(); root.clear-all(); }
                }
                close-button := NoticeClose {
                    label: "Close notifications";
                    clicked => { root.close(); }
                }
            }
            Rectangle { height: 1px; background: Theme.notice-divider; }
            notice-scroll := ScrollView {
                min-height: 0px;
                horizontal-scrollbar-policy: always-off;
                content-width: self.visible-width;
                content-height: entries.preferred-height;
                entries := VerticalLayout {
                    width: notice-scroll.visible-width;
                    padding: 8px;
                    alignment: start;
                    spacing: 0px;
                    if !root.has-hidden: Text {
                        height: 60px;
                        text: "No hidden notifications";
                        color: Theme.muted; font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    for entry[index] in root.app-entries: NoticeListRow {
                        entry: entry;
                        action(secondary) => { panel-keys.focus(); root.entry-action(false, index, secondary); }
                    }
                    for entry[index] in root.module-entries: NoticeListRow {
                        entry: entry;
                        action(secondary) => { panel-keys.focus(); root.entry-action(true, index, secondary); }
                    }
                }
            }
        }
    }
}
