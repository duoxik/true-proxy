import { DashboardView } from "dashboard.slint";
import { PageHeader, FormCard, SurfaceCard, PanelToolbar, TableHeading, EmptyState, IconLicenseButton, DialogHeader, DialogActions } from "common.slint";
import { ScrollView, Palette, TextEdit } from "std-widgets.slint";
import { JsonEditor, JsonLine } from "json-editor.slint";
export { JsonLine }
import { Theme, UiIcon, ActionButton, RuleSwitch, Field, ThemedCheckBox, ThemedComboBox, ProxyRow, RuleRow, LogRow, ProcessChoice, ProcessSummary, ConnectionFilterOption } from "common.slint";
export { ProxyRow, RuleRow, LogRow, ProcessChoice, ProcessSummary, ConnectionFilterOption }
import { ConnectionsView, ConnectionMonitor } from "connections.slint";
export { ConnectionMonitor }
import { LogsView, TechnicalLogs } from "logs.slint";
export { TechnicalLogs }
import { XrayModule, XrayModuleCard, HpwnrModuleCard, XrayView, XrayProfileRow, XraySubscriptionGroup, XrayHostRow, XrayConnectionRow } from "xray.slint";
export { XrayModule, XrayProfileRow, XraySubscriptionGroup, XrayHostRow, XrayConnectionRow }

component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> selected;
    callback clicked;
    height: 35px;
    border-radius: Theme.radius-small;
    background: root.selected ? Theme.accent-soft : touch.has-hover ? Theme.surface-hover : transparent;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 11px;
        Rectangle { width: 18px;
            UiIcon { name: root.icon; ink: root.selected ? Theme.accent : Theme.text; y: (parent.height - self.height) / 2; }
        }
        Text {
            text: root.label;
            font-size: 13px;
            font-weight: root.selected ? 600 : 400;
            color: root.selected ? Theme.accent : Theme.text;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { focus.focus(); root.clicked(); }
    }
    focus := FocusScope {
        width: 0px;
        key-pressed(event) => { if event.text == Key.Space || event.text == Key.Return { root.clicked(); return accept; } return reject; }
    }
    forward-focus: focus;
    accessible-role: button; accessible-label: root.label; accessible-action-default => { root.clicked(); }
}

struct SidebarLink { label: string, icon: string, target: int }

component SidebarGroup inherits VerticalLayout {
    in property <string> title;
    in property <[SidebarLink]> links;
    in property <int> selection: -1;
    in property <string> accessibility-prefix;
    private property <bool> expanded: true;
    callback open(int);
    spacing: 2px;

    Rectangle {
        height: 24px;
        border-radius: Theme.radius-small;
        background: touch.has-hover ? Theme.surface-hover : transparent;
        accessible-role: button;
        accessible-label: root.title;
        accessible-expanded: root.expanded;
        accessible-action-default => { root.expanded = !root.expanded; }
        forward-focus: focus;

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 10px;
            Text {
                text: root.title;
                color: Theme.muted;
                font-size: 11px;
                font-weight: 600;
                vertical-alignment: center;
                accessible-role: none;
            }
            Rectangle {
                width: 16px;
                UiIcon {
                    name: root.expanded ? "chevron-down" : "chevron-right";
                    width: 16px;
                    height: 16px;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { focus.focus(); root.expanded = !root.expanded; }
        }
        focus := FocusScope {
            width: 0px;
            key-pressed(event) => {
                if event.text == Key.Space || event.text == Key.Return {
                    root.expanded = !root.expanded;
                    return accept;
                }
                return reject;
            }
        }
    }

    for link in (root.expanded ? root.links : []): NavItem {
        height: 32px;
        label: link.label;
        icon: link.icon;
        accessible-label: root.accessibility-prefix + link.label;
        selected: root.selection == link.target;
        clicked => { root.open(link.target); }
    }
}

component Disclosure inherits Rectangle {
    in property <bool> expanded;
    in property <string> label;
    in property <int> count;
    callback clicked;
    height: 40px; border-radius: Theme.radius-small;
    border-width: 1px;
    border-color: focus.has-focus ? Theme.accent : transparent;
    background: touch.has-hover ? Theme.surface-hover : Theme.field;
    HorizontalLayout { padding-left: 7px; padding-right: 10px; spacing: 10px;
        Rectangle { width: 14px; Path { y: (parent.height - 12px) / 2; width: 12px; height: 12px; viewbox-width: 12; viewbox-height: 12; stroke: Theme.secondary; stroke-width: 1.5px; commands: root.expanded ? "M2 4 L6 8 L10 4" : "M4 2 L8 6 L4 10"; } }
        Text { text: root.label; color: Theme.text; font-size: 12px; font-weight: 600; vertical-alignment: center; }
        if root.count > 0: Text { text: root.count + " conditions"; color: Theme.muted; font-size: 10px; horizontal-alignment: right; vertical-alignment: center; }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
    focus := FocusScope { width: 0px; key-pressed(event) => { if event.text == Key.Space || event.text == Key.Return { root.clicked(); return accept; } return reject; } }
    forward-focus: focus;
    accessible-role: button; accessible-label: root.label; accessible-expanded: root.expanded;
    accessible-action-default => { root.clicked(); }
}

component RouteChoice inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> submenu: false;
    callback clicked;
    callback hovered;
    height: 38px; border-radius: Theme.radius-small;
    background: root.enabled && touch.has-hover ? Theme.surface-hover : transparent;
    border-width: focus.has-focus ? 1px : 0px; border-color: Theme.accent;
    accessible-role: button; accessible-label: root.label; accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: focus;
    HorizontalLayout { padding-left: 10px; padding-right: 10px; spacing: 8px;
        Text { text: root.label; color: root.enabled ? Theme.text : Theme.muted; font-size: 12px; overflow: elide; vertical-alignment: center; accessible-role: none; }
        if root.submenu: Text { text: "›"; color: root.enabled ? Theme.secondary : Theme.muted; width: 14px; horizontal-alignment: right; vertical-alignment: center; accessible-role: none; }
    }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer;
        clicked => { focus.focus(); root.clicked(); }
        changed has-hover => { if self.has-hover { root.hovered(); } }
    }
    focus := FocusScope { width: 0px; enabled: root.enabled;
        key-pressed(event) => { if event.text == Key.Space || event.text == Key.Return || (root.submenu && event.text == Key.RightArrow) { root.clicked(); return accept; } return reject; }
    }
}

component FallbackSelector inherits ActionButton {
    in property <[ProxyRow]> proxies;
    property <bool> proxy-open: false;
    callback selected(int, string);
    label: "Edit fallback route";
    icon: "more";
    icon-only: true;
    quiet: true;
    accessible-expanded: menu.is-open;
    clicked => { root.proxy-open = false; menu.show(); }
    function choose-route(kind: int, proxy-id: string) { if root.enabled { root.selected(kind, proxy-id); } menu.close(); }
    menu := PopupWindow { x: root.width - self.width; y: root.absolute-position.y >= self.height + 6px ? -self.height - 6px : root.height + 6px; width: 260px; height: max(126px, min(root.proxies.length, 7) * 38px + 12px);
        close-policy: close-on-click-outside;
        forward-focus: menu-focus;
        menu-focus := FocusScope {
            key-pressed(event) => { if event.text == Key.Escape { menu.close(); return accept; } if event.text == Key.LeftArrow { root.proxy-open = false; return accept; } return reject; }
            TouchArea { clicked => { menu.close(); } }
            Rectangle { x: 0px; y: menu.height - self.height; width: (menu.width - 6px) / 2; height: 126px; border-radius: Theme.radius-medium; border-width: 1px; border-color: Theme.border; background: Theme.sidebar;
                VerticalLayout { padding: 6px; spacing: 0px; alignment: start;
                    RouteChoice { label: "Direct"; accessible-label: "Route: Direct"; enabled: root.enabled; hovered => { root.proxy-open = false; } clicked => { root.choose-route(0, ""); } }
                    RouteChoice { label: "Block"; accessible-label: "Route: Block"; enabled: root.enabled; hovered => { root.proxy-open = false; } clicked => { root.choose-route(1, ""); } }
                    RouteChoice { label: "Proxy"; accessible-label: "Route: Proxy"; submenu: true; enabled: root.enabled && root.proxies.length > 0; hovered => { root.proxy-open = true; } clicked => { root.proxy-open = true; } }
                }
            }
            if root.proxy-open && root.proxies.length > 0: Rectangle { x: (menu.width + 6px) / 2; y: menu.height - self.height; width: (menu.width - 6px) / 2; height: min(root.proxies.length, 7) * 38px + 12px; border-radius: Theme.radius-medium; border-width: 1px; border-color: Theme.border; background: Theme.sidebar;
                ScrollView { horizontal-scrollbar-policy: always-off; content-width: self.visible-width; content-height: proxy-menu-content.preferred-height;
                    proxy-menu-content := VerticalLayout { padding: 6px; spacing: 0px; alignment: start;
                        for proxy in root.proxies: RouteChoice { label: proxy.name; accessible-label: "SOCKS proxy: " + proxy.name; enabled: root.enabled; clicked => { root.choose-route(2, proxy.id); } }
                    }
                }
            }
        }
    }
}

component ListEditor inherits VerticalLayout {
    in property <string> title;
    in property <string> placeholder;
    in property <bool> applications: false;
    in property <string> add-label: "Add " + root.title;
    in property <[string]> values;
    callback add-empty;
    callback edit(int, string);
    callback remove(int);
    callback choose(int);
    spacing: 7px;
    alignment: start;
    vertical-stretch: 0;
    HorizontalLayout { height: 32px;
        Text { text: root.title + (root.values.length > 0 ? " · " + root.values.length : ""); color: Theme.text; font-size: 12px; font-weight: 600; vertical-alignment: center; min-width: 0px; overflow: elide; }
        Rectangle { width: add-button.min-width; height: 32px;
            add-button := ActionButton { label: "Add"; icon: "plus"; accessible-label: root.applications ? "Add application" : root.add-label; height: 32px; clicked => { if root.applications { add-menu.show(); } else { root.add-empty(); } } }
            add-menu := PopupWindow { x: parent.width - self.width; y: parent.height + 5px; width: 250px; height: 126px;
                close-policy: close-on-click-outside;
                Rectangle { background: Theme.sidebar; border-radius: Theme.radius-medium; border-width: 1px; border-color: Theme.border;
                    VerticalLayout { padding: 6px; spacing: 0px;
                        for label[index] in ["Manual entry", "Running processes", "Executable path"]: RouteChoice {
                            label: label;
                            clicked => { root.choose(index); add-menu.close(); }
                        }
                    }
                }
            }
        }
    }
    for value[index] in root.values: HorizontalLayout { height: 34px; spacing: 8px;
        value-field := Rectangle { horizontal-stretch: 1; border-radius: Theme.radius-small; background: Theme.field; border-width: 1px; border-color: value-input.has-focus ? Theme.accent : Theme.border;
            if value == "": Text { x: 12px; width: parent.width - 24px; text: root.placeholder; color: Theme.muted; font-size: 12px; overflow: elide; vertical-alignment: center; accessible-role: none; }
            value-input := TextInput { x: 12px; width: parent.width - 24px; height: parent.height; text: value; color: Theme.text; font-size: 12px; single-line: true; vertical-alignment: center;
                accessible-label: root.title + " · row " + (index + 1);
                edited => { root.edit(index, self.text); }
            }
        }
        ActionButton { label: "×"; height: 34px; accessible-label: value == "" ? "Remove row " + (index + 1) + " · " + root.title : "Remove " + value; clicked => { root.remove(index); } }
    }
}

component CountPill inherits Rectangle {
    in property <string> value;
    width: 42px;
    height: 24px;
    border-radius: 12px;
    background: Theme.accent-soft;
    Text { text: root.value; color: Theme.accent; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
}

component RouteBadge inherits Rectangle {
    in property <string> value;
    in property <string> icon;
    in property <bool> compact;
    in property <bool> neutral;
    private property <color> ink: root.neutral ? Theme.text : root.value == "Direct" ? Theme.success : root.value == "Block" ? Theme.danger : Theme.accent;
    width: root.compact ? min(210px, badge-text.preferred-width + 16px) : 132px;
    height: 26px;
    border-radius: root.neutral ? self.height / 2 : Theme.radius-small;
    background: root.neutral ? Theme.neutral-badge : root.value == "Direct" ? Theme.success-soft : root.value == "Block" ? Theme.danger-soft : Theme.accent-soft;
    if root.icon != "": UiIcon {
        name: root.icon; ink: root.ink; x: root.neutral ? 11px : 7px; y: (parent.height - self.height) / 2;
        width: 15px; height: 15px;
    }
    badge-text := Text {
        x: root.icon == "" ? 8px : root.neutral ? 34px : 24px; width: parent.width - self.x - 8px;
        text: root.value;
        color: root.ink;
        font-size: root.neutral ? 12px : 11px;
        font-weight: root.neutral ? 400 : 600;
        overflow: elide;
        horizontal-alignment: root.neutral ? left : center;
        vertical-alignment: center;
    }
}

component RuleLine inherits Rectangle {
    in property <int> priority;
    in property <string> name;
    in property <string> route;
    in property <bool> checked: true;
    in property <bool> locked;
    in property <bool> busy;
    in property <bool> last;
    in property <bool> draggable;
    in property <bool> floating;
    in property <bool> hidden-for-drag;
    in property <length> slide;
    callback toggled;
    callback drag-started(length);
    callback drag-moved(length);
    callback drag-ended(length, bool);
    height: 58px;

    Rectangle {
        y: root.slide;
        width: parent.width;
        height: root.height;
        visible: !root.hidden-for-drag;
        background: root.floating ? Theme.surface-hover : transparent;
        HorizontalLayout {
            padding-left: 19px;
            padding-right: 15px;
            spacing: 16px;
            grip := Rectangle {
                width: 35px;
                UiIcon {
                    name: "grip";
                    ink: root.floating || drag.has-hover ? Theme.text : Theme.muted;
                    opacity: root.locked ? 0.5 : 1;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
            Rectangle {
                width: 50px;
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 40px;
                    height: 28px;
                    border-radius: 8px;
                    background: Theme.neutral-badge;
                    Text {
                        text: (root.priority < 10 ? "0" : "") + root.priority;
                        color: Theme.text;
                        font-size: 13px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            HorizontalLayout {
                min-width: 0px;
                horizontal-stretch: 1;
                spacing: 8px;
                alignment: start;
                Text {
                    text: root.name;
                    accessible-label: root.priority + ". " + root.name;
                    color: root.checked ? Theme.text : Theme.muted;
                    font-size: 15px;
                    font-weight: 600;
                    overflow: elide;
                    min-width: 0px;
                    vertical-alignment: center;
                }
                if root.locked: Rectangle {
                    width: 17px;
                    UiIcon { name: "lock"; ink: Theme.muted; width: 16px; height: 16px; y: (parent.height - self.height) / 2; }
                }
            }
            Rectangle {
                width: 176px;
                RouteBadge {
                    value: root.route;
                    icon: root.route == "Direct" ? "direct" : root.route == "Block" ? "block" : "server";
                    neutral: true;
                    width: 140px;
                    height: 30px;
                    y: (parent.height - self.height) / 2;
                }
            }
            RuleSwitch {
                label: "Rule " + root.name;
                width: 54px;
                height: root.height;
                track-width: 50px;
                checked: root.checked;
                fixed: root.locked;
                enabled: !root.locked && !root.busy;
                toggled => { root.toggled(); }
            }
            Rectangle {
                width: 36px;
                height: root.height;
                VerticalLayout {
                    alignment: center;
                    @children
                }
            }
        }
        if !root.last: Rectangle { height: 1px; y: parent.height - self.height; background: Theme.border; }
    }
    drag := TouchArea {
        x: grip.x;
        width: grip.width;
        enabled: root.draggable && !root.busy;
        mouse-cursor: self.pressed ? grabbing : grab;
        moved => {
            if self.pressed { root.drag-moved(self.absolute-position.y + self.mouse-y); }
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.cancel {
                root.drag-ended(0px, false);
            } else if event.button == PointerEventButton.left {
                let pointer-y = self.absolute-position.y + self.mouse-y;
                if event.kind == PointerEventKind.down { root.drag-started(pointer-y); }
                if event.kind == PointerEventKind.up { root.drag-ended(pointer-y, true); }
            }
        }
    }
}

component RuleActions inherits ActionButton {
    in property <string> rule-name;
    in property <bool> can-move-up;
    in property <bool> can-move-down;
    in property <length> window-height;
    callback edit;
    callback remove;
    callback move(int);

    label: "Actions for rule " + root.rule-name;
    icon: "more";
    icon-only: true;
    quiet: true;
    accessible-expanded: menu.is-open;
    clicked => { menu.show(); }

    menu := PopupWindow {
        width: 156px;
        height: 148px;
        x: root.width - self.width;
        y: root.absolute-position.y + root.height + self.height + 4px <= root.window-height ? root.height + 4px : -self.height - 4px;
        close-policy: close-on-click-outside;
        forward-focus: menu-focus;
        menu-focus := FocusScope {
            key-pressed(event) => {
                if event.text == Key.Escape { menu.close(); return accept; }
                return reject;
            }
            Rectangle {
                background: Theme.surface;
                border-radius: Theme.radius-small;
                border-color: Theme.border;
                border-width: 1px;
                VerticalLayout {
                    padding: 6px;
                    RouteChoice { height: 34px; label: "Edit rule"; enabled: root.enabled; clicked => { menu.close(); root.edit(); } }
                    RouteChoice { height: 34px; label: "Move rule up"; enabled: root.enabled && root.can-move-up; clicked => { menu.close(); root.move(-1); } }
                    RouteChoice { height: 34px; label: "Move rule down"; enabled: root.enabled && root.can-move-down; clicked => { menu.close(); root.move(1); } }
                    RouteChoice { height: 34px; label: "Delete rule"; enabled: root.enabled; clicked => { menu.close(); root.remove(); } }
                }
            }
        }
    }
}

component CountryFlag inherits Rectangle {
    in property <int> index;
    width: 16px;
    Image {
        width: parent.width;
        height: 10px;
        y: (parent.height - self.height) / 2;
        source: @image-url("../assets/country-flags.png");
        source-clip-x: Math.mod(root.index - 1, 16) * 32;
        source-clip-y: Math.floor((root.index - 1) / 16) * 20;
        source-clip-width: 32;
        source-clip-height: 20;
    }
}

component ProxySelectionCheck inherits Rectangle {
    in property <string> label;
    in property <bool> checked;
    in property <bool> mixed;
    in property <bool> enabled: true;
    callback toggled(bool);
    width: 22px;
    height: 26px;
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.toggled(!root.checked); } }
    forward-focus: focus;

    Rectangle {
        x: 2px;
        y: 4px;
        width: 18px;
        height: 18px;
        border-radius: 5px;
        border-width: 1px;
        border-color: focus.has-focus ? Theme.accent-hover : root.checked || root.mixed ? Theme.primary : Theme.border;
        background: root.checked || root.mixed ? Theme.primary : Theme.surface;
        if root.checked: UiIcon {
            name: "check"; ink: Theme.primary-text;
            x: 2px; y: 2px; width: 14px; height: 14px;
        }
        if root.mixed: Rectangle {
            x: 4px; y: 8px; width: 10px; height: 2px;
            border-radius: 1px; background: Theme.primary-text;
        }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { focus.focus(); root.toggled(!root.checked); }
    }
    focus := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.toggled(!root.checked);
                return accept;
            }
            return reject;
        }
    }
}

component ProxyTableColumns inherits HorizontalLayout {
    in property <bool> heading;
    in property <ProxyRow> proxy;
    in property <bool> selected;
    in property <bool> partially-selected;
    in property <bool> selection-enabled: true;
    in property <bool> test-enabled: true;
    private property <bool> measured: root.proxy.health == 2 && root.proxy.status != "";
    private property <bool> failed: root.proxy.health == 3;
    private property <color> latency-ink: root.failed ? Theme.danger : root.measured ? Theme.success : Theme.muted;
    callback select(bool);
    callback test-proxy;
    callback edit-proxy;
    callback delete-proxy;
    padding-left: 16px;
    padding-right: 16px;
    spacing: 10px;

    Rectangle {
        width: 22px;
        ProxySelectionCheck {
            y: (parent.height - self.height) / 2;
            label: root.heading ? "Select all proxies" : "Select proxy " + root.proxy.name;
            checked: root.selected;
            mixed: root.partially-selected;
            enabled: root.selection-enabled;
            toggled(value) => { root.select(value); }
        }
    }
    Text {
        text: root.heading ? "NAME" : root.proxy.name;
        color: root.heading ? Theme.secondary : Theme.text;
        font-size: root.heading ? 10px : 13px;
        font-weight: 600;
        min-width: 0px;
        preferred-width: 0px;
        horizontal-stretch: 1;
        overflow: elide;
        vertical-alignment: center;
    }
    Rectangle {
        width: 78px;
        if root.heading: Text { width: parent.width; text: "PROTOCOL"; color: Theme.secondary; font-size: 10px; font-weight: 600; vertical-alignment: center; }
        if !root.heading: RouteBadge { x: 0px; value: "SOCKS5"; neutral: true; width: 68px; height: 24px; y: (parent.height - self.height) / 2; }
    }
    Text {
        text: root.heading ? "ADDRESS" : root.proxy.address;
        color: Theme.secondary;
        font-family: root.heading ? "Segoe UI" : "Consolas";
        font-size: root.heading ? 10px : 12px;
        font-weight: root.heading ? 600 : 400;
        min-width: 0px;
        preferred-width: 0px;
        horizontal-stretch: 2;
        overflow: elide;
        vertical-alignment: center;
    }
    HorizontalLayout {
        spacing: 4px;
        min-width: 0px;
        preferred-width: 0px;
        horizontal-stretch: 1.2;
        if !root.heading && root.proxy.flag-index > 0: CountryFlag { index: root.proxy.flag-index; }
        Text {
            text: root.heading ? "LOCATION" : root.proxy.location == "" ? "—" : root.proxy.location;
            color: root.heading || root.proxy.location != "" ? Theme.secondary : Theme.muted;
            font-size: root.heading ? 10px : 12px;
            font-weight: root.heading ? 600 : 400;
            min-width: 0px;
            overflow: elide;
            vertical-alignment: center;
        }
    }
    Rectangle {
        width: 76px;
        if root.heading: Text { width: parent.width; text: "LATENCY"; color: Theme.secondary; font-size: 10px; font-weight: 600; vertical-alignment: center; }
        if !root.heading: HorizontalLayout {
            spacing: 5px;
            if root.measured || root.failed: Rectangle {
                width: 6px;
                Rectangle { y: (parent.height - 6px) / 2; width: 6px; height: 6px; border-radius: 3px; background: root.latency-ink; }
            }
            Text {
                text: root.failed ? "-1 ms" : root.measured ? root.proxy.status : "—";
                color: root.latency-ink;
                font-size: 12px;
                overflow: elide;
                min-width: 0px;
                vertical-alignment: center;
            }
        }
    }
    Rectangle {
        width: 102px;
        if !root.heading: HorizontalLayout {
            y: (parent.height - self.height) / 2;
            height: 30px;
            spacing: 6px;
            ActionButton {
                label: "Test proxy " + root.proxy.name;
                icon: "check"; icon-only: true;
                height: 30px; min-width: 30px; max-width: 30px;
                enabled: root.test-enabled;
                background: root.test-enabled ? Theme.success-soft : Theme.disabled;
                ink: root.test-enabled ? Theme.success : Theme.disabled-text;
                clicked => { root.test-proxy(); }
            }
            ActionButton {
                label: "Edit proxy " + root.proxy.name;
                icon: "edit"; icon-only: true;
                height: 30px; min-width: 30px; max-width: 30px;
                clicked => { root.edit-proxy(); }
            }
            ActionButton {
                label: "Delete proxy " + root.proxy.name;
                icon: "trash"; icon-only: true;
                height: 30px; min-width: 30px; max-width: 30px;
                ink: Theme.muted;
                clicked => { root.delete-proxy(); }
            }
        }
    }
}

export component MainWindow inherits Window {
    icon: @image-url("../assets/icon.svg");
    title: root.preview-ui ? "True Proxy · Local UI Preview" : root.local-build ? "True Proxy · Local build" : "True Proxy";
    preferred-width: 1240px; preferred-height: 780px; min-width: 960px; min-height: 640px;
    background: Theme.background; default-font-family: "Segoe UI"; default-font-size: 13px;
    in-out property <bool> dark-theme <=> Theme.dark;
    out property <color> caption-color: Theme.sidebar;
    init => { Palette.color-scheme = root.dark-theme ? ColorScheme.dark : ColorScheme.light; }
    changed dark-theme => {
        Palette.color-scheme = root.dark-theme ? ColorScheme.dark : ColorScheme.light;
        if root.dialog == 3 { root.import-viewport(); }
    }
    in-out property <int> page: 0;
    changed page => { root.sync-connection-observation(); }
    in property <bool> preview-ui: false;
    in property <bool> local-build: false;
    in-out property <int> settings-section: 0;
    in-out property <int> dialog: 0;
    in property <bool> active: false;
    in property <bool> busy: false;
    in property <bool> routing-pending: false;
    in-out property <string> import-json;
    in property <[JsonLine]> import-lines;
    in property <bool> import-valid: false;
    in property <string> import-error;
    in property <string> import-summary;
    in-out property <int> import-first-line: 0;
    in-out property <int> import-visible-lines: 40;
    in property <string> toast;
    in property <bool> toast-error: false;
    in property <string> toast-token;
    in property <bool> probe-busy: false;
    in-out property <bool> autostart-enabled: false;
    in property <bool> autostart-busy: false;
    in property <string> status: "Routing paused";
    in property <string> app-version: "dev";
    in property <bool> update-available;
    in property <bool> update-ready;
    in property <bool> update-busy;
    in-out property <bool> updates-automatic: true;
    in property <string> update-version;
    in property <string> update-text;
    in property <string> update-status;
    in-out property <string> notice;
    in property <string> uploaded: "0 B";
    in property <string> downloaded: "0 B";
    in property <string> upload-rate: "0 B/s";
    in property <string> download-rate: "0 B/s";
    in property <string> upload-path;
    in property <string> download-path;
    in property <[string]> traffic-scale: ["3 B/s", "2 B/s", "1 B/s", "0 B/s"];
    in property <float> upload-share: 0;
    in property <bool> has-transfer: false;
    in property <string> connection-count: "0";
    in property <string> uptime: "00:00:00";
    in property <string> blocked-count: "0";
    in property <[ProxyRow]> proxies;
    in-out property <string> proxy-query;
    in property <[ProxyRow]> visible-proxies: root.proxies;
    in property <[string]> selected-proxy-ids;
    in property <[bool]> proxy-selection;
    in property <int> proxy-selection-state;
    in property <[RuleRow]> rules;
    in-out property <string> rule-query;
    in property <[RuleRow]> visible-rules: root.rules;
    in property <int> enabled-rule-count;
    in-out property <string> local-network-draft;
    in property <[string]> proxy-names;
    in-out property <bool> surface-fresh: false;
    in property <[ProcessChoice]> all-processes;
    in property <[ProcessChoice]> process-choices;
    in property <int> process-selected-count;
    in-out property <string> process-query;
    in-out property <bool> process-by-path: false;
    in-out property <bool> process-picker: false;
    in property <bool> processes-busy: false;
    in-out property <string> form-id;
    in-out property <string> form-name;
    in-out property <string> form-host: "127.0.0.1";
    in-out property <string> form-port: "1080";
    in-out property <string> form-username;
    in-out property <string> form-password;
    in-out property <bool> form-auth: false;
    in property <[string]> form-processes;
    in property <[string]> form-paths;
    in property <[string]> form-domains;
    in property <[string]> form-networks;
    in property <[string]> form-ports;
    in-out property <bool> form-advanced: false;
    in-out property <bool> form-show-paths: false;
    in-out property <bool> form-manual: false;
    in property <string> form-probe-status;
    in property <string> form-probe-token;
    in property <int> form-probe-health;
    in-out property <string> form-new-process;
    in-out property <string> form-new-path;
    in-out property <string> form-new-domain;
    in-out property <string> form-new-network;
    in-out property <string> form-new-port;
    in-out property <int> form-protocol: 0;
    in-out property <int> form-action: 0;
    in-out property <int> form-proxy: 0;
    in-out property <bool> form-enabled: true;
    in property <string> fallback-label: "Direct";
    callback toggle;
    callback add-proxy;
    callback edit-proxy(string);
    callback save-proxy;
    callback delete-proxy(string);
    callback probe-proxy(string);
    callback filter-proxies;
    callback toggle-proxy-selection(string, bool);
    callback select-visible-proxies(bool);
    callback delete-selected-proxies;
    callback probe-proxy-form;
    callback proxy-form-edited;
    callback add-application(int);
    callback add-rule;
    callback edit-rule(string);
    callback save-rule;
    callback delete-rule(string);
    callback toggle-rule(string);
    callback move-rule(string, int);
    callback filter-rules;
    callback edit-local-network;
    callback save-local-network;
    callback select-fallback(int, string);
    callback set-autostart(bool);
    callback choose-theme(bool);
    callback hide-window;
    callback sync-connection-observation;
    callback suspend-connection-observation;
    callback close-dialog;
    callback add-condition(int, string);
    callback new-condition(int);
    callback edit-condition(int, int, string);
    callback remove-condition(int, int);
    callback open-processes;
    callback refresh-processes;
    callback filter-processes;
    callback toggle-process(string);
    callback add-selected-processes;
    callback restart-routing;
    callback export-config;
    callback open-import;
    callback cancel-import;
    callback import-edited;
    callback import-viewport;
    callback format-import;
    callback save-import;
    callback remember-routing(bool);
    callback sync-tray(bool, string);
    callback check-updates;
    callback update-now;
    callback set-updates-automatic(bool);

    // Keep the whole client area opaque when repainting after a window restore.
    surface := Rectangle {
        width: parent.width;
        height: parent.height;
        background: root.surface-fresh ? Theme.background-refresh : Theme.background;
        Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.border; }
        HorizontalLayout {
            x: 0px; y: 1px;
            width: parent.width; height: parent.height - 1px;
            spacing: 0px;
            Rectangle {
                width: 224px;
                background: Theme.sidebar;
                VerticalLayout {
                    spacing: 0px;
                    navigation-scroll := ScrollView {
                        min-height: 0px;
                        vertical-stretch: 1;
                        horizontal-scrollbar-policy: always-off;
                        content-width: self.visible-width;
                        content-height: max(self.visible-height, navigation.preferred-height);
                        navigation := VerticalLayout {
                            padding: 16px;
                            spacing: 15px;
                            alignment: start;
                            SidebarGroup {
                                title: "PROXY";
                                selection: root.page;
                                links: [
                                    { label: "Dashboard", icon: "dashboard", target: 0 },
                                    { label: "Proxies", icon: "server", target: 2 },
                                    { label: "Rules", icon: "rules", target: 1 },
                                    { label: "Connections", icon: "activity", target: 3 },
                                    { label: "Logs", icon: "file", target: 5 },
                                ];
                                open(page) => { root.page = page; }
                            }
                            if XrayModule.installed: SidebarGroup {
                                title: "X-RAY";
                                accessibility-prefix: "Xray ";
                                selection: root.page == 6 ? XrayModule.section : -1;
                                links: [
                                    { label: "Dashboard", icon: "dashboard", target: 0 },
                                    { label: "Profiles", icon: "file", target: 1 },
                                    { label: "General", icon: "settings", target: 2 },
                                    { label: "DNS", icon: "globe", target: 3 },
                                    { label: "Fallbacks", icon: "rules", target: 4 },
                                    { label: "Connections", icon: "activity", target: 5 },
                                    { label: "Logs", icon: "file", target: 6 },
                                ];
                                open(section) => {
                                    XrayModule.section = section;
                                    if root.page == 6 { XrayModule.refresh-activity(); }
                                    else { root.page = 6; }
                                }
                            }
                            SidebarGroup {
                                title: "SETTINGS";
                                selection: root.page == 4 ? root.settings-section : -1;
                                links: [
                                    { label: "General", icon: "settings", target: 0 },
                                    { label: "Modules", icon: "boxes", target: 2 },
                                ];
                                open(section) => { root.settings-section = section; root.page = 4; }
                            }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    VerticalLayout {
                        padding: 16px;
                        spacing: 8px;
                        vertical-stretch: 0;
                        HorizontalLayout {
                            spacing: 8px;
                            if root.active: Rectangle {
                                width: 10px;
                                Rectangle { width: 10px; height: 10px; y: 3px; border-radius: 5px; background: Theme.accent; }
                            }
                            Text { text: root.status; color: Theme.text; font-size: 11px; wrap: word-wrap; height: self.preferred-height; }
                        }
                        Text { text: "v" + root.app-version; color: Theme.muted; font-size: 10px; }
                    }
                }
            }
            Rectangle { width: 1px; background: Theme.border; }
            VerticalLayout {
                min-width: 0px;
                horizontal-stretch: 1;
                padding: 26px;
                spacing: 16px;
                if root.page != 3 && root.page != 6: PageHeader {
                    badge: root.preview-ui ? "Sample data" : "";
                    title: root.page == 4 ? (root.settings-section == 2 ? "Modules" : "General") : ["Dashboard", "Routing Rules", "Proxies", "Connections", "Settings", "Logs"][root.page];
                    subtitle: root.page == 0 ? "Monitor your proxy traffic and manage rules." : root.page == 1 ? "Define how traffic is routed: directly or through a proxy." : root.page == 2 ? "Manage your SOCKS5 servers and check their availability." : root.page == 4 ? (root.settings-section == 2 ? "Manage optional modules and their updates." : "Personalize True Proxy and manage local configuration.") : root.page == 5 ? "Review routing diagnostics and backend activity." : "";
                    action-label: root.page == 0 ? (root.busy ? "Please wait…" : root.active ? "Stop Routing" : "Start Routing") : root.page == 1 ? "Add Rule" : root.page == 2 ? "Add Proxy" : "";
                    action-icon: root.page == 0 ? (root.active ? "stop" : "play") : "plus";
                    action-accessibility: root.page == 0 ? "Routing" : root.page == 1 ? "Add Routing Rule" : "Add Proxy";
                    action-enabled: root.page != 0 || !root.busy;
                    action => {
                        if root.page == 0 { root.toggle(); }
                        else if root.page == 1 { root.add-rule(); }
                        else if root.page == 2 { root.add-proxy(); }
                    }
                }
                if root.notice != "": Rectangle {
                    height: max(48px, notice-content.preferred-height);
                    border-radius: Theme.radius-medium;
                    background: Theme.warning-surface;
                    notice-content := HorizontalLayout {
                        padding: 10px;
                        spacing: 8px;
                        Text { text: root.notice; wrap: word-wrap; min-width: 0px; max-height: 64px; overflow: elide; color: Theme.warning; font-size: 12px; }
                        ActionButton { label: "×"; accessible-label: "Dismiss notification"; min-width: 30px; max-width: 30px; height: 30px; clicked => { root.notice = ""; } }
                    }
                }
                if root.update-available: Rectangle {
                    height: update-content.preferred-height;
                    border-radius: Theme.radius-medium;
                    background: Theme.accent-soft;
                    update-content := HorizontalLayout {
                        padding: 12px;
                        spacing: 14px;
                        VerticalLayout { min-width: 0px; spacing: 4px;
                            Text { text: "True Proxy " + root.update-version + " is available"; color: Theme.text; font-size: 13px; font-weight: 600; }
                            Text { text: root.update-text; color: Theme.secondary; font-size: 12px; wrap: word-wrap; height: self.preferred-height; }
                        }
                        ActionButton {
                            label: root.update-busy ? "Please wait…" : "Install and Restart";
                            primary: true;
                            enabled: !root.update-busy && !root.busy;
                            clicked => { root.update-now(); }
                        }
                    }
                }
                if root.routing-pending: Rectangle {
                    height: pending-content.preferred-height;
                    background: Theme.warning-surface;
                    border-radius: Theme.radius-medium;
                    pending-content := HorizontalLayout {
                        padding: 12px;
                        spacing: 14px;
                        Text { text: "Restart to apply configuration changes. Routing will pause briefly and proxy connections will close."; color: Theme.warning; font-size: 12px; vertical-alignment: center; wrap: word-wrap; min-width: 0px; }
                        ActionButton { label: "Restart"; height: 34px; enabled: root.active && !root.busy; clicked => { root.restart-routing(); } }
                    }
                }
                if root.page == 0: DashboardView {
                    active: root.active; busy: root.busy; status: root.status; uptime: root.uptime;
                    connection-count: root.connection-count; enabled-rule-count: root.enabled-rule-count;
                    proxies: root.proxies; rules: root.rules; fallback-label: root.fallback-label;
                    uploaded: root.uploaded; downloaded: root.downloaded;
                    upload-rate: root.upload-rate; download-rate: root.download-rate;
                    upload-path: root.upload-path; download-path: root.download-path; traffic-scale: root.traffic-scale;
                    open-proxies => { root.page = 2; }
                    open-rules => { root.page = 1; }
                    toggle-rule(id) => { root.toggle-rule(id); }
                }
                if root.page == 1: VerticalLayout {
                    spacing: 8px;
                    padding-top: 26px;
                    vertical-stretch: 1;
                    HorizontalLayout {
                        height: 34px;
                        spacing: 12px;
                        Text {
                            text: (root.visible-rules.length + 2) + " rules";
                            color: Theme.text;
                            font-size: 15px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Field {
                            width: 176px;
                            field-height: 34px;
                            placeholder: "Search rules";
                            icon: "search";
                            value <=> root.rule-query;
                            edited => { rule-list.content-y = 0px; root.filter-rules(); }
                        }
                    }
                    Rectangle {
                        min-height: 0px;
                        vertical-stretch: 1;
                        Rectangle {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: min(parent.height, rules-content.preferred-height + 2px);
                            background: Theme.surface;
                            border-radius: Theme.radius-large;
                            border-width: 1px;
                            border-color: Theme.border;
                            clip: true;
                            rule-list := ScrollView {
                                property <bool> can-reorder: !root.busy && root.rule-query == "" && root.rules.length > 1;
                                property <bool> dragging;
                                property <RuleRow> dragged;
                                property <length> row-height;
                                property <length> origin-y;
                                property <length> grab-y;
                                property <length> pointer-y;
                                property <length> floating-y: self.pointer-y - rules-content.absolute-position.y - self.grab-y;
                                property <int> drop-priority: self.dragging ? max(2, min(root.rules.length + 1, self.dragged.priority
                                    + round((self.floating-y - self.origin-y) / self.row-height))) : 0;
                                changed can-reorder => { if !self.can-reorder { self.dragging = false; } }

                                pure function slide-for(priority: int) -> length {
                                    if !self.dragging { return 0px; }
                                    if self.dragged.priority < priority && priority <= self.drop-priority { return -self.row-height; }
                                    if self.drop-priority <= priority && priority < self.dragged.priority { return self.row-height; }
                                    return 0px;
                                }

                                x: 1px;
                                y: 1px;
                                width: parent.width - 2px;
                                height: parent.height - 2px;
                                horizontal-scrollbar-policy: always-off;
                                content-width: self.visible-width;
                                content-height: rules-content.preferred-height;
                                rules-content := VerticalLayout {
                                    alignment: start;
                                    spacing: 0px;
                                    local-network-card := RuleLine {
                                        priority: 1;
                                        name: "Local";
                                        route: "Direct";
                                        locked: true;
                                        ActionButton {
                                            label: "Edit local network";
                                            icon: "more";
                                            icon-only: true;
                                            quiet: true;
                                            enabled: !root.busy;
                                            clicked => { root.edit-local-network(); }
                                        }
                                    }
                                    if root.rule-query != "" && root.visible-rules.length == 0: Text {
                                        height: 38px;
                                        text: "No matching rules";
                                        color: Theme.muted;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    for rule in root.visible-rules: RuleLine {
                                        priority: rule.priority;
                                        name: rule.name;
                                        route: rule.route;
                                        checked: rule.enabled;
                                        busy: root.busy;
                                        draggable: rule-list.can-reorder;
                                        hidden-for-drag: rule-list.dragging && rule-list.dragged.id == rule.id;
                                        slide: rule-list.slide-for(rule.priority);
                                        toggled => { root.toggle-rule(rule.id); }
                                        drag-started(pointer-y) => {
                                            rule-list.dragged = rule;
                                            rule-list.row-height = self.height;
                                            rule-list.origin-y = self.y;
                                            rule-list.grab-y = pointer-y - self.absolute-position.y;
                                            rule-list.pointer-y = pointer-y;
                                            rule-list.dragging = true;
                                        }
                                        drag-moved(pointer-y) => { if self.hidden-for-drag { rule-list.pointer-y = pointer-y; } }
                                        drag-ended(pointer-y, dropped) => {
                                            if self.hidden-for-drag {
                                                if dropped { rule-list.pointer-y = pointer-y; }
                                                let offset = rule-list.drop-priority - rule.priority;
                                                rule-list.dragging = false;
                                                if dropped && offset != 0 { root.move-rule(rule.id, offset); }
                                            }
                                        }
                                        RuleActions {
                                            rule-name: rule.name;
                                            enabled: !root.busy;
                                            can-move-up: rule.priority > 2;
                                            can-move-down: rule.priority < root.rules.length + 1;
                                            window-height: root.height;
                                            edit => { root.edit-rule(rule.id); }
                                            remove => { root.delete-rule(rule.id); }
                                            move(offset) => { root.move-rule(rule.id, offset); }
                                        }
                                    }
                                    fallback-card := RuleLine {
                                        priority: root.rules.length + 2;
                                        name: "Fallback";
                                        route: root.fallback-label;
                                        locked: true;
                                        last: true;
                                        fallback-selector := FallbackSelector {
                                            proxies: root.proxies;
                                            enabled: !root.busy;
                                            selected(kind, proxy-id) => { root.select-fallback(kind, proxy-id); }
                                        }
                                    }
                                }
                                if rule-list.dragging: floating-rule := RuleLine {
                                    x: 0px;
                                    y: rule-list.floating-y;
                                    width: rule-list.visible-width;
                                    priority: rule-list.drop-priority;
                                    name: rule-list.dragged.name;
                                    route: rule-list.dragged.route;
                                    checked: rule-list.dragged.enabled;
                                    floating: true;
                                    Rectangle {
                                        height: 38px;
                                        UiIcon {
                                            name: "more";
                                            width: 16px;
                                            height: 16px;
                                            ink: Theme.text;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                if root.page == 2: SurfaceCard {
                    VerticalLayout {
                        padding: 1px;
                        spacing: 0px;
                        PanelToolbar {
                            Text { text: "All Proxies"; color: Theme.text; font-size: 18px; font-weight: 600; width: 94px; vertical-alignment: center; }
                            Rectangle { width: 24px; CountPill { value: root.visible-proxies.length; width: 24px; y: (parent.height - self.height) / 2; } }
                            Rectangle { horizontal-stretch: 1; }
                            if root.selected-proxy-ids.length > 0: Text {
                                text: root.selected-proxy-ids.length + " selected";
                                color: Theme.secondary;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            if root.selected-proxy-ids.length > 0: Rectangle {
                                width: delete-selected.min-width;
                                delete-selected := ActionButton {
                                    label: "Delete Selected";
                                    icon: "trash";
                                    y: (parent.height - self.height) / 2;
                                    height: 32px;
                                    enabled: !root.busy;
                                    ink: root.busy ? Theme.disabled-text : Theme.danger;
                                    clicked => { root.delete-selected-proxies(); }
                                }
                            }
                            Rectangle {
                                width: 206px;
                                Field {
                                    y: (parent.height - self.height) / 2;
                                    field-height: 34px; height: 34px;
                                    placeholder: "Search proxies"; icon: "search";
                                    value <=> root.proxy-query;
                                    edited => { proxy-list.content-y = 0px; root.filter-proxies(); }
                                }
                            }
                        }
                        Rectangle { height: 1px; background: Theme.border; }
                        TableHeading {
                            ProxyTableColumns {
                                heading: true;
                                selected: root.proxy-selection-state == 2;
                                partially-selected: root.proxy-selection-state == 1;
                                selection-enabled: root.visible-proxies.length > 0;
                                select(value) => { root.select-visible-proxies(value); }
                            }
                        }
                        Rectangle { height: 1px; background: Theme.border; }
                        proxy-list := ScrollView {
                            horizontal-scrollbar-policy: always-off;
                            content-width: self.visible-width;
                            content-height: max(self.visible-height, proxy-content.preferred-height);
                            proxy-content := VerticalLayout {
                                alignment: start;
                                spacing: 0px;
                                if root.visible-proxies.length == 0: EmptyState {
                                    icon: "server";
                                    title: root.proxies.length == 0 ? "No SOCKS5 proxies configured" : "No matching proxies";
                                    caption: root.proxies.length == 0 ? "Add a proxy to start routing application traffic." : "Try another name or address.";
                                }
                                for proxy[index] in root.visible-proxies: Rectangle {
                                    property <bool> selected: index < root.proxy-selection.length && root.proxy-selection[index];
                                    height: 68px;
                                    background: self.selected ? Theme.accent-soft : Theme.surface;
                                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                                    ProxyTableColumns {
                                        proxy: proxy;
                                        selected: parent.selected;
                                        test-enabled: !root.probe-busy;
                                        select(value) => { root.toggle-proxy-selection(proxy.id, value); }
                                        test-proxy => { root.probe-proxy(proxy.id); }
                                        edit-proxy => { root.edit-proxy(proxy.id); }
                                        delete-proxy => { root.delete-proxy(proxy.id); }
                                    }
                                }
                            }
                        }
                    }
                }
                if root.page == 3: ConnectionsView { preview-ui: root.preview-ui; }
                if root.page == 5: LogsView { }
                if root.page == 6 && XrayModule.installed: XrayView { preview-ui: root.preview-ui; }
                if root.page == 4: settings-scroll := ScrollView {
                        horizontal-scrollbar-policy: always-off;
                        content-width: self.visible-width;
                        content-height: max(self.visible-height, settings-content.preferred-height);
                        settings-content := VerticalLayout {
                            alignment: start;
                            spacing: 16px;
                            padding-right: 3px;
                            padding-bottom: 14px;
                            if root.settings-section == 2: XrayModuleCard {}
                            if root.settings-section == 2: HpwnrModuleCard {}
                            if root.settings-section == 0: general-grid := Rectangle {
                                property <bool> two-columns: self.width >= 740px;
                                property <length> tile-width: self.two-columns ? (self.width - 16px) / 2 : self.width;
                                property <length> second-column: self.two-columns ? self.tile-width + 16px : 0px;
                                property <length> first-row: max(appearance.content-height, startup.content-height);
                                property <length> second-row: max(updates.content-height, configuration.content-height);
                                property <length> third-row: max(dns.content-height, about.content-height);
                                height: self.two-columns ? self.first-row + self.second-row + self.third-row + 32px : about.y + about.height;
                                vertical-stretch: 0;
                                appearance := FormCard {
                                    x: 0px; y: 0px;
                                    width: general-grid.tile-width;
                                    height: general-grid.two-columns ? general-grid.first-row : self.content-height;
                                    title: "Appearance"; icon: "sun"; caption: "Choose a comfortable workspace.";
                                        HorizontalLayout {
                                            alignment: start;
                                            spacing: 8px;
                                            ActionButton {
                                                label: "Light"; icon: "sun";
                                                accessible-label: "Light theme";
                                                primary: !root.dark-theme;
                                                height: 40px;
                                                clicked => { root.choose-theme(false); }
                                            }
                                            ActionButton {
                                                label: "Dark"; icon: "moon";
                                                accessible-label: "Dark theme";
                                                primary: root.dark-theme;
                                                height: 40px;
                                                clicked => { root.choose-theme(true); }
                                            }
                                        }
                                }
                                startup := FormCard {
                                    x: general-grid.second-column;
                                    y: general-grid.two-columns ? 0px : appearance.y + appearance.height + 16px;
                                    width: general-grid.tile-width;
                                    height: general-grid.two-columns ? general-grid.first-row : self.content-height;
                                    title: "Startup"; icon: "power"; caption: "";
                                        ThemedCheckBox { text: "Start when I sign in to Windows"; checked <=> root.autostart-enabled; enabled: !root.autostart-busy; toggled => { root.set-autostart(self.checked); } }
                                        Text { text: root.autostart-busy ? "Updating startup settings…" : "Start in the system tray and restore the last routing state."; color: Theme.secondary; font-size: 12px; wrap: word-wrap; height: self.preferred-height; }
                                }
                                updates := FormCard {
                                    x: 0px;
                                    y: general-grid.two-columns ? general-grid.first-row + 16px : startup.y + startup.height + 16px;
                                    width: general-grid.tile-width;
                                    height: general-grid.two-columns ? general-grid.second-row : self.content-height;
                                    title: "Updates"; icon: "refresh"; caption: "";
                                        ThemedCheckBox { text: "Check for updates automatically"; checked <=> root.updates-automatic; toggled => { root.set-updates-automatic(self.checked); } }
                                        if root.update-status != "": Text { text: root.update-status; color: Theme.secondary; font-size: 12px; wrap: word-wrap; height: self.preferred-height; }
                                        HorizontalLayout { ActionButton { label: root.update-busy ? "Checking…" : "Check for Updates"; icon: "refresh"; height: 40px; enabled: !root.update-busy; clicked => { root.check-updates(); } } }
                                        Text { text: "Checks at launch and every 6 hours."; color: Theme.muted; font-size: 11px; }
                                }
                                configuration := FormCard {
                                    x: general-grid.second-column;
                                    y: general-grid.two-columns ? updates.y : updates.y + updates.height + 16px;
                                    width: general-grid.tile-width;
                                    height: general-grid.two-columns ? general-grid.second-row : self.content-height;
                                    title: "Configuration"; icon: "files"; caption: "";
                                        Text { text: "Import or export rules and proxies as JSON. Exported JSON includes proxy passwords."; color: Theme.secondary; font-size: 13px; wrap: word-wrap; height: self.preferred-height; }
                                        HorizontalLayout { spacing: 8px; alignment: start;
                                            ActionButton { label: "Import"; icon: "download"; height: 40px; enabled: !root.busy; clicked => { root.open-import(); } }
                                            ActionButton { label: "Export"; icon: "upload"; height: 40px; clicked => { root.export-config(); } }
                                        }
                                }
                                dns := FormCard {
                                    x: 0px;
                                    y: general-grid.two-columns ? updates.y + general-grid.second-row + 16px : configuration.y + configuration.height + 16px;
                                    width: general-grid.tile-width;
                                    height: general-grid.two-columns ? general-grid.third-row : self.content-height;
                                    title: "System DNS"; icon: "globe"; caption: "";
                                        Text { text: "Windows resolves names. DNS on TCP or UDP port 53 goes directly."; color: Theme.secondary; font-size: 12px; wrap: word-wrap; height: self.preferred-height; }
                                        Text { text: "DoH and DoT follow application routing rules."; color: Theme.muted; font-size: 11px; wrap: word-wrap; height: self.preferred-height; }
                                }
                                about := FormCard {
                                    x: general-grid.second-column;
                                    y: general-grid.two-columns ? dns.y : dns.y + dns.height + 16px;
                                    width: general-grid.tile-width;
                                    height: general-grid.two-columns ? general-grid.third-row : self.content-height;
                                    title: "About True Proxy"; icon: "info";
                                    HorizontalLayout { spacing: 12px;
                                        Text { text: "Version " + root.app-version; color: Theme.secondary; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                                        IconLicenseButton {}
                                    }
                                }
                            }
                        }
                    }
            }
        }
    }


    if root.dialog == 1 || root.dialog == 2: Rectangle {
        background: Theme.overlay;
        TouchArea { }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(parent.width - 48px, root.dialog == 1 ? 570px : 550px);
            height: min(parent.height - 42px, root.dialog == 1 ? (root.form-auth ? 648px : 590px) : 700px);
            border-radius: Theme.radius-large;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.surface;
            clip: true;
            VerticalLayout {
                spacing: 0px;
                DialogHeader {
                    icon: root.dialog == 1 ? "server" : "rules";
                    title: root.dialog == 1
                        ? (root.form-id == "" ? "Add Proxy Server" : "Edit Proxy Server")
                        : (root.form-id == "" ? "Add Routing Rule" : "Edit Routing Rule");
                    subtitle: root.dialog == 1 ? "Configure a SOCKS5 proxy connection" : "Choose which traffic this rule routes";
                    close => { root.close-dialog(); }
                }
                if root.dialog == 1: ScrollView {
                    horizontal-scrollbar-policy: always-off;
                    content-width: self.visible-width;
                    content-height: max(self.visible-height, proxy-form-content.preferred-height);
                    proxy-form-content := VerticalLayout {
                        padding: 22px;
                        spacing: 13px;
                        alignment: start;
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "SERVER DETAILS"; color: Theme.accent; font-size: 11px; font-weight: 700; }
                            Text { text: "Basic connection information"; color: Theme.muted; font-size: 12px; }
                        }
                        Field { label: "Proxy Name"; placeholder: "My proxy"; value <=> root.form-name; edited => { root.proxy-form-edited(); } }
                        HorizontalLayout {
                            spacing: 12px;
                            Field { label: "Host Address"; placeholder: "proxy.example.com"; value <=> root.form-host; edited => { root.proxy-form-edited(); } }
                            Field { label: "Port"; placeholder: "1080"; value <=> root.form-port; width: 142px; edited => { root.proxy-form-edited(); } }
                        }
                        VerticalLayout {
                            spacing: 6px;
                            Text { text: "Proxy Type"; color: Theme.secondary; font-size: 13px; }
                            Rectangle {
                                height: 38px;
                                border-radius: Theme.radius-small;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.field;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    spacing: 7px;
                                    Rectangle {
                                        width: 18px;
                                        UiIcon { name: "server"; ink: Theme.accent; y: (parent.height - self.height) / 2; }
                                    }
                                    Text { text: "SOCKS5"; color: Theme.accent; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                                }
                            }
                        }
                        Rectangle { height: 1px; background: Theme.border; }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "OPTIONS"; color: Theme.accent; font-size: 11px; font-weight: 700; }
                            Text { text: "Authentication settings"; color: Theme.muted; font-size: 12px; }
                        }
                        Rectangle {
                            height: 60px;
                            border-radius: Theme.radius-small;
                            border-width: 1px;
                            border-color: Theme.border;
                            background: Theme.field;
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 12px; spacing: 12px;
                                Rectangle {
                                    width: 24px;
                                    UiIcon { name: "lock"; ink: Theme.accent; x: 3px; y: (parent.height - self.height) / 2; }
                                }
                                VerticalLayout {
                                    alignment: center; spacing: 3px; horizontal-stretch: 1;
                                    Text { text: "Requires Authentication"; color: Theme.text; font-size: 13px; font-weight: 600; }
                                    Text { text: "Enable if your proxy requires credentials"; color: Theme.muted; font-size: 11px; }
                                }
                                Rectangle {
                                    width: 44px;
                                    RuleSwitch {
                                        y: (parent.height - self.height) / 2;
                                        checked: root.form-auth;
                                        label: "Requires Authentication";
                                        toggled => { root.form-auth = !root.form-auth; root.proxy-form-edited(); }
                                    }
                                }
                            }
                        }
                        if root.form-auth: HorizontalLayout {
                            spacing: 12px;
                            Field { label: "Username"; value <=> root.form-username; edited => { root.proxy-form-edited(); } }
                            Field { label: "Password"; secret: true; placeholder: root.form-id != "" ? "Leave blank to keep the password" : "SOCKS5 password"; value <=> root.form-password; edited => { root.proxy-form-edited(); } }
                        }
                        if root.form-probe-status != "": Text {
                            text: root.form-probe-status;
                            color: root.form-probe-health == 3 ? Theme.danger : root.form-probe-health == 2 ? Theme.success : Theme.secondary;
                            font-size: 12px;
                            wrap: word-wrap;
                            height: self.preferred-height;
                        }
                    }
                }
                if root.dialog == 2: rule-scroll := ScrollView {
                    horizontal-scrollbar-policy: always-off;
                    content-width: self.visible-width;
                    content-height: max(self.visible-height, rule-content.preferred-height);
                    rule-content := VerticalLayout {
                        alignment: start; spacing: 13px; padding: 20px; padding-bottom: 24px;
                        Field { label: "Rule Name"; placeholder: "e.g. Browser via VPN"; value <=> root.form-name; }
                        ListEditor { title: "Applications by EXE name"; placeholder: "browser.exe"; applications: true; values: root.form-processes; add-empty => { root.new-condition(0); } edit(index, value) => { root.edit-condition(0, index, value); } remove(index) => { root.remove-condition(0, index); } choose(kind) => { root.add-application(kind); } }
                        if root.form-processes.length == 0 && root.form-paths.length == 0: Text { text: "Leave applications empty to match all processes."; wrap: word-wrap; height: self.preferred-height; color: Theme.muted; font-size: 12px; }
                        if root.form-show-paths: ListEditor { title: "Executable paths"; placeholder: "C:\\Apps\\app.exe"; values: root.form-paths; add-empty => { root.new-condition(1); } edit(index, value) => { root.edit-condition(1, index, value); } remove(index) => { root.remove-condition(1, index); } }
                        if root.form-processes.length > 0 && root.form-paths.length > 0: Text { text: "Both the executable name and the path must match."; color: Theme.warning; wrap: word-wrap; height: self.preferred-height; font-size: 12px; }
                        Rectangle { height: 1px; background: Theme.border; }
                        VerticalLayout {
                            spacing: 8px;
                            Text { text: "ROUTING ACTION"; color: Theme.accent; font-size: 11px; font-weight: 700; }
                            HorizontalLayout { height: 38px; spacing: 8px; Text { text: "Protocol"; width: 112px; font-size: 13px; color: Theme.secondary; vertical-alignment: center; } ThemedComboBox { model: ["TCP + UDP", "TCP", "UDP"]; current-index <=> root.form-protocol; } }
                            HorizontalLayout { height: 38px; spacing: 8px; Text { text: "Action"; width: 112px; font-size: 13px; color: Theme.secondary; vertical-alignment: center; } ThemedComboBox { model: ["Proxy", "Direct", "Block"]; current-index <=> root.form-action; } }
                            HorizontalLayout { height: 38px; spacing: 8px; Text { text: "SOCKS5 Proxy"; width: 112px; font-size: 13px; color: Theme.secondary; vertical-alignment: center; } ThemedComboBox { model: root.proxy-names; current-index <=> root.form-proxy; enabled: root.form-action == 0; } }
                        }
                        Disclosure { label: "Additional conditions"; expanded: root.form-advanced; count: root.form-domains.length + root.form-networks.length + root.form-ports.length; clicked => { root.form-advanced = !root.form-advanced; } }
                        if root.form-advanced: VerticalLayout {
                            alignment: start; spacing: 12px;
                            ListEditor { title: "Domains"; add-label: "Add domain"; placeholder: "example.com or *.example.com"; values: root.form-domains; add-empty => { root.new-condition(2); } edit(index, value) => { root.edit-condition(2, index, value); } remove(index) => { root.remove-condition(2, index); } }
                            Text { text: "example.com matches the exact name. *.example.com also matches its subdomains. The process and domain must both match."; wrap: word-wrap; height: self.preferred-height; color: Theme.secondary; font-size: 12px; }
                            Text { text: "Domain matching uses observed DNS answers. The Windows DNS cache, DoH, and connections by IP can hide the name."; wrap: word-wrap; height: self.preferred-height; color: Theme.warning; font-size: 12px; }
                            ListEditor { title: "IP / CIDR"; placeholder: "10.0.0.0/8 or 1.2.3.4"; values: root.form-networks; add-empty => { root.new-condition(3); } edit(index, value) => { root.edit-condition(3, index, value); } remove(index) => { root.remove-condition(3, index); } }
                            ListEditor { title: "Ports"; placeholder: "443 or 8000-9000"; values: root.form-ports; add-empty => { root.new-condition(4); } edit(index, value) => { root.edit-condition(4, index, value); } remove(index) => { root.remove-condition(4, index); } }
                        }
                    }
                }
                if root.notice != "": Rectangle {
                    height: min(70px, max(40px, form-notice.preferred-height + 16px));
                    background: Theme.warning-surface;
                    form-notice := Text { x: 20px; width: parent.width - 40px; text: root.notice; wrap: word-wrap; overflow: elide; color: Theme.warning; font-size: 12px; vertical-alignment: center; }
                }
                DialogActions {
                    ActionButton { label: "Cancel"; clicked => { root.close-dialog(); } }
                    if root.dialog == 1: ActionButton { label: root.probe-busy ? "Checking…" : "Check"; icon: "play"; enabled: !root.probe-busy; clicked => { root.probe-proxy-form(); } }
                    ActionButton {
                        label: root.form-id != "" ? "Save Changes" : root.dialog == 1 ? "Add Proxy" : "Add Rule";
                        accessible-label: "Save";
                        primary: true; enabled: !root.busy;
                        clicked => { if root.dialog == 1 { root.save-proxy(); } else { root.save-rule(); } }
                    }
                }
            }
        }
    }

    if root.process-picker: Rectangle { background: Theme.overlay; TouchArea { }
        Rectangle { width: min(parent.width - 20px, 640px); height: min(parent.height - 20px, 680px); x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-large;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout { padding: 16px; spacing: 11px;
                DialogHeader { title: "Running Applications"; subtitle: "Choose applications for this routing rule"; icon: "app"; close => { root.process-picker = false; } }
                HorizontalLayout { spacing: 8px; Field { placeholder: "Search processes"; icon: "search"; value <=> root.process-query; edited => { root.filter-processes(); } } ActionButton { label: root.processes-busy ? "Loading…" : "Refresh"; icon: "refresh"; enabled: !root.processes-busy; clicked => { root.refresh-processes(); } } }
                ThemedCheckBox { text: "Use the full executable path"; min-width: 0px; checked <=> root.process-by-path; }
                process-list := ScrollView {
                    horizontal-scrollbar-policy: always-off; content-width: self.visible-width;
                    content-height: max(self.visible-height, process-content.preferred-height);
                    process-content := VerticalLayout { spacing: 6px; padding-right: 4px; padding-bottom: 8px;
                    for process in root.process-choices: Rectangle { height: 67px; border-radius: Theme.radius-small; background: process.selected ? Theme.accent-soft : Theme.field;
                        VerticalLayout { padding: 11px; spacing: 4px;
                            ThemedCheckBox { text: process.name + " · " + process.instances + " instances"; min-width: 0px; checked: process.selected; enabled: !root.process-by-path || process.path != ""; toggled => { root.toggle-process(process.key); } }
                            Text { text: process.path == "" ? "Path unavailable · PID " + process.pids : process.path + " · PID " + process.pids; font-size: 10px; color: Theme.muted; overflow: elide; min-width: 0px; }
                        }
                    }
                    if root.process-choices.length == 0: Text { text: root.processes-busy ? "Reading running processes…" : "No matching processes"; color: Theme.muted; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    Rectangle { vertical-stretch: 1; }
                } }
                if root.notice != "": Text { text: root.notice; color: Theme.warning; font-size: 11px; wrap: word-wrap; }
                Text { text: "Selected: " + root.process-selected-count; color: Theme.secondary; font-size: 11px; }
                HorizontalLayout { spacing: 8px; alignment: end; ActionButton { label: "Back"; clicked => { root.process-picker = false; } } ActionButton { label: "Add Selected"; primary: true; enabled: root.process-selected-count > 0; clicked => { root.add-selected-processes(); } } }
            }
        }
    }
    if root.dialog == 3: Rectangle { background: Theme.overlay; TouchArea { }
        Rectangle { width: min(parent.width - 20px, 640px); height: min(parent.height - 20px, 740px); x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-large;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout { padding: 16px; spacing: 8px;
                DialogHeader { title: "Import Configuration"; subtitle: "Review and edit your JSON profile"; icon: "file"; close => { root.cancel-import(); } }
                Text { text: "Import replaces the proxy list, routing rules and default route. App settings and routing state are kept."; color: Theme.secondary; font-size: 11px; wrap: word-wrap; vertical-stretch: 0; }
                HorizontalLayout { height: 38px; spacing: 10px; alignment: start;
                    ActionButton { label: "Paste JSON"; clicked => { json-editor.paste(); } }
                    ActionButton { label: "Format"; enabled: root.import-valid; clicked => { root.format-import(); } }
                }
                json-editor := JsonEditor { min-height: 64px; text <=> root.import-json; lines: root.import-lines;
                    edited => { root.import-edited(); }
                    viewport(first, count) => { root.import-first-line = first; root.import-visible-lines = count; root.import-viewport(); }
                }
                Text { text: root.import-error != "" ? root.import-error : root.import-summary;
                    color: root.import-error != "" ? Theme.danger : root.import-valid ? Theme.success : Theme.muted;
                    wrap: word-wrap; font-size: 11px; vertical-stretch: 0; max-height: 55px; overflow: elide; }
                HorizontalLayout { height: 38px; spacing: 10px; alignment: end;
                    ActionButton { label: "Cancel"; clicked => { root.cancel-import(); } }
                    ActionButton { label: "Save"; primary: true; enabled: root.import-valid && !root.busy; clicked => { root.save-import(); } }
                }
            }
        }
    }
    if root.dialog == 4: Rectangle {
        background: Theme.overlay;
        TouchArea { }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(parent.width - 48px, 530px);
            height: min(parent.height - 42px, 450px);
            border-radius: Theme.radius-large;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.surface;
            clip: true;
            VerticalLayout {
                spacing: 0px;
                DialogHeader {
                    title: "Edit local network";
                    subtitle: "First rule · Always Direct";
                    icon: "direct";
                    close => { root.close-dialog(); }
                }
                VerticalLayout {
                    padding: 20px;
                    spacing: 10px;
                    Text {
                        text: "IP ranges";
                        color: Theme.text; font-size: 13px; font-weight: 600;
                    }
                    Text {
                        text: "Enter one IPv4 or IPv6 CIDR per line.";
                        color: Theme.muted; font-size: 12px;
                    }
                    TextEdit {
                        accessible-label: "Local network CIDRs";
                        text <=> root.local-network-draft;
                        font-family: "Consolas";
                        font-size: 13px;
                        wrap: no-wrap;
                        placeholder-text: "192.168.0.0/16";
                        key-pressed(event) => {
                            if event.text == Key.Escape { root.close-dialog(); return accept; }
                            return reject;
                        }
                    }
                    if root.notice != "": Text {
                        text: root.notice; color: Theme.danger; font-size: 12px;
                        wrap: word-wrap; max-height: 44px; overflow: elide;
                    }
                }
                DialogActions {
                    ActionButton { label: "Cancel"; clicked => { root.close-dialog(); } }
                    ActionButton {
                        label: "Save"; accessible-label: "Save local network"; primary: true;
                        enabled: !root.busy;
                        clicked => { root.save-local-network(); }
                    }
                }
            }
        }
    }
    if root.toast != "": Rectangle { width: min(400px, parent.width - 24px); height: 76px; x: (parent.width - self.width) / 2; y: parent.height - self.height - 16px;
        background: root.toast-error ? Theme.warning-surface : Theme.accent-soft; border-color: Theme.border; border-width: 1px; border-radius: Theme.radius-medium;
        Text { x: 12px; width: parent.width - 24px; text: root.toast; color: root.toast-error ? Theme.danger : Theme.success; font-size: 12px; wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center; }
    }
}

export component Tray inherits SystemTrayIcon {
    in property <image> tray-image;
    in property <bool> active;
    in property <string> status;
    icon: root.tray-image; tooltip: "True Proxy · " + root.status;
    callback open;
    callback toggle;
    callback exit;
    clicked => { root.open(); }
    Menu { MenuItem { title: "Open True Proxy"; activated => { root.open(); } } MenuItem { title: root.active ? "Pause Routing" : "Start Routing"; activated => { root.toggle(); } } MenuSeparator { } MenuItem { title: "Exit"; activated => { root.exit(); } } }
}
