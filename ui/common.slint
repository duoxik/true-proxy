import { IconGlyph, IconLicense } from "icon-assets.slint";
import { ComboBox, ScrollView } from "std-widgets.slint";

// Shared theme, models and controls for the tray panel and Connections window.
export struct ProxyRow { id: string, key: string, name: string, address: string, status: string, location: string, flag-index: int, health: int, udp: bool }
export struct RuleRow { id: string, name: string, route: string, enabled: bool, priority: int }
export struct LogRow { id: string, process: string, pid: string, destination: string, route: string, message: string, source: string, started: string, elapsed: string, status: string, state: int }
export struct ProcessChoice { key: string, name: string, path: string, pids: string, instances: int, selected: bool }
export struct ProcessSummary { name: string, icon: image, active: int, events: int, uploaded: string, downloaded: string, expanded: bool, connections: [LogRow] }
export struct ConnectionFilterOption { key: string, label: string, checked: bool }

export global Theme {
    in property <bool> dark: true;
    out property <color> background: dark ? #0d0d0d : #f1f3f5;
    out property <color> background-refresh: dark ? #0e0e0e : #f1f3f6;
    out property <color> sidebar: dark ? #0b0b0b : #ffffff;
    out property <color> surface: dark ? #101010 : #ffffff;
    out property <color> surface-hover: dark ? #292a2d : #f7f5ff;
    out property <color> pressed: dark ? #383a3e : #ede7ff;
    out property <color> field: dark ? #151515 : #f7f8f9;
    out property <color> border: dark ? #252525 : #e0e3e7;
    out property <color> text: dark ? #f1f1f2 : #141d2d;
    out property <color> secondary: dark ? #aaacb1 : #4f5c6c;
    out property <color> muted: dark ? #888a90 : #687585;
    out property <color> accent: dark ? #c4f52b : #7846db;
    out property <color> accent-hover: dark ? #e3fc7c : #6235bf;
    out property <color> accent-soft: dark ? #292e14 : #f3efff;
    out property <color> primary: dark ? self.accent : #8354ea;
    out property <color> primary-hover: dark ? self.accent-hover : #7546d9;
    out property <color> primary-pressed: dark ? #bedf35 : #6739c9;
    out property <color> primary-text: dark ? #0d0e10 : #ffffff;
    out property <color> disabled: dark ? #252629 : #eff1f4;
    out property <color> disabled-text: dark ? #888a90 : #758191;
    out property <color> success: dark ? #83dba3 : #167b45;
    out property <color> warning: dark ? #f0c676 : #8c5808;
    out property <color> warning-surface: dark ? #3a2c1b : #fff7e5;
    out property <color> danger: dark ? #f18a96 : #b72b40;
    out property <color> switch-off: dark ? #383a3e : #cbd0d6;
    out property <color> switch-off-thumb: dark ? #e6e7e9 : #ffffff;
    out property <color> switch-on-thumb: #ffffff;
    out property <color> selection: dark ? #383a3e : #e9ddff;
    out property <color> neutral-badge: dark ? #252629 : #eff1f4;
    out property <color> overlay: dark ? #000000a8 : #19212e82;
    out property <color> success-soft: dark ? #1d3327 : #ebf9f0;
    out property <color> danger-soft: dark ? #382427 : #fff1f2;
    out property <color> blue: dark ? #8bb5ff : #2864ca;
    out property <color> chart-download: dark ? #659dff : #2864ca;
    out property <color> chart-upload: dark ? #8df574 : #167b45;
    out property <length> radius-small: 10px;
    out property <length> radius-medium: 14px;
    out property <length> radius-large: 18px;
    // Fluent scrollbars overlay the viewport; reserve the same space in toolbars.
    out property <length> scroll-gutter: 15px;
}

// Shared page building blocks. Content remains native Slint throughout.
export component SurfaceCard inherits Rectangle {
    min-width: 0px;
    background: Theme.surface;
    border-radius: Theme.radius-large;
    border-width: 1px;
    border-color: Theme.border;
    @children
}

export component PanelToolbar inherits HorizontalLayout {
    height: 64px;
    vertical-stretch: 0;
    padding-left: 16px;
    padding-right: 16px;
    spacing: 10px;
    @children
}

export component TableHeading inherits Rectangle {
    height: 36px;
    background: Theme.field;
    @children
}

export component SessionCard inherits SurfaceCard {
    in property <string> status;
    in property <string> uptime;
    in property <bool> active;
    in property <bool> error;
    preferred-width: 0px;
    horizontal-stretch: 1.8;
    HorizontalLayout { padding: 16px; spacing: 10px;
        Rectangle { width: 12px; Rectangle { width: 12px; height: 12px; y: (parent.height - self.height) / 2; border-radius: 6px; background: root.error ? Theme.danger : root.active ? Theme.accent : Theme.warning; } }
        Text { text: root.status; color: Theme.text; font-size: 15px; font-weight: 600; min-width: 0px; wrap: word-wrap; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
        Text { text: "Session  " + root.uptime; color: Theme.secondary; font-size: 11px; vertical-alignment: center; }
    }
}

export component MetricCard inherits SurfaceCard {
    in property <string> value;
    in property <string> label;
    preferred-width: 0px;
    horizontal-stretch: 1;
    VerticalLayout {
        padding-left: 18px; padding-right: 18px;
        padding-top: 10px; padding-bottom: 10px; spacing: 2px; alignment: center;
        Text { text: root.value; color: Theme.text; font-size: 24px; font-weight: 600; min-width: 0px; overflow: elide; height: 28px; vertical-alignment: center; }
        Text { text: root.label; color: Theme.secondary; font-size: 12px; min-width: 0px; overflow: elide; height: 16px; vertical-alignment: center; }
    }
}

// Shared Lucide outline icons. The product mark remains our own vector.
export component UiIcon inherits Rectangle {
    in property <string> name;
    in property <color> ink: Theme.secondary;
    width: 18px; height: 18px;
    accessible-role: none;
    if root.name == "brand": Path {
        width: parent.width; height: parent.height;
        viewbox-width: 24; viewbox-height: 24;
        stroke: root.ink; stroke-width: 1.8px;
        commands: "M3 7 H21 M15 1 L21 7 L15 13 M21 17 H3 M9 11 L3 17 L9 23";
    }
    if root.name != "" && root.name != "brand": IconGlyph {
        name: root.name; ink: root.ink;
        width: parent.width; height: parent.height;
    }
}

// A single shell for settings, profile and module panels on every page.


export component EmptyState inherits Rectangle {
    in property <string> title;
    in property <string> caption;
    in property <string> icon: "search";
    height: max(132px, content.preferred-height);
    content := VerticalLayout {
        padding: 24px; spacing: 8px; alignment: center;
        HorizontalLayout { alignment: center; UiIcon { name: root.icon; width: 26px; height: 26px; ink: Theme.muted; } }
        Text { text: root.title; color: Theme.secondary; font-size: 14px; horizontal-alignment: center; wrap: word-wrap; height: self.preferred-height; }
        if root.caption != "": Text { text: root.caption; color: Theme.muted; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; height: self.preferred-height; }
    }
}

export component ActionButton inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> icon-only: false;
    in property <bool> trailing-icon: false;
    in property <bool> primary: false;
    in property <bool> quiet: false;
    in property <bool> enabled: true;
    in property <length> content-min-width: 38px;
    in property <color> ink: !root.enabled ? Theme.disabled-text : root.primary ? Theme.primary-text : Theme.text;
    in property <color> icon-ink: root.ink;
    in property <color> outline: Theme.border;
    callback clicked;
    min-width: root.icon-only ? 36px : max(root.content-min-width, label-text.preferred-width + 26px + (root.icon == "" ? 0px : 23px)); max-width: self.min-width;
    height: 40px; horizontal-stretch: 0; vertical-stretch: 0;
    border-radius: Theme.radius-small; border-width: 1px;
    border-color: focus.has-focus ? Theme.accent : root.primary || root.quiet ? transparent : root.outline;
    background: !root.enabled ? (root.quiet ? transparent : Theme.disabled) : root.primary
        ? (touch.pressed ? Theme.primary-pressed : touch.has-hover ? Theme.primary-hover : Theme.primary)
        : (touch.pressed ? Theme.pressed : touch.has-hover ? Theme.surface-hover : root.quiet ? transparent : Theme.surface);
    animate background, border-color { duration: 100ms; }
    accessible-role: button; accessible-label: root.label; accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: focus;
    if root.icon-only && root.icon != "": UiIcon {
        name: root.icon;
        ink: root.icon-ink;
        width: 16px;
        height: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    HorizontalLayout {
        alignment: center;
        spacing: root.icon-only || root.label == "" ? 0px : 6px;
        if !root.icon-only && !root.trailing-icon && root.icon != "": Rectangle {
            width: 16px;
            UiIcon { name: root.icon; ink: root.icon-ink; width: 16px; height: 16px; y: (parent.height - self.height) / 2; }
        }
        label-text := Text { text: root.icon-only ? "" : root.label; color: root.ink; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; accessible-role: none; min-width: 0px; overflow: elide; }
        if !root.icon-only && root.trailing-icon && root.icon != "": Rectangle {
            width: 16px;
            UiIcon { name: root.icon; ink: root.icon-ink; width: 16px; height: 16px; y: (parent.height - self.height) / 2; }
        }
    }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
    // Like Slint's standard Button: keyboard focus must not cover the pointer target.
    focus := FocusScope { width: 0px; enabled: root.enabled; key-pressed(event) => { if event.text == Key.Space || event.text == Key.Return { root.clicked(); return accept; } return reject; } }
}

// Shared navigation link, kept on the same pointer/keyboard implementation.
export component TextLink inherits ActionButton {
    quiet: true; icon: "external"; trailing-icon: true;
    height: 30px;
}

export component FormCard inherits SurfaceCard {
    in property <string> title;
    in property <string> caption;
    in property <string> icon;
    in property <string> version;
    in property <string> action-label;
    in property <string> action-icon: "external";
    in property <bool> action-enabled: true;
    in property <string> action-accessibility: root.action-label;
    callback action;
    out property <length> content-height: content.preferred-height;
    height: root.content-height;
    vertical-stretch: 0;
    content := VerticalLayout {
        padding: 20px; spacing: 16px; alignment: start;
        if root.title != "": HorizontalLayout {
            height: max(40px, heading.preferred-height);
            spacing: 12px;
            if root.icon != "": Rectangle {
                width: 40px;
                Rectangle { height: 40px; y: (parent.height - self.height) / 2;
                    background: Theme.field; border-radius: 12px;
                    UiIcon { name: root.icon; ink: Theme.text; width: 20px; height: 20px; x: 10px; y: 10px; }
                }
            }
            heading := VerticalLayout {
                alignment: center; spacing: 4px; min-width: 0px; horizontal-stretch: 1;
                HorizontalLayout { spacing: 8px; alignment: start;
                    Text { text: root.title; color: Theme.text; font-size: 18px; font-weight: 600; min-width: 0px; overflow: elide; horizontal-stretch: 0; vertical-alignment: center; }
                    if root.version != "": Text { text: root.version; color: Theme.muted; font-size: 12px; vertical-alignment: center; horizontal-stretch: 0; }
                }
                if root.caption != "": Text { text: root.caption; color: Theme.secondary; font-size: 12px; min-width: 0px; wrap: word-wrap; height: self.preferred-height; }
            }
            if root.action-label != "": Rectangle {
                width: action-link.min-width;
                action-link := TextLink { x: 0px; y: 0px; label: root.action-label; icon: root.action-icon; enabled: root.action-enabled; accessible-label: root.action-accessibility; clicked => { root.action(); } }
            }
        }
        @children
    }
}

// Full upstream notices are available even in the standalone executable.
export component IconLicenseButton inherits ActionButton {
    label: "Icon licenses"; icon: "file";
    clicked => { licenses.show(); }
    licenses := PopupWindow {
        width: 480px; height: 280px;
        x: root.width - self.width;
        y: root.absolute-position.y >= 288px ? -self.height - 8px : root.height + 8px;
        Rectangle { background: Theme.surface; border-radius: Theme.radius-medium; border-width: 1px; border-color: Theme.border;
            VerticalLayout { padding: 16px; spacing: 10px;
                HorizontalLayout { height: 30px;
                    Text { text: "Lucide / Feather licenses"; font-size: 15px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                    ActionButton { label: "Close icon licenses"; icon: "close"; icon-only: true; quiet: true; height: 28px; min-width: 28px; max-width: 28px; clicked => { licenses.close(); } }
                }
                ScrollView { horizontal-scrollbar-policy: always-off; content-width: self.visible-width; content-height: notice.preferred-height;
                    notice := Text { text: IconLicense.text; color: Theme.secondary; font-size: 11px; wrap: word-wrap; height: self.preferred-height; }
                }
            }
        }
    }
}

export component SegmentButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <color> selected-color: Theme.primary;
    in property <color> resting-color: transparent;
    callback clicked;

    width: max(28px, caption.preferred-width + 16px);
    height: 28px;
    border-radius: 8px;
    border-width: focus.has-focus ? 1px : 0px;
    border-color: Theme.accent-hover;
    background: root.selected ? root.selected-color : touch.has-hover ? Theme.surface-hover : root.resting-color;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    caption := Text {
        text: root.label;
        color: root.selected ? Theme.primary-text : Theme.secondary;
        font-size: 11px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
    focus := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    forward-focus: focus;
}

export component PageAction inherits ActionButton {
    content-min-width: 122px;
    height: 43px;
    icon-ink: Theme.accent;
    outline: Theme.dark ? Theme.switch-off : Theme.border;
}

export component PageHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> subtitle;
    in property <string> action-label;
    in property <string> action-icon;
    in property <string> action-accessibility: root.action-label;
    in property <bool> action-enabled: true;
    in property <string> badge;
    callback action;
    height: root.subtitle == "" ? 44px : 62px;
    vertical-stretch: 0;
    spacing: 14px;
    VerticalLayout {
        min-width: 0px; horizontal-stretch: 1; spacing: 4px; alignment: center;
        Text { text: root.title; color: Theme.text; font-size: 30px; font-weight: 700; min-width: 0px; overflow: elide; height: 36px; vertical-alignment: center; }
        if root.subtitle != "": Text { text: root.subtitle; color: Theme.secondary; font-size: 13px; min-width: 0px; overflow: elide; height: 18px; vertical-alignment: center; }
    }
    if root.badge != "": Rectangle {
        width: 92px;
        Rectangle { height: 24px; y: (parent.height - self.height) / 2; border-radius: 12px; background: Theme.accent-soft;
            Text { text: root.badge; color: Theme.accent; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
    if root.action-label != "": Rectangle {
        width: button.min-width;
        button := PageAction { label: root.action-label; icon: root.action-icon; accessible-label: root.action-accessibility; enabled: root.action-enabled; y: (parent.height - self.height) / 2; clicked => { root.action(); } }
    }
}

export component SectionHeading inherits HorizontalLayout {
    in property <string> title;
    in property <string> action-label: "View all";
    in property <string> action-accessibility;
    callback open;
    height: 30px;
    Text { text: root.title; color: Theme.text; font-size: 19px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
    TextLink { label: root.action-label; accessible-label: root.action-accessibility; clicked => { root.open(); } }
}

export component RuleSwitch inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <bool> fixed: false;
    in property <string> label;
    in property <length> track-width: 42px;
    callback toggled;
    width: 44px; height: 38px;
    opacity: root.enabled || root.fixed ? 1 : 0.45;
    Rectangle { y: (parent.height - self.height) / 2; x: (parent.width - self.width) / 2; width: root.track-width; height: 24px; border-radius: 12px; background: root.checked && root.fixed ? Theme.accent-soft : root.checked && root.enabled ? Theme.primary : Theme.switch-off;
        border-width: focus.has-focus ? 1px : 0px; border-color: Theme.text;
        Rectangle { x: root.checked ? parent.width - self.width - 3px : 3px; y: 3px; width: 18px; height: 18px; border-radius: 9px; background: root.fixed ? Theme.secondary : root.checked && root.enabled ? Theme.switch-on-thumb : Theme.switch-off-thumb; animate x { duration: 100ms; } }
    }
    TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); root.toggled(); } }
    focus := FocusScope { width: 0px; enabled: root.enabled; key-pressed(event) => { if event.text == Key.Space || event.text == Key.Return { root.toggled(); return accept; } return reject; } }
    forward-focus: focus;
    accessible-role: switch; accessible-label: root.label; accessible-checked: root.checked; accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.toggled(); } }
}

export component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in property <string> icon;
    in property <bool> secret: false;
    in property <length> field-height: 40px;
    in-out property <string> value;
    spacing: 6px;
    alignment: start;
    min-width: 0px;
    vertical-stretch: 0;
    callback edited;
    callback accepted;
    if root.label != "": Text { text: root.label; font-size: 13px; font-weight: 500; color: Theme.secondary; }
    Rectangle {
        height: root.field-height;
        border-radius: Theme.radius-small;
        border-width: 1px;
        border-color: input.has-focus ? Theme.accent : Theme.border;
        background: Theme.field;
        property <length> inset: root.icon == "" ? 12px : 36px;
        if root.icon != "": UiIcon { name: root.icon; x: 12px; y: (parent.height - self.height) / 2; width: 16px; height: 16px; }
        if root.value == "": Text { x: parent.inset; width: parent.width - parent.inset - 12px; text: root.placeholder; font-size: 13px; color: Theme.muted; vertical-alignment: center; overflow: elide; }
        input := TextInput { x: parent.inset; width: parent.width - parent.inset - 12px; height: parent.height; text <=> root.value; font-size: 13px; color: Theme.text; selection-background-color: Theme.selection; selection-foreground-color: Theme.text; single-line: true; vertical-alignment: center; input-type: root.secret ? InputType.password : InputType.text; accessible-label: root.label != "" ? root.label : root.placeholder; edited => { root.edited(); } accepted => { root.accepted(); } }
    }
}

export component DialogHeader inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> icon;
    callback close;
    height: 70px;
    background: Theme.field;
    border-radius: Theme.radius-large;
    Rectangle { y: parent.height / 2; height: parent.height / 2; background: Theme.field; }
    HorizontalLayout {
        padding-left: 20px;
        padding-right: 18px;
        spacing: 14px;
        Rectangle {
            width: 40px;
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 40px; height: 40px;
                border-radius: Theme.radius-small;
                background: Theme.accent-soft;
                UiIcon { name: root.icon; ink: Theme.accent; x: 10px; y: 10px; width: 20px; height: 20px; }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Text { text: root.title; color: Theme.text; font-size: 18px; font-weight: 650; min-width: 0px; overflow: elide; }
            Text { text: root.subtitle; color: Theme.muted; font-size: 12px; min-width: 0px; overflow: elide; }
        }
        Rectangle {
            width: 34px;
            ActionButton {
                label: "Close"; icon: "close"; icon-only: true;
                y: (parent.height - self.height) / 2;
                min-width: 34px; max-width: 34px; height: 34px;
                clicked => { root.close(); }
            }
        }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
}

export component DialogActions inherits Rectangle {
    height: 64px;
    background: Theme.field;
    border-radius: Theme.radius-large;
    Rectangle { y: 0px; height: parent.height / 2; background: Theme.field; }
    Rectangle { y: 0px; height: 1px; background: Theme.border; }
    HorizontalLayout { padding: 12px; spacing: 9px; alignment: end; @children }
}

export component ThemedComboBox inherits Rectangle {
    in property <[string]> model;
    in property <bool> enabled: true;
    in-out property <int> current-index: 0;
    border-radius: Theme.radius-small;
    background: root.enabled ? Theme.field : Theme.disabled;
    clip: true;
    min-height: 34px;
    min-width: 0px;
    horizontal-stretch: 1;
    forward-focus: control;

    // Keep Slint's keyboard navigation and accessibility for the selector.
    control := ComboBox {
        width: parent.width;
        height: parent.height;
        model: root.model;
        enabled: root.enabled;
        current-index <=> root.current-index;
    }
}

component CheckMark inherits Rectangle {
    in property <bool> checked;
    in property <bool> focused;
    width: 16px;
    height: 16px;
    border-radius: 5px;
    border-width: 1px;
    border-color: root.focused ? Theme.accent-hover : root.checked ? Theme.primary : Theme.muted;
    background: root.checked ? Theme.primary : Theme.field;
    if root.checked: Path {
        x: 3px; y: 3px; width: 10px; height: 10px;
        viewbox-width: 10; viewbox-height: 10;
        stroke: Theme.primary-text; stroke-width: 1.6px;
        commands: "M1 5 L4 8 L9 2";
    }
}

export component ThemedCheckBox inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in-out property <bool> checked;
    callback toggled;
    min-width: 0px;
    height: 28px;
    border-radius: Theme.radius-small;
    background: root.enabled && touch.has-hover ? Theme.surface-hover : transparent;
    opacity: root.enabled ? 1 : 0.65;
    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-checked: root.checked;
    accessible-action-default => { root.toggle(); }
    forward-focus: focus;

    function toggle() {
        if root.enabled {
            root.checked = !root.checked;
            root.toggled();
        }
    }

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 8px;
        Rectangle {
            width: 16px;
            CheckMark { y: (parent.height - self.height) / 2; checked: root.checked; focused: focus.has-focus; }
        }
        Text { text: root.text; color: Theme.text; font-size: 12px; min-width: 0px; overflow: elide; vertical-alignment: center; accessible-role: none; }
    }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); root.toggle(); } }
    focus := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return { root.toggle(); return accept; }
            return reject;
        }
    }
}

export component ConnectionFilterCheck inherits Rectangle {
    in property <ConnectionFilterOption> option;
    in property <string> scope;
    callback toggled(bool);
    height: 28px; min-width: 0px; horizontal-stretch: 0;
    border-radius: Theme.radius-small;
    background: touch.has-hover ? Theme.surface-hover : transparent;
    accessible-role: checkbox; accessible-label: root.scope + ": " + root.option.label; accessible-checked: root.option.checked;
    accessible-action-default => { root.toggled(!root.option.checked); }
    forward-focus: focus;
    HorizontalLayout { padding-left: 5px; padding-right: 5px; spacing: 7px;
        Rectangle { width: 16px;
            CheckMark { y: (parent.height - self.height) / 2; checked: root.option.checked; focused: focus.has-focus; }
        }
        Text { text: root.option.label; color: Theme.secondary; font-size: 11px; min-width: 0px; overflow: elide; vertical-alignment: center; accessible-role: none; }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.toggled(!root.option.checked); } }
    focus := FocusScope { width: 0px; key-pressed(event) => { if event.text == Key.Space || event.text == Key.Return { root.toggled(!root.option.checked); return accept; } return reject; } }
}
