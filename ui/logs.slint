import { ScrollView } from "std-widgets.slint";
import { Theme } from "common.slint";

export global TechnicalLogs {
    in property <string> text;
    in property <int> total;
    in property <int> visible-count;
    in property <bool> recording;
    in-out property <int> verbosity: 0;
    in-out property <bool> errors-only: false;
    in-out property <int> source: 0;
    in-out property <bool> follow: false;
    callback filter;
    callback set-recording(bool);
    callback clear;
}

component LogFilterButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <color> selected-color: Theme.primary;
    in property <color> resting-color: transparent;
    callback clicked;

    width: max(28px, caption.preferred-width + 16px);
    height: 26px;
    border-radius: 6px;
    border-width: focus.has-focus ? 1px : 0px;
    border-color: Theme.accent-hover;
    background: root.selected ? root.selected-color : touch.has-hover ? Theme.surface-hover : root.resting-color;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    caption := Text {
        text: root.label;
        color: root.selected ? Theme.primary-text : Theme.secondary;
        font-size: 11px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
    focus := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    forward-focus: focus;
}

component LogFilterGroup inherits Rectangle {
    width: filters.preferred-width;
    height: 30px;
    border-radius: Theme.radius-small;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.field;

    filters := HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        @children
    }
}

export component LogStreamView inherits Rectangle {
    in property <string> title: "Live log stream";
    in property <string> backend-label: "Backend";
    in property <string> connections-label: "Connections";
    in property <string> latest-text;
    in property <int> total;
    in property <int> visible-count;
    in property <bool> recording;
    in-out property <int> verbosity;
    in-out property <bool> errors-only;
    in-out property <int> source;
    in-out property <bool> follow;
    callback filter;
    callback set-recording(bool);
    callback clear;
    private property <string> displayed-text;
    private property <bool> selecting: log-text.has-focus && log-text.cursor-position-byte-offset != log-text.anchor-position-byte-offset;
    vertical-stretch: 1;
    min-width: 0px;
    min-height: 0px;
    border-radius: Theme.radius-medium;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;
    clip: true;

    function follow-latest() {
        if root.follow && !root.selecting {
            log-scroll.content-y = min(0px, log-scroll.visible-height - log-scroll.content-height);
        }
    }
    function refresh-text() {
        // Keep selected offsets meaningful even when the ring evicts old lines.
        if !root.selecting {
            root.displayed-text = root.latest-text;
        }
    }
    init => { root.refresh-text(); root.follow-latest(); }
    changed latest-text => { root.refresh-text(); }
    changed selecting => { root.refresh-text(); }
    changed displayed-text => { root.follow-latest(); }
    changed follow => { root.follow-latest(); }
    changed height => { root.follow-latest(); }

    VerticalLayout {
        HorizontalLayout {
            height: 40px;
            padding-left: 14px;
            padding-right: 14px;
            spacing: 10px;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: 14px;
                font-weight: 600;
                vertical-alignment: center;
            }
            Text {
                text: root.visible-count == root.total
                    ? "latest " + root.total + " lines"
                    : root.visible-count + " of " + root.total + " lines";
                color: Theme.muted;
                font-family: "Consolas";
                font-size: 11px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            LogFilterButton {
                y: (parent.height - self.height) / 2;
                label: "Clear";
                resting-color: Theme.field;
                clicked => { log-text.clear-selection(); root.clear(); }
            }
            LogFilterButton {
                y: (parent.height - self.height) / 2;
                label: root.recording ? "Pause" : "Start";
                selected: root.recording;
                selected-color: Theme.success;
                resting-color: Theme.field;
                clicked => { root.set-recording(!root.recording); }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }
        HorizontalLayout {
            height: 44px;
            padding-left: 14px;
            padding-right: 14px;
            spacing: 8px;
            LogFilterGroup {
                y: (parent.height - self.height) / 2;
                LogFilterButton {
                    label: "Normal";
                    selected: root.verbosity == 0;
                    clicked => { root.verbosity = 0; root.filter(); }
                }
                LogFilterButton {
                    label: "Verbose";
                    selected: root.verbosity == 1;
                    clicked => { root.verbosity = 1; root.filter(); }
                }
            }
            LogFilterGroup {
                y: (parent.height - self.height) / 2;
                LogFilterButton {
                    label: "All";
                    selected: !root.errors-only;
                    clicked => { root.errors-only = false; root.filter(); }
                }
                LogFilterButton {
                    label: "Error";
                    selected: root.errors-only;
                    clicked => { root.errors-only = true; root.filter(); }
                }
            }
            LogFilterGroup {
                y: (parent.height - self.height) / 2;
                LogFilterButton {
                    label: "All sources";
                    selected: root.source == 0;
                    clicked => { root.source = 0; root.filter(); }
                }
                LogFilterButton {
                    label: root.backend-label;
                    selected: root.source == 1;
                    clicked => { root.source = 1; root.filter(); }
                }
                LogFilterButton {
                    label: root.connections-label;
                    selected: root.source == 2;
                    accessible-label: "Log source Connections";
                    clicked => { root.source = 2; root.filter(); }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            LogFilterButton {
                y: (parent.height - self.height) / 2;
                label: root.follow ? "Follow: On" : "Follow: Off";
                selected: root.follow;
                selected-color: Theme.success;
                resting-color: Theme.field;
                clicked => { root.follow = !root.follow; }
            }
        }
        log-scroll := ScrollView {
            min-height: 0px;
            horizontal-scrollbar-policy: always-off;
            content-width: self.visible-width;
            content-height: max(self.visible-height, log-text.preferred-height + 16px);

            if root.displayed-text == "": Text {
                x: 14px;
                y: 8px;
                height: 24px;
                text: root.total == 0 ? "No log entries yet" : "No matching log entries";
                color: Theme.muted;
                font-size: 12px;
                vertical-alignment: center;
            }
            log-text := TextInput {
                x: 14px;
                y: 8px;
                width: max(0px, log-scroll.visible-width - 28px - Theme.scroll-gutter);
                height: max(self.preferred-height, log-scroll.visible-height - 16px);
                visible: root.displayed-text != "";
                text: root.displayed-text;
                read-only: true;
                single-line: false;
                wrap: word-wrap;
                font-family: "Consolas";
                font-size: 12px;
                line-height-factor: 1.35;
                color: Theme.text;
                selection-background-color: Theme.selection;
                selection-foreground-color: Theme.text;
                page-height: log-scroll.visible-height;
                accessible-label: "Log text";
                cursor-position-changed(cpos) => {
                    if self.has-focus {
                        if cpos.y + self.y + log-scroll.content-y < 8px {
                            log-scroll.content-y = min(0px, -cpos.y);
                        } else if cpos.y + self.y + log-scroll.content-y > log-scroll.visible-height - 24px {
                            log-scroll.content-y = min(0px, log-scroll.visible-height - 24px - cpos.y - self.y);
                        }
                    }
                }
            }
        }
    }
}

export component LogsView inherits LogStreamView {
    latest-text: TechnicalLogs.text;
    total: TechnicalLogs.total;
    visible-count: TechnicalLogs.visible-count;
    recording: TechnicalLogs.recording;
    verbosity <=> TechnicalLogs.verbosity;
    errors-only <=> TechnicalLogs.errors-only;
    source <=> TechnicalLogs.source;
    follow <=> TechnicalLogs.follow;
    filter => { TechnicalLogs.filter(); }
    set-recording(record) => { TechnicalLogs.set-recording(record); }
    clear => { TechnicalLogs.clear(); }
}
