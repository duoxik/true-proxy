// Lucide SVG subset, pinned source and full license: assets/icons/lucide/.
// Images are embedded by Slint; no runtime file or network access.
export component IconGlyph inherits Image {
    in property <string> name;
    in property <color> ink;
    image-fit: contain;
    colorize: root.ink;
    source: root.lookup(root.name);
    pure function lookup(name: string) -> image {
        if name == "dashboard" { return @image-url("../assets/icons/lucide/layout-grid.svg"); }
        if name == "server" { return @image-url("../assets/icons/lucide/server.svg"); }
        if name == "rules" { return @image-url("../assets/icons/lucide/list-filter.svg"); }
        if name == "activity" { return @image-url("../assets/icons/lucide/activity.svg"); }
        if name == "settings" { return @image-url("../assets/icons/lucide/settings.svg"); }
        if name == "plus" { return @image-url("../assets/icons/lucide/plus.svg"); }
        if name == "more" { return @image-url("../assets/icons/lucide/ellipsis.svg"); }
        if name == "grip" { return @image-url("../assets/icons/lucide/grip-vertical.svg"); }
        if name == "play" { return @image-url("../assets/icons/lucide/play.svg"); }
        if name == "stop" { return @image-url("../assets/icons/lucide/square.svg"); }
        if name == "edit" { return @image-url("../assets/icons/lucide/square-pen.svg"); }
        if name == "trash" { return @image-url("../assets/icons/lucide/trash.svg"); }
        if name == "chevron-up" { return @image-url("../assets/icons/lucide/chevron-up.svg"); }
        if name == "chevron-down" { return @image-url("../assets/icons/lucide/chevron-down.svg"); }
        if name == "chevron-right" { return @image-url("../assets/icons/lucide/chevron-right.svg"); }
        if name == "lock" { return @image-url("../assets/icons/lucide/lock-keyhole.svg"); }
        if name == "clock" { return @image-url("../assets/icons/lucide/clock-3.svg"); }
        if name == "shield" { return @image-url("../assets/icons/lucide/shield-check.svg"); }
        if name == "check" { return @image-url("../assets/icons/lucide/check.svg"); }
        if name == "search" { return @image-url("../assets/icons/lucide/search.svg"); }
        if name == "close" { return @image-url("../assets/icons/lucide/x.svg"); }
        if name == "refresh" { return @image-url("../assets/icons/lucide/refresh-cw.svg"); }
        if name == "reset" { return @image-url("../assets/icons/lucide/undo-2.svg"); }
        if name == "arrow-right" { return @image-url("../assets/icons/lucide/arrow-right.svg"); }
        if name == "direct" { return @image-url("../assets/icons/lucide/arrow-up-right.svg"); }
        if name == "external" { return @image-url("../assets/icons/lucide/arrow-up-right.svg"); }
        if name == "arrow-up" { return @image-url("../assets/icons/lucide/arrow-up.svg"); }
        if name == "arrow-down" { return @image-url("../assets/icons/lucide/arrow-down.svg"); }
        if name == "upload" { return @image-url("../assets/icons/lucide/upload.svg"); }
        if name == "download" { return @image-url("../assets/icons/lucide/download.svg"); }
        if name == "block" { return @image-url("../assets/icons/lucide/ban.svg"); }
        if name == "globe" { return @image-url("../assets/icons/lucide/globe.svg"); }
        if name == "file" { return @image-url("../assets/icons/lucide/file-text.svg"); }
        if name == "app" { return @image-url("../assets/icons/lucide/app-window.svg"); }
        if name == "sun" { return @image-url("../assets/icons/lucide/sun.svg"); }
        if name == "moon" { return @image-url("../assets/icons/lucide/moon.svg"); }
        if name == "power" { return @image-url("../assets/icons/lucide/power.svg"); }
        if name == "files" { return @image-url("../assets/icons/lucide/files.svg"); }
        if name == "boxes" { return @image-url("../assets/icons/lucide/boxes.svg"); }
        if name == "network" { return @image-url("../assets/icons/lucide/network.svg"); }
        if name == "route" { return @image-url("../assets/icons/lucide/route.svg"); }
        if name == "link" { return @image-url("../assets/icons/lucide/link.svg"); }
        if name == "info" { return @image-url("../assets/icons/lucide/info.svg"); }
        if name == "bell" { return @image-url("../assets/icons/lucide/bell.svg"); }
        return @image-url("");
    }
}
