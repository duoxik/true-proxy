import { ScrollView } from "std-widgets.slint";
import { PageHeader, FormCard, EmptyState, SurfaceCard, PanelToolbar, TableHeading, SessionCard, MetricCard, SectionHeading, ActionButton, Field, RuleSwitch, Theme, UiIcon } from "common.slint";
import { LogStreamView } from "logs.slint";

export struct XrayProfileRow { id: string, name: string, summary: string, active: bool }
export struct XraySubscriptionGroup { id: string, name: string, profiles: [XrayProfileRow] }
export struct XrayHostRow { host: string, address: string }
export struct XrayConnectionRow { time: string, protocol: string, destination: string, observed-domain: string, source: string, route: string, detail: string }

export global XrayModule {
    in property <bool> installed;
    in property <bool> hpwnr-installed;
    in property <string> hpwnr-version;
    in property <string> hpwnr-latest-version;
    in property <string> hpwnr-update-status;
    in-out property <bool> hpwnr-required;
    in property <string> hpwnr-error;
    in property <bool> busy;
    in property <bool> running;
    in property <bool> pending;
    in property <bool> settings-saving;
    in property <int> settings-revision;
    in property <string> settings-error;
    in property <string> version;
    in property <string> latest-version;
    in property <string> status;
    in property <string> error;
    in property <string> module-error;
    in property <string> uptime: "00:00:00";
    in property <int> connection-count;
    in property <string> upload: "0";
    in property <string> download: "0";
    in property <[XrayProfileRow]> profiles;
    in property <XrayProfileRow> selected-profile;
    in property <[XraySubscriptionGroup]> subscriptions;
    in-out property <string> profile-input;
    in-out property <string> port: "2081";
    in property <string> listener-port: "2081";
    in-out property <string> dns: "Default";
    in property <[XrayHostRow]> hosts;
    in property <[string]> geo-ip-selected;
    in property <[string]> geo-site-selected;
    in property <[string]> geo-ip-suggestions;
    in property <[string]> geo-site-suggestions;
    in-out property <string> geo-ip-query;
    in-out property <string> geo-site-query;
    in-out property <string> geo-ip-url;
    in-out property <string> geo-site-url;
    in-out property <string> geo-refresh-hours;
    in property <string> geo-status;
    in property <[XrayConnectionRow]> connections;
    in property <int> connection-total;
    in-out property <string> connection-query;
    in property <string> log-text;
    in property <int> log-total;
    in property <int> log-visible-count;
    in property <bool> log-recording;
    in-out property <int> log-verbosity;
    in-out property <int> log-source;
    in-out property <bool> log-errors-only;
    in-out property <bool> log-follow;
    in-out property <int> section;

    callback install;
    callback check-updates;
    callback install-update;
    callback toggle;
    callback restart;
    callback import-profile(string);
    callback install-hpwnr;
    callback check-hpwnr-updates;
    callback update-hpwnr;
    callback confirm-hpwnr;
    callback cancel-hpwnr;
    callback refresh-subscription(string);
    callback activate-profile(string);
    callback remove-profile(string);
    callback settings-edited;
    callback commit-settings;
    callback refresh-hosts;
    callback filter-geo-tags(bool, string);
    callback select-geo-tag(bool, string);
    callback remove-geo-tag(bool, string);
    callback refresh-geo;
    callback refresh-activity;
    callback filter-connections;
    callback clear-connections;
    callback filter-logs;
    callback set-log-recording(bool);
    callback clear-logs;
}

component XrayNote inherits Text {
    color: Theme.secondary;
    font-size: 12px;
    min-width: 0px;
    wrap: word-wrap;
    height: self.preferred-height;
}

component XrayCard inherits FormCard {}

component XrayNotice inherits Rectangle {
    in property <string> message;
    in property <bool> error;
    min-width: 0px;
    height: notice.preferred-height;
    vertical-stretch: 0;
    border-radius: Theme.radius-small;
    background: root.error ? Theme.danger-soft : Theme.accent-soft;
    notice := VerticalLayout {
        padding: 10px;
        XrayNote { text: root.message; color: root.error ? Theme.danger : Theme.text; }
    }
}

export component XrayModuleCard inherits XrayCard {
    title: "Xray-core"; icon: "boxes";
    version: XrayModule.version;
    action-label: XrayModule.installed ? "Check for Updates" : "";
    action-icon: "refresh";
    action-enabled: !XrayModule.busy;
    action => { XrayModule.check-updates(); }
    caption: "Adds a managed local SOCKS5 listener and VLESS profiles. The Xray-core executable is downloaded separately.";
    if !XrayModule.installed: HorizontalLayout {
        spacing: 8px;
        alignment: start;
        if !XrayModule.installed: ActionButton {
            label: XrayModule.busy ? "Installing…" : "Install Xray-core";
            icon: "download";
            primary: true;
            enabled: !XrayModule.busy;
            clicked => { XrayModule.install(); }
        }

    }
    if XrayModule.installed && XrayModule.latest-version != "" && XrayModule.latest-version != XrayModule.version: HorizontalLayout {
        spacing: 8px;
        alignment: start;
        if XrayModule.latest-version != "" && XrayModule.latest-version != XrayModule.version: ActionButton {
            label: "Install " + XrayModule.latest-version;
            icon: "download";
            primary: true;
            enabled: !XrayModule.running && !XrayModule.busy;
            clicked => { XrayModule.install-update(); }
        }
    }
    if XrayModule.running && XrayModule.latest-version != "" && XrayModule.latest-version != XrayModule.version: XrayNote {
        text: "Stop Xray to install the update.";
    }
    if XrayModule.module-error != "": XrayNotice { message: XrayModule.module-error; error: true; }
}

export component HpwnrModuleCard inherits XrayCard {
    title: "hpwnr"; icon: "lock";
    version: XrayModule.hpwnr-version;
    action-label: XrayModule.hpwnr-installed ? "Check for Updates" : "";
    action-icon: "refresh";
    action-accessibility: "Check for hpwnr updates";
    action-enabled: !XrayModule.busy;
    action => { XrayModule.check-hpwnr-updates(); }
    caption: "Imports encrypted v2RayTun links. Decryption runs locally; the module is downloaded separately.";
    if !XrayModule.hpwnr-installed || XrayModule.hpwnr-latest-version != "": HorizontalLayout { spacing: 12px; alignment: start;
        if !XrayModule.hpwnr-installed: ActionButton {
            label: "Install hpwnr"; icon: "download"; primary: true;
            enabled: !XrayModule.busy;
            clicked => { XrayModule.install-hpwnr(); }
        }
        if XrayModule.hpwnr-latest-version != "": ActionButton {
            label: "Install " + XrayModule.hpwnr-latest-version; icon: "download"; primary: true;
            enabled: !XrayModule.busy; clicked => { XrayModule.update-hpwnr(); }
        }
    }
    if XrayModule.hpwnr-update-status != "": XrayNote { text: XrayModule.hpwnr-update-status; }
    if XrayModule.hpwnr-error != "": XrayNotice { message: XrayModule.hpwnr-error; error: true; }
}

component XrayProfileItem inherits Rectangle {
    in property <XrayProfileRow> profile;
    in property <bool> compact;
    height: 54px;
    border-radius: Theme.radius-small;
    border-width: 1px;
    border-color: Theme.border;
    background: root.profile.active ? Theme.surface-hover : Theme.field;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            min-width: 0px;
            horizontal-stretch: 1;
            spacing: 3px;
            Text { text: root.profile.name; color: Theme.text; font-size: 13px; font-weight: 600; overflow: elide; }
            Text { text: root.profile.summary; color: Theme.muted; font-size: 11px; overflow: elide; }
        }
        if root.compact: Text {
            text: root.profile.active ? "Selected" : "Available";
            color: root.profile.active ? Theme.accent : Theme.muted;
            font-size: 11px;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
        Rectangle {
            width: 44px;
            RuleSwitch {
                label: "Activate " + root.profile.name;
                checked: root.profile.active;
                enabled: !XrayModule.busy;
                y: (parent.height - self.height) / 2;
                toggled => { XrayModule.activate-profile(root.profile.id); }
            }
        }
        if !root.compact: Rectangle {
            width: delete.min-width;
            delete := ActionButton {
                label: "Remove " + root.profile.name;
                icon: "trash";
                icon-only: true;
                y: (parent.height - self.height) / 2;
                enabled: !XrayModule.busy;
                clicked => { XrayModule.remove-profile(root.profile.id); }
            }
        }
    }
}

component XrayDetail inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    height: 24px;
    spacing: 12px;
    Text { text: root.label; color: Theme.secondary; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
    Text { text: root.value; color: Theme.text; font-size: 12px; vertical-alignment: center; min-width: 0px; overflow: elide; horizontal-alignment: right; }
}

component XrayDashboard inherits VerticalLayout {
    callback open-profiles;
    callback open-general;
    private property <bool> has-profiles: XrayModule.profiles.length > 0 || XrayModule.subscriptions.length > 0;
    alignment: start;
    spacing: 20px;
    HorizontalLayout {
        height: 70px; spacing: 20px;
        SessionCard {
            active: XrayModule.running;
            error: XrayModule.error != "";
            status: XrayModule.error != "" ? "Xray error" : XrayModule.running ? "Xray running" : XrayModule.busy ? "Working…" : "Xray stopped";
            uptime: XrayModule.uptime;
        }
        MetricCard { value: XrayModule.connection-count; label: "Accepted events"; }
        MetricCard { value: XrayModule.upload; label: "VLESS events"; }
        MetricCard { value: XrayModule.download; label: "Direct events"; }
    }
    HorizontalLayout {
        spacing: 24px;
        SurfaceCard {
            preferred-width: 0px; horizontal-stretch: 1.2; height: 224px;
            VerticalLayout { padding: 18px; spacing: 10px; alignment: start;
                SectionHeading { title: "Selected profile"; action-label: "Change"; action-accessibility: "Change selected profile"; open => { root.open-profiles(); } }
                HorizontalLayout { height: 66px; spacing: 16px;
                    Rectangle { width: 48px;
                        Rectangle { height: 48px; y: (parent.height - self.height) / 2; border-radius: 12px; background: Theme.neutral-badge;
                            UiIcon { name: "server"; ink: Theme.accent; x: 12px; y: 12px; width: 24px; height: 24px; }
                        }
                    }
                    VerticalLayout { spacing: 4px; alignment: center; min-width: 0px;
                        Text { text: XrayModule.selected-profile.id == "" ? "No profile selected" : XrayModule.selected-profile.name; color: Theme.text; font-size: 20px; font-weight: 600; min-width: 0px; overflow: elide; }
                        Text { text: XrayModule.selected-profile.id == "" ? "Choose a profile to configure the tunnel." : XrayModule.selected-profile.summary; color: Theme.secondary; font-size: 12px; min-width: 0px; overflow: elide; }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                XrayDetail { label: "Xray-core"; value: XrayModule.version == "" ? "Not installed" : XrayModule.version; }
                XrayDetail { label: "Configuration"; value: XrayModule.settings-error != "" ? "Review settings" : XrayModule.pending ? "Pending restart" : XrayModule.selected-profile.id == "" ? "Choose a profile" : XrayModule.running ? "Applied" : "Saved"; }
            }
        }
        SurfaceCard {
            preferred-width: 0px; horizontal-stretch: 1; height: 224px;
            VerticalLayout { padding: 18px; spacing: 10px; alignment: start;
                SectionHeading { title: "Local SOCKS5"; action-label: "Settings"; action-accessibility: "Local SOCKS settings"; open => { root.open-general(); } }
                VerticalLayout { height: 66px; alignment: center; spacing: 8px;
                    Text { text: "127.0.0.1:" + XrayModule.listener-port; color: Theme.text; font-family: "Consolas"; font-size: 24px; font-weight: 600; height: 36px; vertical-alignment: center; min-width: 0px; overflow: elide; }
                    Text { text: "Use this listener in your proxy routing rules."; color: Theme.secondary; font-size: 12px; height: 16px; min-width: 0px; overflow: elide; }
                }
                Rectangle { height: 1px; background: Theme.border; }
                XrayDetail { label: "Listener"; value: XrayModule.running ? "Running" : "Stopped"; }
                XrayDetail { label: "Tunnel DNS"; value: XrayModule.dns; }
            }
        }
    }
    SurfaceCard {
        height: profile-list.preferred-height;
        profile-list := VerticalLayout {
            padding: 18px; spacing: 10px; alignment: start;
            SectionHeading { title: "Profiles"; action-accessibility: "Open Profiles"; open => { root.open-profiles(); } }
            if !root.has-profiles: XrayNote { text: "Import a VLESS profile or subscription to get started."; height: 48px; vertical-alignment: center; }
            if XrayModule.profiles.length > 0: VerticalLayout { spacing: 6px; alignment: start;
                Text { text: "Manual profiles"; color: Theme.secondary; font-size: 12px; height: 22px; vertical-alignment: center; }
                for row in XrayModule.profiles: XrayProfileItem { profile: row; compact: true; }
            }
            for group in XrayModule.subscriptions: VerticalLayout {
                spacing: 6px; alignment: start;
                Text { text: group.name; color: Theme.secondary; font-size: 12px; height: 22px; vertical-alignment: center; }
                for row in group.profiles: XrayProfileItem { profile: row; compact: true; }
            }
        }
    }
}

component XrayProfiles inherits VerticalLayout {
    alignment: start;
    spacing: 12px;
    XrayCard {
        title: "Import profile"; icon: "link";
        caption: "Paste a VLESS link, an HTTPS subscription, or a v2RayTun link.";
        HorizontalLayout {
            spacing: 8px;
            Field { value <=> XrayModule.profile-input; placeholder: "VLESS, HTTPS, or v2RayTun link"; secret: true; field-height: 40px; }
            ActionButton {
                label: "Import";
                icon: "plus";
                primary: true;
                enabled: !XrayModule.busy && XrayModule.profile-input != "";
                clicked => { XrayModule.import-profile(XrayModule.profile-input); }
            }
        }
        if XrayModule.hpwnr-required: XrayNotice { message: "This encrypted link requires hpwnr. Install the module and continue importing?"; }
        if XrayModule.hpwnr-required: HorizontalLayout { spacing: 8px; alignment: start;
            ActionButton { label: "Install and Import"; icon: "download"; primary: true; enabled: !XrayModule.busy; clicked => { XrayModule.confirm-hpwnr(); } }
            ActionButton { label: "Cancel"; enabled: !XrayModule.busy; clicked => { XrayModule.cancel-hpwnr(); } }
        }
        if XrayModule.hpwnr-error != "": XrayNotice { message: XrayModule.hpwnr-error; error: true; }
    }
    XrayCard {
        title: "Manual Profiles"; icon: "file";
        if XrayModule.profiles.length == 0: XrayNote { text: "No manually imported profiles."; }
        for row in XrayModule.profiles: XrayProfileItem { profile: row; }
    }
    if XrayModule.subscriptions.length == 0: XrayCard {
        title: "Subscriptions"; icon: "refresh";
        XrayNote { text: "No subscriptions imported."; }
    }
    for group in XrayModule.subscriptions: XrayCard {
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: group.name;
                font-size: 16px;
                font-weight: 600;
                color: Theme.text;
                min-width: 0px;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            ActionButton {
                label: "Refresh";
                accessible-label: "Refresh " + group.name;
                icon: "refresh";
                height: 32px;
                enabled: !XrayModule.busy;
                clicked => { XrayModule.refresh-subscription(group.id); }
            }
        }
        if group.profiles.length == 0: XrayNote { text: "No profiles in this subscription."; }
        for row in group.profiles: XrayProfileItem { profile: row; }
    }
}

component XrayGeneral inherits XrayCard {
    title: "SOCKS5 listener"; icon: "network";
    caption: "The listener binds to 127.0.0.1. The default port is 2081.";
    HorizontalLayout {
        alignment: start;
        Field {
            width: 144px;
            placeholder: "2081";
            value <=> XrayModule.port;
            field-height: 40px;
            edited => { XrayModule.settings-edited(); }
        }
    }
}

component XrayDns inherits VerticalLayout {
    alignment: start;
    spacing: 12px;
    XrayCard {
        title: "Tunnel DNS"; icon: "globe";
        caption: "Use Default for the VPN server’s usual resolution, or enter IP addresses, TCP DNS URLs, or DNS-over-HTTPS URLs separated by commas.";
        Field {
            value <=> XrayModule.dns;
            placeholder: "Default, tcp://1.1.1.1:53, or https://resolver.example/dns-query";
            field-height: 40px;
            edited => { XrayModule.settings-edited(); }
        }
    }
    XrayCard {
        title: "VPN server hosts"; icon: "server";
        action-label: "Refresh"; action-icon: "refresh";
        action-enabled: !XrayModule.busy && XrayModule.hosts.length > 0;
        action => { XrayModule.refresh-hosts(); }
        caption: "True Proxy resolves these names using Windows DNS when profiles change or you select Refresh. Xray connects to the saved IP and keeps the original server name (SNI).";

        if XrayModule.hosts.length == 0: XrayNote { text: "No VPN server hostnames."; }
        if XrayModule.hosts.length > 0: HorizontalLayout {
            spacing: 8px;
            height: 24px;
            Text { text: "HOST"; color: Theme.secondary; font-size: 10px; vertical-alignment: center; min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; }
            Text { text: "ADDRESS"; color: Theme.secondary; font-size: 10px; vertical-alignment: center; min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; }
        }
        for entry in XrayModule.hosts: HorizontalLayout {
            spacing: 8px;
            height: 30px;
            Text { text: entry.host; color: Theme.text; vertical-alignment: center; overflow: elide; min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; }
            Text { text: entry.address; color: Theme.secondary; font-family: "Consolas"; vertical-alignment: center; overflow: elide; min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; }
        }
    }
}

component XrayGeoChip inherits Rectangle {
    in property <string> tag;
    in property <string> kind;
    callback remove;
    width: min(220px, caption.preferred-width + 34px);
    height: 26px;
    background: Theme.accent-soft;
    border-radius: Theme.radius-small;
    caption := Text {
        x: 8px;
        width: parent.width - 34px;
        text: root.tag;
        font-size: 12px;
        color: Theme.accent;
        vertical-alignment: center;
        overflow: elide;
    }
    ActionButton {
        x: parent.width - self.width - 2px;
        y: 2px;
        width: 22px;
        height: 22px;
        label: "Remove " + root.kind + " " + root.tag;
        icon: "close";
        icon-only: true;
        enabled: !XrayModule.busy;
        clicked => { root.remove(); }
    }
}

component XrayGeoSuggestion inherits Rectangle {
    in property <string> tag;
    in property <string> kind;
    callback select;
    height: 30px;
    border-radius: Theme.radius-small;
    background: touch.pressed ? Theme.pressed : touch.has-hover || focus.has-focus ? Theme.surface-hover : Theme.surface;
    accessible-role: button;
    accessible-label: "Add " + root.kind + " " + root.tag;
    accessible-enabled: !XrayModule.busy;
    accessible-action-default => { if !XrayModule.busy { root.select(); } }
    forward-focus: focus;
    Text {
        x: 8px;
        width: parent.width - 16px;
        text: root.tag;
        color: Theme.text;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }
    touch := TouchArea {
        enabled: !XrayModule.busy;
        mouse-cursor: pointer;
        clicked => { root.select(); }
    }
    focus := FocusScope {
        width: 0px;
        enabled: !XrayModule.busy;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return { root.select(); return accept; }
            return reject;
        }
    }
}

component XrayGeoPicker inherits VerticalLayout {
    in property <bool> geosite;
    in property <[string]> selected;
    in property <[string]> suggestions;
    in-out property <string> query;
    private property <string> kind: root.geosite ? "Geosite" : "GeoIP";
    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    alignment: start;
    spacing: 6px;
    Field {
        label: root.kind;
        placeholder: "Search or enter a tag";
        icon: "search";
        value <=> root.query;
        edited => { XrayModule.filter-geo-tags(root.geosite, root.query); }
        accepted => {
            if !XrayModule.busy && root.query != "" { XrayModule.select-geo-tag(root.geosite, root.query); }
        }
    }
    if root.query != "" && root.suggestions.length > 0: Rectangle {
        height: options.preferred-height;
        border-radius: Theme.radius-small;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.surface;
        options := VerticalLayout {
            padding: 4px;
            for value in root.suggestions: XrayGeoSuggestion {
                tag: value;
                kind: root.kind;
                select => { XrayModule.select-geo-tag(root.geosite, value); }
            }
        }
    }
    if root.selected.length > 0: ScrollView {
        height: chips.preferred-width > self.visible-width ? 40px : 26px;
        min-width: 0px;
        vertical-scrollbar-policy: always-off;
        horizontal-scrollbar-policy: as-needed;
        content-width: max(self.visible-width, chips.preferred-width);
        content-height: self.visible-height;
        chips := HorizontalLayout {
            width: max(root.width, self.preferred-width);
            height: 26px;
            alignment: start;
            spacing: 5px;
            for value in root.selected: XrayGeoChip {
                tag: value;
                kind: root.kind;
                remove => { XrayModule.remove-geo-tag(root.geosite, value); }
            }
        }
    }
}

component XrayFallbacks inherits XrayCard {
    title: "Direct routes"; icon: "route";
    caption: "Xray sends matching traffic directly. Select an entry or press Enter to add a custom tag.";
    HorizontalLayout {
        spacing: 10px;
        XrayGeoPicker {
            selected: XrayModule.geo-ip-selected;
            suggestions: XrayModule.geo-ip-suggestions;
            query <=> XrayModule.geo-ip-query;
        }
        XrayGeoPicker {
            geosite: true;
            selected: XrayModule.geo-site-selected;
            suggestions: XrayModule.geo-site-suggestions;
            query <=> XrayModule.geo-site-query;
        }
    }
    Field { label: "GeoIP database source"; placeholder: "HTTPS download URL"; value <=> XrayModule.geo-ip-url; edited => { XrayModule.settings-edited(); } }
    Field { label: "Geosite database source"; placeholder: "HTTPS download URL"; value <=> XrayModule.geo-site-url; edited => { XrayModule.settings-edited(); } }
    Field { label: "Refresh interval in hours"; placeholder: "0 for manual updates"; value <=> XrayModule.geo-refresh-hours; edited => { XrayModule.settings-edited(); } }
    if XrayModule.geo-status != "": XrayNote { text: XrayModule.geo-status; }
    HorizontalLayout {
        alignment: start;
        ActionButton {
            label: "Update Databases";
            icon: "refresh";
            enabled: !XrayModule.busy && !XrayModule.settings-saving && XrayModule.settings-error == "";
            clicked => { XrayModule.refresh-geo(); }
        }
    }
}

component XrayEventCell inherits Text {
    in property <bool> heading;
    min-width: 0px;
    overflow: elide;
    vertical-alignment: center;
    color: root.heading ? Theme.muted : Theme.text;
    font-size: root.heading ? 10px : 12px;
    font-weight: root.heading ? 600 : 400;
}

component XrayEventLine inherits Rectangle {
    in property <bool> heading;
    in property <bool> stripe;
    in property <XrayConnectionRow> entry;
    property <bool> show-domain: !root.heading && root.entry.observed-domain != "";
    height: root.heading ? 32px : root.show-domain ? 46px : 36px;
    background: root.heading || root.stripe ? Theme.field : Theme.surface;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        XrayEventCell { heading: root.heading; width: 73px; text: root.heading ? "TIME" : root.entry.time; }
        XrayEventCell { heading: root.heading; width: 58px; text: root.heading ? "PROTOCOL" : root.entry.protocol; }
        VerticalLayout {
            min-width: 0px;
            preferred-width: 0px;
            horizontal-stretch: 3;
            alignment: center;
            spacing: 2px;
            XrayEventCell { heading: root.heading; text: root.heading ? "TARGET" : root.entry.destination; }
            if root.show-domain: XrayEventCell {
                text: "DNS · " + root.entry.observed-domain;
                color: Theme.muted;
                font-size: 11px;
            }
        }
        XrayEventCell { heading: root.heading; preferred-width: 0px; horizontal-stretch: 2; text: root.heading ? "SOURCE" : root.entry.source; }
        XrayEventCell { heading: root.heading; width: 76px; text: root.heading ? "ROUTE" : root.entry.route; }
        XrayEventCell { heading: root.heading; preferred-width: 0px; horizontal-stretch: 2; text: root.heading ? "RESULT" : root.entry.detail; }
    }
}

component XrayConnections inherits SurfaceCard {
    min-width: 0px;
    min-height: 0px;
    vertical-stretch: 1;
    clip: true;
    VerticalLayout {
        padding: 1px;
        PanelToolbar {
            Text { text: "Connections"; color: Theme.text; font-weight: 600; font-size: 18px; vertical-alignment: center; }
            Text { text: "" + XrayModule.connections.length + " / " + XrayModule.connection-total; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Rectangle {
                width: 190px;
                Field {
                    y: (parent.height - self.height) / 2;
                    field-height: 34px;
                    height: 34px;
                    placeholder: "Search connections";
                    icon: "search";
                    value <=> XrayModule.connection-query;
                    edited => { events-scroll.content-y = 0px; XrayModule.filter-connections(); }
                }
            }
            Rectangle {
                width: clear.min-width;
                clear := ActionButton {
                    label: "Clear Connections";
                    icon: "trash";
                    icon-only: true;
                    y: (parent.height - self.height) / 2;
                    enabled: XrayModule.connection-total > 0;
                    clicked => { events-scroll.content-y = 0px; XrayModule.clear-connections(); }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }
        TableHeading {
            XrayEventLine { x: 0px; width: parent.width - Theme.scroll-gutter; heading: true; }
        }
        Rectangle { height: 1px; background: Theme.border; }
        events-scroll := ScrollView {
            min-height: 0px;
            vertical-stretch: 1;
            horizontal-scrollbar-policy: always-off;
            content-width: self.visible-width;
            content-height: max(self.visible-height, entries.preferred-height);
            entries := VerticalLayout {
                padding-right: Theme.scroll-gutter;
                padding-bottom: 8px;
                alignment: start;
                if XrayModule.connections.length == 0: EmptyState {
                    icon: "activity";
                    title: XrayModule.connection-total == 0 ? "No Xray connection events yet." : "No connections match the search.";
                }
                for event[index] in XrayModule.connections: XrayEventLine { entry: event; stripe: mod(index, 2) == 1; }
            }
        }
    }
}

export component XrayView inherits VerticalLayout {
    in property <bool> preview-ui;
    min-width: 0px;
    min-height: 0px;
    vertical-stretch: 1;
    spacing: 20px;
    PageHeader {
        title: ["X-RAY Dashboard", "X-RAY Profiles", "X-RAY General", "X-RAY DNS", "X-RAY Fallbacks", "X-RAY Connections", "X-RAY Logs"][XrayModule.section];
        subtitle: ["Manage your tunnel, local listener and connection profiles.", "Import profiles and manage your subscriptions.", "Configure the local SOCKS5 listener.", "Manage tunnel resolution and VPN server hosts.", "Choose traffic that bypasses the tunnel.", "Inspect connection events reported by Xray-core.", "Review and filter Xray-core diagnostics."][XrayModule.section];
        badge: root.preview-ui ? "Sample data" : "";
        action-label: XrayModule.running ? "Stop Xray" : "Start Xray";
        action-icon: XrayModule.running ? "stop" : "play";
        action-enabled: !XrayModule.busy && (XrayModule.running || (!XrayModule.settings-saving && XrayModule.settings-error == ""));
        action => { XrayModule.toggle(); }
    }
    if XrayModule.pending: Rectangle {
        height: pending-content.preferred-height;
        background: Theme.warning-surface;
        border-radius: Theme.radius-medium;
        pending-content := HorizontalLayout {
            padding: 12px;
            spacing: 14px;
            Text { text: "Restart to apply Xray configuration changes. Xray will pause briefly and its proxy connections will close."; color: Theme.warning; font-size: 12px; vertical-alignment: center; wrap: word-wrap; min-width: 0px; }
            ActionButton {
                label: "Restart";
                height: 34px;
                enabled: XrayModule.running && !XrayModule.busy && !XrayModule.settings-saving && XrayModule.settings-error == "";
                clicked => { XrayModule.restart(); }
            }
        }
    }
    if XrayModule.settings-error != "": XrayNotice { message: XrayModule.settings-error; error: true; }
    if XrayModule.error != "": XrayNotice { message: XrayModule.error; error: true; }
    if XrayModule.error == "" && XrayModule.status != "": XrayNotice { message: XrayModule.status; }
    if XrayModule.section < 5: settings-scroll := ScrollView {
        min-height: 0px;
        vertical-stretch: 1;
        horizontal-scrollbar-policy: always-off;
        content-width: self.visible-width;
        content-height: max(self.visible-height, section-content.preferred-height);
        section-content := VerticalLayout {
            alignment: start;
            padding-bottom: 12px;
            if XrayModule.section == 0: XrayDashboard {
                open-general => { settings-scroll.content-y = 0px; XrayModule.section = 2; XrayModule.refresh-activity(); }
                open-profiles => {
                    settings-scroll.content-y = 0px;
                    XrayModule.section = 1;
                    XrayModule.refresh-activity();
                }
            }
            if XrayModule.section == 1: XrayProfiles {}
            if XrayModule.section == 2: XrayGeneral {}
            if XrayModule.section == 3: XrayDns {}
            if XrayModule.section == 4: XrayFallbacks {}
        }
    }
    if XrayModule.section == 5: XrayConnections {}
    if XrayModule.section == 6: LogStreamView {
        title: "Xray log stream";
        backend-label: "Core";
        latest-text: XrayModule.log-text;
        total: XrayModule.log-total;
        visible-count: XrayModule.log-visible-count;
        recording: XrayModule.log-recording;
        verbosity <=> XrayModule.log-verbosity;
        errors-only <=> XrayModule.log-errors-only;
        source <=> XrayModule.log-source;
        follow <=> XrayModule.log-follow;
        filter => { XrayModule.filter-logs(); }
        set-recording(record) => { XrayModule.set-log-recording(record); }
        clear => { XrayModule.clear-logs(); }
    }
}
