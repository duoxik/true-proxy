import { ScrollView } from "std-widgets.slint";
import { PageHeader, FormCard, EmptyState, SurfaceCard, PanelToolbar, TableHeading, SessionCard, MetricCard, NumericText, Badge, IconTile, SectionHeading, ActionButton, TextLink, Field, RuleSwitch, Theme, UiIcon } from "common.slint";
import { LogStreamView } from "logs.slint";
import { FloatingNotice, InlineNotice, NoticeBackdrop, NoticeShelf, NoticeEntry } from "notices.slint";

export struct XrayProfileRow { id: string, name: string, summary: string, active: bool, port-index: int }
export struct XraySubscriptionGroup { id: string, name: string, profiles: [XrayProfileRow], active-removed: bool }
export struct XrayPortUser { id: string, name: string }
export struct XrayPortRow {
    id: string, name: string, number: string, is-default: bool,
    status: string, status-detail: string, used-count: int, users: [XrayPortUser], delete-error: string,
}
export struct XrayHostRow { host: string, address: string }
export struct XrayConnectionRow { time: string, protocol: string, destination: string, observed-domain: string, source: string, route: string, detail: string }
export struct XrayPortDraft { present: bool, value: string, error: string }
export enum XrayRestartPhase { idle, restarting, restarted, failed }

export global XrayModule {
    in property <bool> installed;
    in property <bool> hpwnr-installed;
    in property <string> hpwnr-version;
    in property <string> hpwnr-latest-version;
    in property <string> hpwnr-update-status;
    in-out property <bool> hpwnr-required;
    in property <string> hpwnr-error;
    in property <bool> busy;
    in property <bool> running;
    in property <bool> pending;
    in property <int> pending-revision;
    in property <XrayRestartPhase> restart-phase;
    in property <string> restart-error;
    in-out property <bool> restart-collapsed;
    out property <bool> restart-notice-active: self.installed && (self.pending || self.restart-phase != XrayRestartPhase.idle);
    out property <color> restart-ink: self.restart-phase == XrayRestartPhase.failed ? Theme.danger : Theme.accent;
    in property <bool> settings-saving;
    in property <int> settings-revision;
    in property <string> settings-error;
    in property <string> version;
    in property <string> latest-version;
    in property <string> status;
    in property <string> error;
    in property <string> module-error;
    in property <string> uptime: "00:00:00";
    in property <int> connection-count;
    in property <string> upload: "0";
    in property <string> download: "0";
    in property <[XrayProfileRow]> profiles;
    in property <XrayProfileRow> selected-profile;
    in property <[XraySubscriptionGroup]> subscriptions;
    in-out property <string> profile-input;
    in property <int> enabled-count;
    in property <[XrayPortRow]> ports;
    in property <[string]> port-labels;
    in property <[int]> listening-numbers;
    in property <string> next-free-port;
    in property <string> default-port-label;
    in property <string> listener-summary;
    in property <int> port-draft-revision;
    in property <bool> port-save-pending;
    in-out property <string> dns: "Default";
    in property <[XrayHostRow]> hosts;
    in property <[string]> geo-ip-selected;
    in property <[string]> geo-site-selected;
    in property <[string]> geo-ip-suggestions;
    in property <[string]> geo-site-suggestions;
    in-out property <string> geo-ip-query;
    in-out property <string> geo-site-query;
    in-out property <string> geo-ip-url;
    in-out property <string> geo-site-url;
    in-out property <string> geo-refresh-hours;
    in property <string> geo-status;
    in property <[XrayConnectionRow]> connections;
    in property <int> connection-total;
    in-out property <string> connection-query;
    in property <string> log-text;
    in property <int> log-total;
    in property <int> log-visible-count;
    in property <bool> log-recording;
    in-out property <int> log-verbosity;
    in-out property <int> log-source;
    in-out property <bool> log-errors-only;
    in-out property <bool> log-follow;
    in-out property <int> section;

    callback install;
    callback check-updates;
    callback install-update;
    callback toggle;
    callback restart;
    callback import-profile(string);
    callback install-hpwnr;
    callback check-hpwnr-updates;
    callback update-hpwnr;
    callback confirm-hpwnr;
    callback cancel-hpwnr;
    callback refresh-subscription(string);
    callback activate-profile(string);
    callback remove-profile(string);
    pure callback port-draft(string, bool, int) -> XrayPortDraft;
    callback edit-port(string, bool, string);
    callback commit-port(string, bool);
    callback cancel-port-edit(string, bool);
    callback add-port;
    callback remove-port(string);
    callback assign-profile-port(string, string);
    callback flush-port-edit;
    callback process-port-edits;
    callback port-owners-changed;
    callback finish-port-edit(string, bool, int, string);
    changed section => { self.flush-port-edit(); NoticeBackdrop.invalidate(); }
    callback settings-edited;
    callback commit-settings;
    callback refresh-hosts;
    callback filter-geo-tags(bool, string);
    callback select-geo-tag(bool, string);
    callback remove-geo-tag(bool, string);
    callback refresh-geo;
    callback refresh-activity;
    callback filter-connections;
    callback clear-connections;
    callback filter-logs;
    callback set-log-recording(bool);
    callback clear-logs;
}

component XrayNote inherits Text {
    color: Theme.secondary;
    font-size: 12px;
    min-width: 0px;
    wrap: word-wrap;
    height: self.preferred-height;
}

export component XrayModuleCard inherits FormCard {
    title: "Xray-core"; icon: "boxes";
    version: XrayModule.version;
    action-label: XrayModule.installed ? "Check for Updates" : "";
    action-icon: "refresh";
    action-enabled: !XrayModule.busy;
    action => { XrayModule.check-updates(); }
    caption: "Adds managed local SOCKS5 listeners and VLESS profiles. The Xray-core executable is downloaded separately.";
    if !XrayModule.installed: HorizontalLayout {
        spacing: 8px;
        alignment: start;
        if !XrayModule.installed: ActionButton {
            label: XrayModule.busy ? "Installing…" : "Install Xray-core";
            icon: "download";
            primary: true;
            enabled: !XrayModule.busy;
            clicked => { XrayModule.install(); }
        }

    }
    if XrayModule.installed && XrayModule.latest-version != "" && XrayModule.latest-version != XrayModule.version: HorizontalLayout {
        spacing: 8px;
        alignment: start;
        if XrayModule.latest-version != "" && XrayModule.latest-version != XrayModule.version: ActionButton {
            label: "Install " + XrayModule.latest-version;
            icon: "download";
            primary: true;
            enabled: !XrayModule.running && !XrayModule.busy;
            clicked => { XrayModule.install-update(); }
        }
    }
    if XrayModule.running && XrayModule.latest-version != "" && XrayModule.latest-version != XrayModule.version: XrayNote {
        text: "Stop Xray to install the update.";
    }
    if XrayModule.module-error != "": InlineNotice { message: XrayModule.module-error; error: true; }
}

export component HpwnrModuleCard inherits FormCard {
    title: "hpwnr"; icon: "lock";
    version: XrayModule.hpwnr-version;
    action-label: XrayModule.hpwnr-installed ? "Check for Updates" : "";
    action-icon: "refresh";
    action-accessibility: "Check for hpwnr updates";
    action-enabled: !XrayModule.busy;
    action => { XrayModule.check-hpwnr-updates(); }
    caption: "Imports encrypted v2RayTun links. Decryption runs locally; the module is downloaded separately.";
    if !XrayModule.hpwnr-installed || XrayModule.hpwnr-latest-version != "": HorizontalLayout { spacing: 12px; alignment: start;
        if !XrayModule.hpwnr-installed: ActionButton {
            label: "Install hpwnr"; icon: "download"; primary: true;
            enabled: !XrayModule.busy;
            clicked => { XrayModule.install-hpwnr(); }
        }
        if XrayModule.hpwnr-latest-version != "": ActionButton {
            label: "Install " + XrayModule.hpwnr-latest-version; icon: "download"; primary: true;
            enabled: !XrayModule.busy; clicked => { XrayModule.update-hpwnr(); }
        }
    }
    if XrayModule.hpwnr-update-status != "": XrayNote { text: XrayModule.hpwnr-update-status; }
    if XrayModule.hpwnr-error != "": InlineNotice { message: XrayModule.hpwnr-error; error: true; }
}

component PortField inherits Rectangle {
    in property <string> port-id;
    in property <bool> number-field;
    in property <string> saved;
    in property <string> label;
    out property <string> error: root.draft.error;
    private property <XrayPortDraft> draft: XrayModule.port-draft(root.port-id, root.number-field, XrayModule.port-draft-revision);
    private property <string> display-value: root.draft.present ? root.draft.value : root.saved;
    private property <bool> was-focused;
    changed display-value => {
        if input.text != root.display-value {
            input.text = root.display-value;
        }
    }
    min-width: 0px;
    height: 36px;
    border-width: 1px;
    border-radius: Theme.radius-small;
    background: Theme.field;
    border-color: root.error != "" ? Theme.danger : Theme.border;
    forward-focus: input;
    input := TextInput {
        x: 10px; width: parent.width - 20px; height: parent.height;
        accessible-label: root.label;
        text: root.display-value;
        font-family: root.number-field ? Theme.numeric-font : Theme.font-family;
        single-line: true; font-size: 13px; color: Theme.text;
        vertical-alignment: center;
        selection-background-color: Theme.selection; selection-foreground-color: Theme.text;
        changed has-focus => {
            if root.was-focused && !self.has-focus {
                XrayModule.commit-port(root.port-id, root.number-field);
            }
            root.was-focused = self.has-focus;
        }
        edited => { XrayModule.edit-port(root.port-id, root.number-field, self.text); }
        accepted => { XrayModule.commit-port(root.port-id, root.number-field); }
        key-pressed(event) => {
            if event.text == Key.Escape {
                XrayModule.cancel-port-edit(root.port-id, root.number-field);
                self.text = root.saved;
                return accept;
            }
            return reject;
        }
    }
}

component ProfilePortChoice inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback choose;
    height: 34px;
    border-radius: 6px;
    background: touch.pressed ? Theme.switch-off : touch.has-hover ? Theme.neutral-badge : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.choose(); }
    HorizontalLayout {
        padding-left: 10px; padding-right: 9px; spacing: 8px; cross-axis-alignment: center;
        NumericText {
            text: root.label; color: Theme.text; font-size: 13px;
            min-width: 0px; horizontal-stretch: 1; overflow: elide; accessible-role: none;
        }
        Rectangle {
            width: 15px; height: 15px;
            if root.selected: UiIcon { name: "check"; width: 15px; height: 15px; ink: Theme.text; }
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.choose(); } }
}

component ProfilePortSelector inherits Rectangle {
    in property <XrayProfileRow> profile;
    in property <length> viewport-bottom;
    private property <bool> enabled: XrayModule.ports.length > 1 && !XrayModule.busy;
    private property <int> saved-index: root.profile.port-index;
    private property <XrayPortRow> port: XrayModule.ports[root.saved-index];
    private property <color> detail-ink: root.enabled ? Theme.secondary : Theme.disabled-text;
    private property <length> space-below: max(0px, root.viewport-bottom - root.absolute-position.y - root.height - 5px);
    private property <length> space-above: max(0px, root.absolute-position.y - 5px);
    private property <length> row-height: 34px;
    private property <length> preferred-menu-height: min(6, XrayModule.ports.length) * root.row-height + 10px;
    private property <bool> opens-above: root.preferred-menu-height > root.space-below && root.space-above > root.space-below;

    width: 170px; height: 36px;
    border-radius: Theme.radius-small; border-width: 1px;
    border-color: root.enabled && (menu.is-open || touch.has-hover) ? Theme.muted
        : root.enabled && Theme.dark ? Theme.switch-off : Theme.border;
    background: !root.enabled ? Theme.disabled : touch.pressed ? Theme.neutral-badge : Theme.field;
    accessible-role: combobox;
    accessible-label: "Port for " + root.profile.name;
    accessible-value: XrayModule.port-labels[root.saved-index];
    accessible-enabled: root.enabled;
    accessible-expandable: root.enabled;
    accessible-expanded: menu.is-open;
    accessible-action-expand => { if root.enabled { menu.show(); } }
    changed enabled => { if !root.enabled && menu.is-open { menu.close(); } }

    HorizontalLayout {
        padding-left: 12px; padding-right: 10px; spacing: 6px; cross-axis-alignment: center;
        HorizontalLayout {
            min-width: 0px; horizontal-stretch: 1; alignment: start; spacing: 4px;
            Text {
                text: root.port.name; color: root.enabled ? Theme.text : Theme.disabled-text;
                font-size: 13px; font-weight: root.enabled && !root.port.is-default ? 600 : 400;
                min-width: 0px; overflow: elide; accessible-role: none;
            }
            NumericText {
                text: root.port.number == "" ? "" : "· " + root.port.number;
                color: root.detail-ink; font-size: 13px; accessible-role: none;
            }
        }
        UiIcon { name: menu.is-open ? "chevron-up" : "chevron-down"; width: 15px; height: 15px; ink: root.detail-ink; }
    }
    touch := TouchArea {
        enabled: root.enabled; mouse-cursor: pointer;
        clicked => { if menu.is-open { menu.close(); } else { menu.show(); } }
    }
    menu := PopupWindow {
        x: 0px; y: root.opens-above ? -self.height - 5px : root.height + 5px;
        width: 208px;
        height: min(root.preferred-menu-height, root.opens-above ? root.space-above : root.space-below);
        close-policy: close-on-click-outside;
        SurfaceCard {
            border-radius: Theme.radius-small;
            border-color: Theme.dark ? Theme.switch-off : Theme.border;
            port-menu-scroll := ScrollView {
                x: 5px; y: 5px; width: parent.width - 10px; height: parent.height - 10px;
                horizontal-scrollbar-policy: always-off;
                content-width: self.visible-width;
                content-height: XrayModule.ports.length * root.row-height;
                content-y: -min(max(0, root.saved-index - 2) * root.row-height, max(0px, self.content-height - self.visible-height));
                VerticalLayout {
                    alignment: start;
                    padding-right: XrayModule.ports.length * root.row-height > menu.height - 10px ? Theme.scroll-gutter : 0px;
                    for port[index] in XrayModule.ports: ProfilePortChoice {
                        label: XrayModule.port-labels[index]; selected: index == root.saved-index;
                        height: root.row-height;
                        choose => {
                            // Closing the popup releases the row's references to the selector.
                            if root.enabled && index != root.saved-index {
                                XrayModule.assign-profile-port(root.profile.id, port.id);
                            }
                            menu.close();
                        }
                    }
                }
            }
        }
    }
}

component XrayProfileItem inherits SurfaceCard {
    in property <length> viewport-bottom;
    in property <XrayProfileRow> profile;
    in property <bool> compact;
    in property <string> reveal-id;
    callback reveal-position(length);
    height: 54px;
    border-radius: Theme.radius-small;
    background: root.profile.active ? Theme.surface-hover : Theme.field;
    // Wait for layout on navigation so long subscription lists can scroll to this exact row.
    Timer {
        running: root.reveal-id != "" && root.reveal-id == root.profile.id;
        interval: 1ms;
        triggered => {
            profile-switch.focus();
            root.reveal-position(root.absolute-position.y);
        }
    }
    HorizontalLayout {
        padding-left: 12px; padding-right: 8px; spacing: 10px; cross-axis-alignment: center;
        VerticalLayout {
            alignment: center; min-width: 0px; horizontal-stretch: 1; spacing: 3px;
            Text { text: root.profile.name; color: Theme.text; font-size: 13px; font-weight: 600; min-width: 0px; overflow: elide; }
            NumericText { text: root.profile.summary; color: Theme.muted; font-size: 11px; min-width: 0px; overflow: elide; }
        }
        if root.compact: Text {
            text: root.profile.active ? "Selected" : "Available";
            color: root.profile.active ? Theme.accent-text : Theme.muted;
            font-size: 11px; horizontal-stretch: 0;
        }
        if !root.compact: ProfilePortSelector { profile: root.profile; viewport-bottom: root.viewport-bottom; }
        if !root.compact: ActionButton {
            label: "Remove " + root.profile.name;
            icon: "trash"; icon-only: true; quiet: true; icon-ink: Theme.muted;
            enabled: !XrayModule.busy;
            clicked => { XrayModule.remove-profile(root.profile.id); }
        }
        profile-switch := RuleSwitch {
            label: "Activate " + root.profile.name;
            checked: root.profile.active;
            enabled: !XrayModule.busy;
            toggled => { XrayModule.activate-profile(root.profile.id); }
        }
    }
}

component XrayDetail inherits HorizontalLayout {
    in property <bool> numeric;
    in property <string> label;
    in property <string> value;
    height: 24px;
    spacing: 12px;
    Text { text: root.label; color: Theme.secondary; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
    Text { text: root.value; font-family: root.numeric ? Theme.numeric-font : Theme.font-family; color: Theme.text; font-size: 12px; vertical-alignment: center; min-width: 0px; overflow: elide; horizontal-alignment: right; }
}

component XrayDashboard inherits VerticalLayout {
    callback open-profiles;
    callback open-general;
    private property <bool> has-profiles: XrayModule.profiles.length > 0 || XrayModule.subscriptions.length > 0;
    alignment: start;
    spacing: 20px;
    HorizontalLayout {
        height: 70px; spacing: 20px;
        SessionCard {
            active: XrayModule.running;
            error: XrayModule.error != "";
            status: XrayModule.error != "" ? "Xray error" : XrayModule.running ? "Xray running" : XrayModule.busy ? "Working…" : "Xray stopped";
            uptime: XrayModule.uptime;
        }
        MetricCard { value: XrayModule.connection-count; label: "Accepted events"; }
        MetricCard { value: XrayModule.upload; label: "VLESS events"; }
        MetricCard { value: XrayModule.download; label: "Direct events"; }
    }
    HorizontalLayout {
        spacing: 24px;
        SurfaceCard {
            preferred-width: 0px; horizontal-stretch: 1.2; height: 224px;
            VerticalLayout { padding: 18px; spacing: 10px; alignment: start;
                SectionHeading { title: "Enabled profiles"; action-label: "Change"; action-accessibility: "Change selected profile"; open => { root.open-profiles(); } }
                HorizontalLayout { height: 66px; spacing: 16px;
                    Rectangle { width: 48px;
                        IconTile {
                            name: "server"; ink: Theme.accent-text; icon-size: 24px;
                            width: 48px; height: 48px; y: (parent.height - self.height) / 2;
                        }
                    }
                    VerticalLayout { spacing: 4px; alignment: center; min-width: 0px;
                        Text { font-family: XrayModule.enabled-count > 1 ? Theme.numeric-font : Theme.font-family; text: XrayModule.enabled-count > 1 ? XrayModule.enabled-count + " profiles enabled" : XrayModule.selected-profile.id == "" ? "No profile enabled" : XrayModule.selected-profile.name; color: Theme.text; font-size: 20px; font-weight: 600; min-width: 0px; overflow: elide; }
                        Text { font-family: XrayModule.enabled-count == 1 && XrayModule.selected-profile.id != "" ? Theme.numeric-font : Theme.font-family; text: XrayModule.enabled-count > 1 ? "One profile per local port." : XrayModule.selected-profile.id == "" ? "Choose a profile to configure the tunnel." : XrayModule.selected-profile.summary; color: Theme.secondary; font-size: 12px; min-width: 0px; overflow: elide; }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                XrayDetail { label: "Xray-core"; numeric: XrayModule.version != ""; value: XrayModule.version == "" ? "Not installed" : XrayModule.version; }
                XrayDetail { label: "Configuration"; value: XrayModule.settings-error != "" ? "Review settings" : XrayModule.pending ? "Pending restart" : XrayModule.selected-profile.id == "" ? "Choose a profile" : XrayModule.running ? "Applied" : "Saved"; }
            }
        }
        SurfaceCard {
            preferred-width: 0px; horizontal-stretch: 1; height: 224px;
            VerticalLayout { padding: 18px; spacing: 10px; alignment: start;
                SectionHeading { title: "Local SOCKS5"; action-label: "Settings"; action-accessibility: "Local SOCKS settings"; open => { root.open-general(); } }
                VerticalLayout { height: 66px; alignment: center; spacing: 8px;
                    Text { font-family: XrayModule.listening-numbers.length > 0 ? Theme.numeric-font : Theme.font-family; text: XrayModule.listener-summary; color: Theme.text; font-size: 23px; font-weight: 600; height: 36px; vertical-alignment: center; min-width: 0px; overflow: elide; }
                    Text { text: "Local SOCKS5 addresses and listener status."; color: Theme.secondary; font-size: 12px; height: 16px; min-width: 0px; overflow: elide; }
                }
                Rectangle { height: 1px; background: Theme.border; }
                XrayDetail { label: "Listener"; value: XrayModule.running ? "Running" : "Stopped"; }
                XrayDetail { label: "Tunnel DNS"; numeric: XrayModule.dns != "Default"; value: XrayModule.dns; }
            }
        }
    }
    SurfaceCard {
        height: profile-list.preferred-height;
        profile-list := VerticalLayout {
            padding: 18px; spacing: 10px; alignment: start;
            SectionHeading { title: "Profiles"; action-accessibility: "Open Profiles"; open => { root.open-profiles(); } }
            if !root.has-profiles: XrayNote { text: "Import a VLESS profile or subscription to get started."; height: 48px; vertical-alignment: center; }
            if XrayModule.profiles.length > 0: VerticalLayout { spacing: 6px; alignment: start;
                Text { text: "Manual profiles"; color: Theme.secondary; font-size: 12px; height: 22px; vertical-alignment: center; }
                for row in XrayModule.profiles: XrayProfileItem { profile: row; compact: true; }
            }
            for group in XrayModule.subscriptions: VerticalLayout {
                spacing: 6px; alignment: start;
                Text { text: group.name; color: Theme.secondary; font-size: 12px; height: 22px; vertical-alignment: center; }
                for row in group.profiles: XrayProfileItem { profile: row; compact: true; }
            }
        }
    }
}

component ProfileContainer inherits FormCard {
    in property <length> viewport-bottom;
    in property <string> owner;
    in property <string> group-name;
    in property <string> reveal-id;
    callback reveal-position(length);
    in property <bool> active-removed;
    in property <[XrayProfileRow]> rows;
    HorizontalLayout {
        height: 36px; spacing: 8px; cross-axis-alignment: center;
        Text { text: root.group-name; font-size: 16px; font-weight: 600; color: Theme.text; min-width: 0px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
        if root.owner != "": TextLink {
            label: "Refresh";
            icon: "refresh";
            trailing-icon: false;
            accessible-label: "Refresh " + root.group-name;
            enabled: !XrayModule.busy;
            clicked => { XrayModule.refresh-subscription(root.owner); }
        }
    }
    if root.active-removed: InlineNotice { message: "Active profile removed"; error: true; }
    if root.rows.length == 0: XrayNote { text: root.owner == "" ? "No manually imported profiles." : "No profiles in this subscription."; }
    for row in root.rows: XrayProfileItem {
        profile: row; reveal-id: root.reveal-id; viewport-bottom: root.viewport-bottom;
        reveal-position(y) => { root.reveal-position(y); }
    }
}

component XrayProfiles inherits VerticalLayout {
    in property <length> viewport-bottom;
    in property <string> reveal-id;
    callback reveal-position(length);
    alignment: start;
    spacing: 12px;
    FormCard {
        HorizontalLayout {
            spacing: 8px;
            Rectangle { width: 32px; UiIcon { name: "link"; y: (parent.height - self.height) / 2; } }
            Text { text: "Import profile"; color: Theme.text; font-size: 15px; font-weight: 600; vertical-alignment: center; }
            Field { value <=> XrayModule.profile-input; placeholder: "VLESS, HTTPS, or v2RayTun link"; secret: true; field-height: 40px; }
            ActionButton {
                label: "Import";
                icon: "plus";
                primary: true;
                enabled: !XrayModule.busy && XrayModule.profile-input != "";
                clicked => { XrayModule.import-profile(XrayModule.profile-input); }
            }
        }
        if XrayModule.profile-input.starts-with("https://"): XrayNote { text: "ShadowNet subscriptions use a saved device identity for this PC."; }
        if XrayModule.hpwnr-required: InlineNotice { message: "This encrypted link requires hpwnr. Install the module and continue importing?"; }
        if XrayModule.hpwnr-required: HorizontalLayout { spacing: 8px; alignment: start;
            ActionButton { label: "Install and Import"; icon: "download"; primary: true; enabled: !XrayModule.busy; clicked => { XrayModule.confirm-hpwnr(); } }
            ActionButton { label: "Cancel"; enabled: !XrayModule.busy; clicked => { XrayModule.cancel-hpwnr(); } }
        }
        if XrayModule.hpwnr-error != "": InlineNotice { message: XrayModule.hpwnr-error; error: true; }
    }
    if XrayModule.subscriptions.length == 0: FormCard {
        title: "Subscriptions"; icon: "refresh";
        XrayNote { text: "No subscriptions imported."; }
    }
    for group in XrayModule.subscriptions: ProfileContainer {
        owner: group.id; group-name: group.name; reveal-id: root.reveal-id;
        active-removed: group.active-removed; rows: group.profiles; viewport-bottom: root.viewport-bottom;
        reveal-position(y) => { root.reveal-position(y); }
    }
    ProfileContainer {
        group-name: "Manual Profiles"; rows: XrayModule.profiles; reveal-id: root.reveal-id; viewport-bottom: root.viewport-bottom;
        reveal-position(y) => { root.reveal-position(y); }
    }
    XrayNote { text: "Turning a profile on switches off only the active one on the same port."; }
}

component PortUserLink inherits Rectangle {
    in property <XrayPortUser> user;
    in property <string> suffix;
    callback open(string);
    min-width: 0px; preferred-width: caption.preferred-width; max-width: caption.preferred-width;
    height: 23px;
    accessible-role: button;
    accessible-label: "Open profile " + root.user.name;
    accessible-action-default => { root.open(root.user.id); }
    forward-focus: focus;
    caption := Text {
        text: root.user.name + root.suffix; color: Theme.danger;
        font-size: 12px; font-weight: 600; overflow: elide; vertical-alignment: center;
        accessible-role: none;
    }
    Rectangle { x: 0px; y: parent.height - 3px; height: 1px; background: touch.has-hover ? Theme.danger : transparent; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.open(root.user.id); } }
    focus := FocusScope { width: 0px; key-pressed(event) => {
        if event.text == Key.Return || event.text == Key.Space { root.open(root.user.id); return accept; }
        return reject;
    } }
    Tooltip { text: @markdown("\{root.user.name}"); }
}

component PortCellText inherits Text {
    font-size: 12px; vertical-alignment: center; min-width: 0px; overflow: elide;
    color: Theme.secondary;
}

component PortTableLine inherits VerticalLayout {
    in property <bool> heading;
    in property <XrayPortRow> port;
    callback open-profile(string);
    private property <string> name-error: root.heading ? "" : XrayModule.port-draft(root.port.id, false, XrayModule.port-draft-revision).error;
    private property <string> number-error: root.heading ? "" : XrayModule.port-draft(root.port.id, true, XrayModule.port-draft-revision).error;
    private property <bool> show-users: root.port.delete-error.starts-with("Used by ") && root.port.users.length > 0;
    alignment: start; spacing: 4px;
    HorizontalLayout {
        height: root.heading ? 24px : 50px; spacing: 14px; cross-axis-alignment: center;
        Rectangle {
            min-width: 0px; preferred-width: 0px; horizontal-stretch: 1.7; height: 36px;
            if root.heading: PortCellText { x: 0px; width: parent.width; text: "Name"; }
            if !root.heading: PortField {
                port-id: root.port.id; saved: root.port.name;
                label: "Port name for " + root.port.name;
            }
        }
        Rectangle {
            min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; height: 36px;
            if root.heading: PortCellText { x: 0px; width: parent.width; text: "Port"; }
            if !root.heading: PortField {
                port-id: root.port.id; saved: root.port.number; number-field: true;
                label: "Port number for " + root.port.name;
            }
        }
        Rectangle {
            min-width: 70px; preferred-width: 70px; horizontal-stretch: 0.65; height: 36px;
            if root.heading: PortCellText { x: 0px; width: parent.width; text: "Status"; }
            if !root.heading: HorizontalLayout {
                spacing: 6px; alignment: start; cross-axis-alignment: center;
                Rectangle {
                    width: 8px; height: 8px; border-radius: 4px; border-width: 1px;
                    border-color: root.port.status == "Listening" ? Theme.accent-text : root.port.status == "Error" ? Theme.danger : Theme.muted;
                    background: root.port.status == "Listening" || root.port.status == "Error" ? self.border-color : transparent;
                }
                PortCellText {
                    text: root.port.status;
                    color: root.port.status == "Listening" ? Theme.accent-text : root.port.status == "Error" ? Theme.danger : Theme.secondary;
                }
            }
        }
        Rectangle {
            min-width: 65px; preferred-width: 65px; horizontal-stretch: 0.65; height: 36px;
            PortCellText {
                x: 0px; width: parent.width;
                font-family: root.heading ? Theme.font-family : Theme.numeric-font;
                text: root.heading ? "Used by" : root.port.used-count + (root.port.used-count == 1 ? " profile" : " profiles");
                color: root.heading ? Theme.secondary : Theme.text;
            }
        }
        Rectangle {
            width: 36px; height: 36px;
            if !root.heading && !root.port.is-default: ActionButton {
                label: "Remove port " + root.port.name; icon: "trash"; icon-only: true; quiet: true;
                height: 36px; enabled: !XrayModule.busy; icon-ink: Theme.muted;
                clicked => { XrayModule.remove-port(root.port.id); }
                Tooltip { text: @markdown("Delete port"); }
            }
        }
    }
    if root.name-error != "": XrayNote { text: root.name-error; color: Theme.danger; }
    if root.number-error != "": XrayNote { text: root.number-error; color: Theme.danger; }
    if root.port.status-detail != "": XrayNote { text: root.port.status-detail; color: root.port.status == "Error" ? Theme.danger : Theme.secondary; }
    if root.show-users: HorizontalLayout {
        alignment: start; cross-axis-alignment: center; spacing: 2px; height: 23px;
        PortCellText { text: "Used by"; color: Theme.danger; }
        for person[index] in root.port.users: PortUserLink {
            user: person;
            suffix: index + 1 < root.port.users.length ? "," : root.port.used-count <= root.port.users.length ? "." : "";
            open(id) => { root.open-profile(id); }
        }
        PortCellText {
            font-family: root.port.used-count > root.port.users.length ? Theme.numeric-font : Theme.font-family;
            text: (root.port.used-count > root.port.users.length ? "and " + (root.port.used-count - root.port.users.length) + " more. " : "")
                + (root.port.used-count == 1 ? "Unbind it first, then delete." : "Unbind them first, then delete.");
            color: Theme.danger;
        }
    }
    if root.port.delete-error != "" && !root.show-users: XrayNote { text: root.port.delete-error; color: Theme.danger; }
    Rectangle { height: 1px; background: Theme.border; }
}

component XrayPorts inherits FormCard {
    callback open-profile(string);
    title: "Ports"; icon: "network";
    caption: XrayModule.default-port-label == "" ? "New profiles use the default port." : "New profiles use";
    caption-emphasis: XrayModule.default-port-label == "" ? "" : XrayModule.default-port-label + ".";
    action-label: "Add port"; action-icon: "plus"; outlined-action: true;
    action-enabled: !XrayModule.busy;
    action => { XrayModule.add-port(); }
    VerticalLayout {
        alignment: start; spacing: 4px;
        PortTableLine { heading: true; }
        for port in XrayModule.ports: PortTableLine {
            port: port;
            open-profile(id) => { root.open-profile(id); }
        }
    }
    XrayNote {
        font-family: Theme.numeric-font;
        text: "Next free port: " + XrayModule.next-free-port + ". Changing a port number keeps profiles bound, but Proxies that use the old number must be updated by hand.";
    }
}

component XrayDns inherits VerticalLayout {
    alignment: start;
    spacing: 12px;
    FormCard {
        title: "Tunnel DNS"; icon: "globe";
        caption: "Use Default or enter resolver IPs, TCP DNS URLs, or HTTPS DoH URLs separated by commas.";
        Field {
            label: "Resolver"; numeric: true;
            value <=> XrayModule.dns;
            placeholder: "Default, tcp://1.1.1.1:53, or https://resolver.example/dns-query";
            field-height: 40px;
            edited => { XrayModule.settings-edited(); }
        }
        XrayNote { text: "This PC queries a custom resolver directly when a client sends a domain to a local SOCKS5 port. Intercepted connections already have an IP address."; }
    }
    FormCard {
        title: "VPN server hosts"; icon: "server";
        action-label: "Refresh"; action-icon: "refresh";
        action-enabled: !XrayModule.busy && XrayModule.hosts.length > 0;
        action => { XrayModule.refresh-hosts(); }
        caption: "True Proxy resolves these names using Windows DNS when profiles change or you select Refresh. Xray connects to the saved IP and keeps the original server name (SNI).";

        if XrayModule.hosts.length == 0: XrayNote { text: "No VPN server hostnames."; }
        if XrayModule.hosts.length > 0: HorizontalLayout {
            spacing: 8px;
            height: 24px;
            Text { text: "HOST"; color: Theme.secondary; font-size: 10px; vertical-alignment: center; min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; }
            Text { text: "ADDRESS"; color: Theme.secondary; font-size: 10px; vertical-alignment: center; min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; }
        }
        for entry in XrayModule.hosts: HorizontalLayout {
            spacing: 8px;
            height: 30px;
            Text { text: entry.host; color: Theme.text; vertical-alignment: center; overflow: elide; min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; }
            NumericText { text: entry.address; color: Theme.secondary; vertical-alignment: center; overflow: elide; min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; }
        }
    }
}

component XrayGeoChip inherits Rectangle {
    in property <string> tag;
    in property <string> kind;
    callback remove;
    width: min(220px, caption.preferred-width + 34px);
    height: 26px;
    background: Theme.accent-soft;
    border-radius: Theme.radius-small;
    caption := Text {
        x: 8px;
        width: parent.width - 34px;
        text: root.tag;
        font-size: 12px;
        color: Theme.accent-text;
        vertical-alignment: center;
        overflow: elide;
    }
    ActionButton {
        x: parent.width - self.width - 2px;
        y: 2px;
        width: 22px;
        height: 22px;
        label: "Remove " + root.kind + " " + root.tag;
        icon: "close";
        icon-only: true;
        enabled: !XrayModule.busy;
        clicked => { root.remove(); }
    }
}

component XrayGeoSuggestion inherits Rectangle {
    in property <string> tag;
    in property <string> kind;
    callback select;
    height: 30px;
    border-radius: Theme.radius-small;
    background: touch.pressed ? Theme.pressed : touch.has-hover ? Theme.surface-hover : Theme.surface;
    accessible-role: button;
    accessible-label: "Add " + root.kind + " " + root.tag;
    accessible-enabled: !XrayModule.busy;
    accessible-action-default => { if !XrayModule.busy { root.select(); } }
    forward-focus: focus;
    Text {
        x: 8px;
        width: parent.width - 16px;
        text: root.tag;
        color: Theme.text;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }
    touch := TouchArea {
        enabled: !XrayModule.busy;
        mouse-cursor: pointer;
        clicked => { root.select(); }
    }
    focus := FocusScope {
        width: 0px;
        enabled: !XrayModule.busy;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return { root.select(); return accept; }
            return reject;
        }
    }
}

component XrayGeoPicker inherits VerticalLayout {
    in property <bool> geosite;
    in property <[string]> selected;
    in property <[string]> suggestions;
    in-out property <string> query;
    private property <string> kind: root.geosite ? "Geosite" : "GeoIP";
    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    alignment: start;
    spacing: 6px;
    Field {
        label: root.kind;
        placeholder: "Search or enter a tag";
        icon: "search";
        value <=> root.query;
        edited => { XrayModule.filter-geo-tags(root.geosite, root.query); }
        accepted => {
            if !XrayModule.busy && root.query != "" { XrayModule.select-geo-tag(root.geosite, root.query); }
        }
    }
    if root.query != "" && root.suggestions.length > 0: SurfaceCard {
        height: options.preferred-height;
        border-radius: Theme.radius-small;
        options := VerticalLayout {
            padding: 4px;
            for value in root.suggestions: XrayGeoSuggestion {
                tag: value;
                kind: root.kind;
                select => { XrayModule.select-geo-tag(root.geosite, value); }
            }
        }
    }
    if root.selected.length > 0: ScrollView {
        height: chips.preferred-width > self.visible-width ? 40px : 26px;
        min-width: 0px;
        vertical-scrollbar-policy: always-off;
        horizontal-scrollbar-policy: as-needed;
        content-width: max(self.visible-width, chips.preferred-width);
        content-height: self.visible-height;
        chips := HorizontalLayout {
            width: max(root.width, self.preferred-width);
            height: 26px;
            alignment: start;
            spacing: 5px;
            for value in root.selected: XrayGeoChip {
                tag: value;
                kind: root.kind;
                remove => { XrayModule.remove-geo-tag(root.geosite, value); }
            }
        }
    }
}

component XrayFallbacks inherits FormCard {
    title: "Direct routes"; icon: "route";
    caption: "Xray sends matching traffic directly. Select an entry or press Enter to add a custom tag.";
    HorizontalLayout {
        spacing: 10px;
        XrayGeoPicker {
            selected: XrayModule.geo-ip-selected;
            suggestions: XrayModule.geo-ip-suggestions;
            query <=> XrayModule.geo-ip-query;
        }
        XrayGeoPicker {
            geosite: true;
            selected: XrayModule.geo-site-selected;
            suggestions: XrayModule.geo-site-suggestions;
            query <=> XrayModule.geo-site-query;
        }
    }
    Field { label: "GeoIP database source"; placeholder: "HTTPS download URL"; value <=> XrayModule.geo-ip-url; edited => { XrayModule.settings-edited(); } }
    Field { label: "Geosite database source"; placeholder: "HTTPS download URL"; value <=> XrayModule.geo-site-url; edited => { XrayModule.settings-edited(); } }
    Field { label: "Refresh interval in hours"; numeric: true; placeholder: "0 for manual updates"; value <=> XrayModule.geo-refresh-hours; edited => { XrayModule.settings-edited(); } }
    if XrayModule.geo-status != "": XrayNote { text: XrayModule.geo-status; }
    HorizontalLayout {
        alignment: start;
        ActionButton {
            label: "Update Databases";
            icon: "refresh";
            enabled: !XrayModule.busy && !XrayModule.settings-saving && XrayModule.settings-error == "";
            clicked => { XrayModule.refresh-geo(); }
        }
    }
}

component XrayEventCell inherits Text {
    in property <bool> heading;
    in property <bool> numeric;
    font-family: !root.heading && root.numeric ? Theme.numeric-font : Theme.font-family;
    min-width: 0px;
    overflow: elide;
    vertical-alignment: center;
    color: root.heading ? Theme.muted : Theme.text;
    font-size: root.heading ? 10px : 12px;
    font-weight: root.heading ? 600 : 400;
}

component XrayEventLine inherits Rectangle {
    in property <bool> heading;
    in property <bool> stripe;
    in property <XrayConnectionRow> entry;
    property <bool> show-domain: !root.heading && root.entry.observed-domain != "";
    height: root.heading ? 32px : root.show-domain ? 46px : 36px;
    background: root.heading || root.stripe ? Theme.field : Theme.surface;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        XrayEventCell { heading: root.heading; numeric: true; width: 73px; text: root.heading ? "TIME" : root.entry.time; }
        XrayEventCell { heading: root.heading; width: 58px; text: root.heading ? "PROTOCOL" : root.entry.protocol; }
        VerticalLayout {
            min-width: 0px;
            preferred-width: 0px;
            horizontal-stretch: 3;
            alignment: center;
            spacing: 2px;
            XrayEventCell { heading: root.heading; numeric: true; text: root.heading ? "TARGET" : root.entry.destination; }
            if root.show-domain: XrayEventCell {
                text: "DNS · " + root.entry.observed-domain;
                color: Theme.muted;
                font-size: 11px;
            }
        }
        XrayEventCell { heading: root.heading; preferred-width: 0px; horizontal-stretch: 2; numeric: true; text: root.heading ? "SOURCE" : root.entry.source; }
        XrayEventCell { heading: root.heading; width: 76px; text: root.heading ? "ROUTE" : root.entry.route; }
        XrayEventCell { heading: root.heading; preferred-width: 0px; horizontal-stretch: 2; text: root.heading ? "RESULT" : root.entry.detail; }
    }
}

component XrayConnections inherits SurfaceCard {
    in property <length> notice-clearance;
    min-width: 0px;
    min-height: 0px;
    vertical-stretch: 1;
    clip: true;
    VerticalLayout {
        padding: 1px;
        PanelToolbar {
            Text { text: "Connections"; color: Theme.text; font-weight: 600; font-size: 18px; vertical-alignment: center; }
            Rectangle {
                width: count.natural-width;
                count := Badge {
                    y: (parent.height - self.height) / 2;
                    label: XrayModule.connections.length + " / " + XrayModule.connection-total;
                    numeric: true; font-size: 11px; side-padding: 6px;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            Rectangle {
                width: 190px;
                Field {
                    y: (parent.height - self.height) / 2;
                    field-height: 34px;
                    height: 34px;
                    placeholder: "Search connections";
                    icon: "search";
                    value <=> XrayModule.connection-query;
                    edited => { events-scroll.content-y = 0px; XrayModule.filter-connections(); }
                }
            }
            Rectangle {
                width: clear.min-width;
                clear := ActionButton {
                    label: "Clear Connections";
                    icon: "trash";
                    icon-only: true;
                    y: (parent.height - self.height) / 2;
                    enabled: XrayModule.connection-total > 0;
                    clicked => { events-scroll.content-y = 0px; XrayModule.clear-connections(); }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }
        TableHeading {
            XrayEventLine { x: 0px; width: parent.width - Theme.scroll-gutter; heading: true; }
        }
        Rectangle { height: 1px; background: Theme.border; }
        events-scroll := ScrollView {
            min-height: 0px;
            vertical-stretch: 1;
            horizontal-scrollbar-policy: always-off;
            content-width: self.visible-width;
            content-height: max(self.visible-height, entries.preferred-height);
            entries := VerticalLayout {
                padding-right: Theme.scroll-gutter;
                padding-bottom: 8px + root.notice-clearance;
                alignment: start;
                if XrayModule.connections.length == 0: EmptyState {
                    icon: "activity";
                    title: XrayModule.connection-total == 0 ? "No Xray connection events yet." : "No connections match the search.";
                }
                for event[index] in XrayModule.connections: XrayEventLine { entry: event; stripe: mod(index, 2) == 1; }
            }
        }
    }
}

export component XrayView inherits VerticalLayout {
    in property <bool> preview-ui;
    in property <length> notice-clearance;
    private property <string> reveal-id;
    min-width: 0px;
    min-height: 0px;
    vertical-stretch: 1;
    spacing: 20px;
    PageHeader {
        title: ["X-RAY Dashboard", "X-RAY Profiles", "X-RAY Ports", "X-RAY DNS", "X-RAY Fallbacks", "X-RAY Connections", "X-RAY Logs"][XrayModule.section];
        subtitle: ["Manage your tunnels, local ports and connection profiles.", "Import profiles and manage your subscriptions.", "Local SOCKS5 ports for your profiles.", "Configure tunnel DNS and refresh VPN server hosts.", "Choose traffic that bypasses the tunnel.", "Inspect connection events reported by Xray-core.", "Review and filter Xray-core diagnostics."][XrayModule.section];
        badge: root.preview-ui ? "Sample data" : "";
        action-label: XrayModule.running ? "Stop Xray" : "Start Xray";
        action-icon: XrayModule.running ? "stop" : "play";
        action-enabled: !XrayModule.busy && (XrayModule.running || (!XrayModule.port-save-pending && !XrayModule.settings-saving && XrayModule.settings-error == ""));
        action => { XrayModule.toggle(); }
    }
    if XrayModule.section < 5: settings-scroll := ScrollView {
        min-height: 0px;
        vertical-stretch: 1;
        horizontal-scrollbar-policy: always-off;
        content-width: self.visible-width;
        content-height: max(self.visible-height, section-content.preferred-height);
        section-content := VerticalLayout {
            alignment: start;
            padding-bottom: 12px + root.notice-clearance;
            if XrayModule.section == 0: XrayDashboard {
                open-general => { settings-scroll.content-y = 0px; XrayModule.section = 2; XrayModule.refresh-activity(); }
                open-profiles => {
                    settings-scroll.content-y = 0px;
                    XrayModule.section = 1;
                    XrayModule.refresh-activity();
                }
            }
            if XrayModule.section == 1: XrayProfiles {
                viewport-bottom: settings-scroll.absolute-position.y + settings-scroll.height;
                reveal-id: root.reveal-id;
                reveal-position(y) => {
                    let offset = settings-scroll.content-y + settings-scroll.absolute-position.y - y + 12px;
                    settings-scroll.content-y = clamp(offset, settings-scroll.visible-height - settings-scroll.content-height, 0px);
                    root.reveal-id = "";
                }
            }
            if XrayModule.section == 2: XrayPorts {
                open-profile(id) => {
                    root.reveal-id = id;
                    XrayModule.section = 1;
                    XrayModule.refresh-activity();
                }
            }
            if XrayModule.section == 3: XrayDns {}
            if XrayModule.section == 4: XrayFallbacks {}
        }
    }
    if XrayModule.section == 5: XrayConnections { notice-clearance: root.notice-clearance; }
    if XrayModule.section == 6: LogStreamView {
        title: "Xray log stream";
        backend-label: "Core";
        latest-text: XrayModule.log-text;
        total: XrayModule.log-total;
        visible-count: XrayModule.log-visible-count;
        recording: XrayModule.log-recording;
        verbosity <=> XrayModule.log-verbosity;
        errors-only <=> XrayModule.log-errors-only;
        source <=> XrayModule.log-source;
        follow <=> XrayModule.log-follow;
        notice-clearance: root.notice-clearance;
        filter => { XrayModule.filter-logs(); }
        set-recording(record) => { XrayModule.set-log-recording(record); }
        clear => { XrayModule.clear-logs(); }
    }
}

export component XrayNotices inherits NoticeShelf {
    in property <bool> current-page;
    in property <string> toast;
    in property <bool> toast-error;
    out property <[NoticeEntry]> hidden-entries: XrayModule.installed
        ? [restart-notice.entry, settings-notice.entry, status-notice.entry] : [];
    out property <bool> has-hidden: XrayModule.installed && (restart-notice.entry.hidden
        || settings-notice.entry.hidden || status-notice.entry.hidden);
    out property <bool> restart-pulse: restart-notice.pulsing;
    out property <color> indicator-ink: restart-notice.entry.hidden ? XrayModule.restart-ink : Theme.accent;
    callback hidden;
    callback open-section(int);

    public function entry-action(index: int, secondary: bool) {
        if index == 0 {
            if secondary { restart-notice.secondary-action(); }
            else { restart-notice.action(); }
        }
    }

    private property <bool> in-scope: root.current-page && XrayModule.installed;
    private property <bool> failed: XrayModule.restart-phase == XrayRestartPhase.failed;
    private property <bool> restarting: XrayModule.restart-phase == XrayRestartPhase.restarting;
    private property <bool> restarted: XrayModule.restart-phase == XrayRestartPhase.restarted;

    FloatingNotice {
        in-scope: root.in-scope;
        active: root.toast != "";
        message: root.toast;
        icon: root.toast-error ? "info" : "check";
        ink: root.toast-error ? Theme.danger : Theme.accent;
        can-hide: false;
    }
    status-notice := FloatingNotice {
        in-scope: root.in-scope;
        active: XrayModule.error != "" || (XrayModule.status != "" && XrayModule.restart-phase == XrayRestartPhase.idle);
        title: XrayModule.error != "" ? "Xray error" : "";
        list-title: XrayModule.error != "" ? "Xray error" : "Xray status";
        message: XrayModule.error != "" ? XrayModule.error : XrayModule.status;
        icon: "info";
        ink: XrayModule.error != "" ? Theme.danger : Theme.accent;
        hidden => { root.hidden(); }
    }
    settings-notice := FloatingNotice {
        in-scope: root.in-scope;
        active: XrayModule.settings-error != "";
        title: "Review Xray settings";
        message: XrayModule.settings-error;
        icon: "info";
        ink: Theme.danger;
        hidden => { root.hidden(); }
    }
    restart-notice := FloatingNotice {
        in-scope: root.in-scope;
        active: XrayModule.restart-notice-active;
        collapsed <=> XrayModule.restart-collapsed;
        change-revision: XrayModule.pending-revision;
        title: root.restarting ? "Restarting Xray…" : root.restarted ? "Restarted" : root.failed ? "Xray restart failed" : "Restart Xray to apply changes";
        message: root.failed ? XrayModule.restart-error
            : root.restarted || root.restarting ? "" : "Xray pauses briefly and its proxy connections close.";
        icon: root.restarted ? "check" : "refresh";
        ink: XrayModule.restart-ink;
        working: root.restarting;
        can-hide: !root.restarting && !root.restarted;
        action-label: root.restarted ? "" : root.failed ? "Retry" : "Restart";
        action-enabled: (XrayModule.running || root.failed) && !XrayModule.busy && !XrayModule.port-save-pending && !XrayModule.settings-saving && XrayModule.settings-error == "";
        secondary-label: root.failed ? "View logs" : "";
        action => { XrayModule.restart(); }
        secondary-action => { root.open-section(6); }
        hidden => { root.hidden(); }
    }
}
